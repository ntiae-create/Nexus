diff --git a/packages/database/scripts/test-postgres-integration.sh b/packages/database/scripts/test-postgres-integration.sh
index b521133..bc75937 100644
--- a/packages/database/scripts/test-postgres-integration.sh
+++ b/packages/database/scripts/test-postgres-integration.sh
@@ -9,8 +9,8 @@ fi
 database_package_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
