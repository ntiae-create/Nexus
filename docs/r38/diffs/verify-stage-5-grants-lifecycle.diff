   END IF;
-  RAISE NOTICE 'C2.4c) LIMITE DOCUMENTADO: SUPERUSER ignora RLS e pode forjar a trilha (delete o registro do ambiente se isso ocorrer)';
+  RAISE NOTICE 'C2.4c) LIMITE DOCUMENTADO: SUPERUSER ignora RLS e pode forjar a trilha';
 END
 $$;
 
