++  END;
++END
++$$;
++COMMIT;
++
++-- =============================================================================================
++-- H. Preferencias: chave composta, padrao unico, limites de dominio
++-- =============================================================================================
++BEGIN;
++SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
++SELECT set_config('nexus.actor_type', 'owner', true);
++DO $$
++DECLARE
