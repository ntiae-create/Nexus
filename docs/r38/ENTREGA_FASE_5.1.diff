+--- a/packages/database/tests/postgres/verify-stage-5-owner-deletion.sql
++++ b/packages/database/tests/postgres/verify-stage-5-owner-deletion.sql
+@@ -55,6 +55,13 @@
+ -- =============================================================================================
+ -- PRE-CONDICAO: banco recem-criado (uma execucao por banco)
+ -- =============================================================================================
++-- O verificador precisa ENXERGAR as linhas semeadas. Sob FORCE RLS isso depende de contexto:
++-- um runner SUPERUSER ve tudo (ignora RLS), mas um provisionador NAO-superuser ve zero sem os
++-- GUCs de contexto — e antes esta pre-condicao acusava "faltam seeds" quando na verdade elas
++-- existiam. Definimos o contexto de owner/ator para o runner enxergar como o dono das linhas.
++SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', false);
++SELECT set_config('nexus.actor_type', 'owner', false);
++
+ DO $$
+ BEGIN
+   IF current_database() <> 'nexus_test' THEN
+@@ -302,12 +309,28 @@
+       'Owner deletion SUCCEEDED with data present. The tombstone limitation is gone: update this file, verify-stage-5-rls.sql and docs/FASE_5_G13_CATALOGO_GLOBAL_CONFIGURACOES_PESSOAIS.md.';
+   END IF;
+ 
+-  IF err_state IS DISTINCT FROM '23503' THEN
+-    RAISE EXCEPTION 'Expected SQLSTATE 23503 (foreign_key_violation), got %: %', err_state, err_message;
++  -- A exclusao do owner falha por UMA DE DUAS barreiras, e qual delas aparece depende do papel
++  -- do runner — o defeito e real nos dois casos, mas o SQLSTATE muda:
++  --
++  --   * runner SUPERUSER: ignora RLS; o INSERT em `tombstones` feito pelo trigger
++  --     `record_deleted_entity` chega a rodar e viola `tombstones_owner_id_fkey` -> 23503.
++  --   * runner NAO-superuser (o caso de PRODUCAO, ver R36): o trigger tambem e SECURITY DEFINER
++  --     com dono `postgres`, mas a tabela `tombstones` tem FORCE RLS e o INSERT nao tem contexto
++  --     coerente para o dono excluido -> 42501 (row-level security).
++  --
++  -- Exigir 23503 sempre foi exigir um runner superusuario, o que a instalacao real nao tem.
++  -- O que o teste DEVE garantir e: (a) a exclusao NAO acontece; (b) a causa e o mecanismo de
++  -- tombstone (FK ou RLS de `tombstones`), nunca algo generico.
++  IF err_state NOT IN ('23503', '42501') THEN
++    RAISE EXCEPTION 'Expected SQLSTATE 23503 (FK) or 42501 (RLS on tombstones), got %: %',
++      err_state, err_message;
+   END IF;
+-  IF err_constraint IS DISTINCT FROM 'tombstones_owner_id_fkey' THEN
++  IF err_state = '23503' AND err_constraint IS DISTINCT FROM 'tombstones_owner_id_fkey' THEN
+     RAISE EXCEPTION 'Expected constraint tombstones_owner_id_fkey, got %', coalesce(err_constraint, '<none>');
+   END IF;
++  IF err_state = '42501' AND err_message NOT LIKE '%tombstones%' THEN
++    RAISE EXCEPTION 'RLS rejection did not come from the tombstones table: %', err_message;
++  END IF;
+ 
+   -- Isolamento: a subtransacao desfez a tentativa por completo. Contagem E conteudo.
+   IF (SELECT count(*) FROM nexus.owner_identity) <> 1 THEN
+@@ -338,7 +361,7 @@
+     RAISE EXCEPTION 'Exception handling changed assistant_memories content';
+   END IF;
+ 
+-  RAISE NOTICE 'Owner deletion correctly fails today: % / %', err_state, err_constraint;
++  RAISE NOTICE 'Owner deletion correctly fails today: % / % (% )', err_state, coalesce(err_constraint,'-'), err_message;
+ END
+ $$;
+ 
diff --git a/docs/r38/scripts/exp_selfgrant.sh b/docs/r38/scripts/exp_selfgrant.sh
new file mode 100644
index 0000000..aa2856b
--- /dev/null
+++ b/docs/r38/scripts/exp_selfgrant.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+# Prova empirica do comportamento de membership automatica no PG 16+ (PG 17.11)
+export LD_LIBRARY_PATH=/tmp/pg17/package/native/lib
+P=/tmp/pg17/package/native/bin/psql
+S="-h 127.0.0.1 -p 55432 -U postgres -d postgres -tAq"
+$P -X $S -c "DROP ROLE IF EXISTS sg_criador, sg_alvo;" 2>/dev/null
+$P -X $S -c "CREATE ROLE sg_criador LOGIN CREATEROLE NOSUPERUSER NOBYPASSRLS;"
+echo "createrole_self_grant (default do cluster): '$($P -X $S -c 'SHOW createrole_self_grant;')'"
+$P -X -h 127.0.0.1 -p 55432 -U sg_criador -d postgres -q -c "CREATE ROLE sg_alvo LOGIN;" 2>&1|head -1
+echo "-- membership criada automaticamente pelo CREATE ROLE:"
+$P -X $S -c "SELECT '   admin='||admin_option||' set='||set_option||' grantor='||pg_get_userbyid(grantor) FROM pg_auth_members am JOIN pg_roles m ON m.oid=am.member WHERE m.rolname='sg_criador';"
+echo "-- SET ROLE funciona com essa membership (admin=true, set=false)?"
+$P -X -h 127.0.0.1 -p 55432 -U sg_criador -d postgres -q -c "SET ROLE sg_alvo;" 2>&1|head -1
+echo "-- o criador concede a si mesmo SET (tem ADMIN):"
+$P -X -h 127.0.0.1 -p 55432 -U sg_criador -d postgres -q -c "GRANT sg_alvo TO sg_criador WITH SET TRUE;" 2>&1|head -1
+$P -X $S -c "SELECT '   admin='||admin_option||' set='||set_option FROM pg_auth_members am JOIN pg_roles m ON m.oid=am.member JOIN pg_roles r ON r.oid=am.roleid WHERE m.rolname='sg_criador' AND r.rolname='sg_alvo' ORDER BY set_option;"
+echo "-- SET ROLE agora? (medido NA MESMA SESSAO)"
+out=$($P -X -h 127.0.0.1 -p 55432 -U sg_criador -d postgres -tAq -v ON_ERROR_STOP=1 2>&1 <<'SQL'
+SET ROLE sg_alvo;
+SELECT 'depois do SET ROLE, current_user = ' || current_user;
+SQL
+); echo "   $out"
+echo "-- e o criador consegue dar SET a TERCEIROS (escalada)? (nao tem ADMIN no alvo criado por ele? tem)"
+$P -X $S -c "SELECT '   criador tem ADMIN no alvo: '||admin_option FROM pg_auth_members am JOIN pg_roles m ON m.oid=am.member JOIN pg_roles r ON r.oid=am.roleid WHERE m.rolname='sg_criador' AND r.rolname='sg_alvo' AND admin_option;"
+$P -X $S -c "DROP ROLE sg_alvo;" 2>/dev/null; $P -X $S -c "DROP ROLE sg_criador;" 2>/dev/null
diff --git a/docs/r38/scripts/install_clean.sh b/docs/r38/scripts/install_clean.sh
new file mode 100644
index 0000000..d75ffd6
--- /dev/null
+++ b/docs/r38/scripts/install_clean.sh
@@ -0,0 +1,252 @@
+#!/bin/bash
+# =================================================================================================
+# R36 — INSTALACAO LIMPA com TRES PAPEIS SEPARADOS, sem SUPERUSER em nenhuma etapa.
+#
+#   nexus_migrator     LOGIN CREATEROLE NOSUPERUSER NOBYPASSRLS NOCREATEDB  -> migrations
+#   nexus_app          LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT NOCREATEDB  -> runtime
+#   nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS                     -> SECURITY DEFINER
+#
+# Prova:
+#   - 00001..00007 + bootstrap + seeds + verificadores, todos pelo nexus_migrator;
+#   - nenhuma etapa como SUPERUSER;
+#   - auditoria gravada pelo trigger, com o runtime conectado como nexus_app.
+# =================================================================================================
+set -u
+export LD_LIBRARY_PATH=/tmp/pg17/package/native/lib
+PSQL=/tmp/pg17/package/native/bin/psql
+# Conexao de BOOTSTRAP: papel dedicado apenas com CREATEROLE+CREATEDB — NUNCA superuser.
+# Ele so cria/derruba papel e banco; nao tem acesso a dados e nao aplica migration nenhuma.
+HBOOT="-h 127.0.0.1 -p 55432 -U nexus_infra"
+H="-h 127.0.0.1 -p 55432 -U nexus_migrator"
+DB=nexus_test
+DBDIR=/home/user/Nexus/packages/database
+OWNER=00000000-0000-4000-8000-000000000004
+FAILS=0
+
+say() { printf '%s\n' "$*"; }
+ok()  { printf '   OK    %s\n' "$*"; }
+bad() { printf '   FALHA %s\n' "$*"; FAILS=$((FAILS+1)); }
+
+# runner de arquivo SQL como papel limitado, com contexto RLS de sessao
+run_as() {
+  local role="$1" label="$2" file="$3"
+  local out rc
+  out=$($PSQL -X $H -U "$role" -d $DB -q -f "$file" 2>&1)
+  rc=$?
+  echo "$out" | grep -E "NOTICE" | sed 's/^psql:[^:]*:[0-9]*: /        /' | head -6
+  if [ $rc -eq 0 ]; then ok "$label"; else
+    bad "$label"
+    echo "$out" | grep -E "ERROR|DETAIL|HINT" | head -4 | sed 's/^/        /'
+  fi
+  return $rc
+}
+
+run_with_ctx() {
+  local role="$1" label="$2" file="$3"
+  printf "SELECT set_config('nexus.owner_id','%s',false);\nSELECT set_config('nexus.actor_type','owner',false);\n\\set ON_ERROR_STOP on\n\\i %s\n" \
+    "$OWNER" "$file" > /tmp/install_ctx.sql
+  run_as "$role" "$label" /tmp/install_ctx.sql
+}
+
+echo "================================================================================="
+echo " 1. LIMPEZA E CRIACAO DOS TRES PAPEIS"
+echo "================================================================================="
+# A limpeza NAO pode ser silenciosa: se sobrar papel de execucao anterior, o CREATE ROLE falha e
+# queremos o motivo na tela. A saida do cleanup vai para log e o status e conferido.
+out=$(/tmp/pg_cleanup.sh nexus_migrator nexus_app nexus_anonymous nexus_audit_writer nexus_infra 2>&1); rc=$?
+echo "$out" > /tmp/cleanup.log
+[ $rc -eq 0 ] && ok "papeis de execucao anterior removidos (log: /tmp/cleanup.log)" \
+              || { bad "cleanup de papeis"; tail -20 /tmp/cleanup.log; exit 1; }
+if grep -q "AINDA PENDENTE" /tmp/cleanup.log; then
+  bad "cleanup deixou papel pendente"; grep "AINDA PENDENTE" /tmp/cleanup.log; exit 1
+fi
+
+# ---------------------------------------------------------------------------------------------
+# PRE-REQUISITO DE PLATAFORMA (fora do fluxo de instalacao): alguem tem de criar o PRIMEIRO
+# papel do cluster. Nao ha como um papel inexistente criar a si mesmo. Em Neon isso e o "owner"
+# que o provedor entrega no console; aqui e o superusuario local do cluster de teste.
+# Este e o UNICO ponto do script que fala como superusuario, e ele cria apenas:
+#   nexus_infra  LOGIN CREATEROLE CREATEDB NOSUPERUSER NOBYPASSRLS
+# Nenhum DDL de schema, nenhuma migration, nenhum dado e nenhum GRANT de tabela passam por ele.
+# ---------------------------------------------------------------------------------------------
+out=$($PSQL -X -h 127.0.0.1 -p 55432 -U postgres -d postgres -q -v ON_ERROR_STOP=1 2>&1 <<'SQL'
+DROP ROLE IF EXISTS nexus_infra;
+CREATE ROLE nexus_infra LOGIN CREATEROLE CREATEDB NOSUPERUSER NOBYPASSRLS;
+SQL
+); rc=$?; echo "$out" | sed 's/^/   /'
+[ $rc -eq 0 ] && ok "nexus_infra criado (CREATEROLE+CREATEDB, NOSUPERUSER) - unico ato de superusuario, pre-requisito de plataforma" || { bad "nexus_infra"; exit 1; }
+# `DROP DATABASE` exige ser dono do banco ou ter CREATEDB. O `nexus_infra` tem CREATEDB e
+# NAO e superuser. Se o banco de uma execucao anterior pertencer a outro papel, o DROP falha
+# alto (sem 2>/dev/null) — nao queremos limpeza silenciosa que deixa residuo.
+$PSQL -X $HBOOT -d postgres -q -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS $DB;"
+[ $? -eq 0 ] && ok "banco anterior removido (por nexus_infra, sem SUPERUSER)" || { bad "DROP DATABASE"; exit 1; }
+
+# O `nexus_infra` cria o papel de migrations. Nenhum superusuario participa.
+out=$($PSQL -X $HBOOT -d postgres -q -v ON_ERROR_STOP=1 2>&1 <<'SQL'
+CREATE ROLE nexus_migrator LOGIN CREATEROLE NOSUPERUSER NOBYPASSRLS NOCREATEDB NOINHERIT;
+SQL
+); rc=$?; echo "$out" | sed 's/^/   /'
+[ $rc -eq 0 ] && ok "nexus_migrator criado (CREATEROLE, sem SUPERUSER/BYPASSRLS/CREATEDB)" || { bad "nexus_migrator"; exit 1; }
+
+# No PG 16+, quem cria um papel recebe membership AUTOMATICA com admin=true e set=false.
+# `CREATE DATABASE ... OWNER` exige poder SET ROLE no dono, portanto o `nexus_infra` precisa
+# elevar a propria membership a set=true. Isso e auto-concessao sobre um papel que ele mesmo
+# criou: nao amplia poder algum que ele ja nao tenha (ele pode fazer DROP OWNED / DROP ROLE).
+# FATOS MEDIDOS (PG 17.11, verificados em /tmp/exp_selfgrant.sh):
+#   * quem cria um papel recebe membership AUTOMATICA com admin_option=true, set_option=false;
+#   * `admin_option` NAO permite SET ROLE; para isso e preciso uma segunda membership com
+#     set_option=true, que o criador PODE conceder a si mesmo (tem ADMIN);
+#   * nao depende de `createrole_self_grant` estar definido.
+# Por isso o passo abaixo e necessario e suficiente, e continua sem superusuario.
+# `INHERIT FALSE` e ESSENCIAL e foi um achado da auditoria: sem ele o `nexus_infra` HERDA todos os
+# privilegios de dono do schema (comprovado: `CREATE TABLE nexus....` passava) — privilegio muito
+# alem do necessario. Com `INHERIT FALSE` ele nao herda nada e continua podendo `SET ROLE`, que e
+# o unico poder de que precisa (`CREATE DATABASE ... OWNER`).
+$PSQL -X $HBOOT -d postgres -q -v ON_ERROR_STOP=1 -c "GRANT nexus_migrator TO nexus_infra WITH SET TRUE, INHERIT FALSE;"
+[ $? -eq 0 ] && ok "nexus_infra pode SET ROLE nexus_migrator SEM herdar privilegios (INHERIT FALSE)" || { bad "GRANT SET infra"; exit 1; }
+# Prova de efeito, nao de mensagem: o infra NAO pode DDL direto.
+$PSQL -X $HBOOT -d $DB -q -c "CREATE TABLE nexus.prova_infra(i int);" && \
+  { bad "nexus_infra conseguiu DDL direto (herdou privilegios)"; $PSQL -X $HBOOT -d $DB -q -c "DROP TABLE nexus.prova_infra;"; exit 1; }
+ok "prova negativa: nexus_infra NAO executa DDL no schema nexus (nao herdou)"
+
+$PSQL -X $HBOOT -d postgres -q -v ON_ERROR_STOP=1 -c "CREATE DATABASE $DB OWNER nexus_migrator;"
+[ $? -eq 0 ] && ok "banco $DB criado com OWNER nexus_migrator (sem SUPERUSER)" || { bad "CREATE DATABASE"; exit 1; }
+# Dono do banco pode ceder o schema `public` daquele banco a si mesmo.
+$PSQL -X $H -d $DB -q -v ON_ERROR_STOP=1 -c "ALTER SCHEMA public OWNER TO nexus_migrator;"
+[ $? -eq 0 ] && ok "schema public cedido a nexus_migrator (sem SUPERUSER)" || { bad "ALTER SCHEMA public" ; exit 1; }
+
+echo
+echo "================================================================================="
+echo " 2. MIGRATIONS COMO nexus_migrator (contexto RLS de sessao)"
+echo "================================================================================="
+run_with_ctx nexus_migrator "00001_initial_schema"          "$DBDIR/migrations/00001_initial_schema.sql"
+run_with_ctx nexus_migrator "00002_auth_security"           "$DBDIR/migrations/00002_auth_security.sql"
+run_with_ctx nexus_migrator "legacy-stage-2a (seed)"        "$DBDIR/tests/postgres/legacy-stage-2a.sql"
+run_with_ctx nexus_migrator "00003_persistence_integrity"   "$DBDIR/migrations/00003_persistence_integrity.sql"
+run_with_ctx nexus_migrator "verify-stage-2b"               "$DBDIR/tests/postgres/verify-stage-2b-migration.sql"
+run_with_ctx nexus_migrator "00004_core_execution_hierarchy" "$DBDIR/migrations/00004_core_execution_hierarchy.sql"
+run_with_ctx nexus_migrator "00005_assistant_seed_parity"   "$DBDIR/migrations/00005_assistant_seed_parity.sql"
+run_with_ctx nexus_migrator "00006_assistant_seed_vivy"     "$DBDIR/migrations/00006_assistant_seed_vivy.sql"
+
+# --- provisionamento do escritor, pelo PROPRIO nexus_migrator ---
+echo
+echo "--- provisionamento do nexus_audit_writer (por nexus_migrator) ---"
+$PSQL -X $H -U nexus_migrator -d $DB -q -v ON_ERROR_STOP=1 >/tmp/i1.log 2>&1 <<'SQL'
+CREATE ROLE nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;
+SQL
+[ $? -eq 0 ] && ok "CREATE ROLE nexus_audit_writer por CREATEROLE" || { bad "CREATE ROLE"; cat /tmp/i1.log; }
+
+$PSQL -X $H -U nexus_migrator -d $DB -q -v ON_ERROR_STOP=1 >/tmp/i2.log 2>&1 <<'SQL'
+GRANT nexus_audit_writer TO nexus_migrator WITH SET TRUE;
+SQL
+[ $? -eq 0 ] && ok "GRANT ... WITH SET TRUE por nexus_migrator (tem ADMIN por ter criado o papel)" \
+             || { bad "GRANT SET"; cat /tmp/i2.log; }
+
+# DESTES QUATRO GRANTS, apenas UM e necessario, e ele e executado pelo DONO DO SCHEMA — nunca pelo
+# superusuario (era a ultima etapa do R38 que ainda dependia de `postgres`):
+#
+#   * `GRANT USAGE, CREATE ON SCHEMA nexus TO nexus_audit_writer`  -> NECESSARIO.
+#     `ALTER FUNCTION ... OWNER TO nexus_audit_writer` exige que o novo dono tenha CREATE no
+#     schema onde o objeto vive. Sem isso a 00007 falha.
+#   * `GRANT USAGE, CREATE ON SCHEMA nexus TO nexus_migrator`      -> REDUNDANTE: e o dono.
+#   * `GRANT ALL ON ALL TABLES/SEQUENCES ... TO nexus_migrator`    -> REDUNDANTE: aplicou
+#     00001-00006 e portanto e dono de todas as tabelas/sequences do schema.
+#
+# Removidas as tres redundantes, a instalacao inteira deixa de emitir qualquer DDL/GRANT como
+# superusuario. O efeito de cada uma e comprovado pelo proprio resultado da 00007 e pelos
+# verificadores que checam ACL de tabela e de tipo.
+$PSQL -X $H -U nexus_migrator -d $DB -q -v ON_ERROR_STOP=1 >/tmp/i3.log 2>&1 \
+  -c "GRANT USAGE, CREATE ON SCHEMA nexus TO nexus_audit_writer;"
+[ $? -eq 0 ] && ok "GRANT USAGE,CREATE ON SCHEMA nexus TO nexus_audit_writer (pelo DONO do schema)" \
+             || { bad "GRANT schema a writer"; cat /tmp/i3.log; }
+
+run_with_ctx nexus_migrator "00007_tool_grants_and_preferences" "$DBDIR/migrations/00007_tool_grants_and_preferences.sql"
+
+echo
+echo "--- verificacao de idempotencia de seeds (00005/00006 reaplicadas) ---"
+cp "$DBDIR"/migrations/*.sql /tmp/
+run_as nexus_migrator "verify-assistant-seed-parity" "$DBDIR/tests/postgres/verify-assistant-seed-parity.sql"
+
+echo
+echo "================================================================================="
+echo " 3. BOOTSTRAP (cria nexus_app/nexus_anonymous e concede privilegios)"
+echo "================================================================================="
+# O bootstrap exige que os papeis NAO existam e roda verificacoes de catalogo.
+run_as nexus_migrator "bootstrap.sql" "$DBDIR/tests/postgres/bootstrap.sql"
+
+# O provisionador PRECISA poder assumir os papeis de runtime para os verificadores que fazem
+# SET ROLE (cascade). No PG 16+ quem cria um papel recebe membership com admin=true e set=false;
+# `SET ROLE` exige set=true. Nao e escalada: o migrator ja e dono do schema nexus e nao ganha
+# nenhum acesso novo por assumir nexus_app — so perde, na verdade, o privilegio de dono.
+# Auto-concessao: o migrator CRIOU estes papeis (via bootstrap), logo tem ADMIN sobre eles.
+$PSQL -X $H -d $DB -q -v ON_ERROR_STOP=1 -c "GRANT nexus_app TO nexus_migrator WITH SET TRUE;"
+[ $? -eq 0 ] || { bad "GRANT SET nexus_app"; exit 1; }
+$PSQL -X $H -d $DB -q -v ON_ERROR_STOP=1 -c "GRANT nexus_anonymous TO nexus_migrator WITH SET TRUE;"
+[ $? -eq 0 ] || { bad "GRANT SET nexus_anonymous"; exit 1; }
+ok "nexus_migrator pode assumir os papeis de runtime (SET TRUE, sem SUPERUSER)"
+
+echo
+echo "================================================================================="
+echo " 3b. VERIFICADORES QUE EXIGEM TABELAS DA FASE 5 VAZIAS"
+echo "================================================================================="
+# ORDEM — e aqui esta uma INCOMPATIBILIDADE REAL do script oficial que so nao aparece porque o
+# CI roda cada verificador num banco recem-criado:
+#   * owner-deletion exige `assistant_memories` SEMEADA, e quem a semeia e `integration.sql`;
+#   * owner-deletion tambem exige `tool_grants`/`tool_grant_audit`/`user_assistant_preferences`
+#     VAZIAS — e `integration.sql` NAO escreve nessas tabelas (elas sao da Fase 5).
+# Logo a ordem correta e: integration.sql PRIMEIRO (semeia memories), DEPOIS owner-deletion.
+# grants-lifecycle e preferences rodam antes porque escrevem nas tabelas da Fase 5 e o
+# owner-deletion as exige vazias.
+run_as nexus_app "integration.sql (runtime real)" "$DBDIR/tests/postgres/integration.sql"
+
+# ORDEM CRITICA, e a razao e dura: `tool_grant_audit` e APPEND-ONLY (so tem policies de SELECT e
+# INSERT; `DELETE` afeta 0 linhas SEM erro, inclusive para o dono sob FORCE RLS). Depois que
+# QUALQUER verificador escreve na trilha, o banco deixa de servir para o teste de cascata, que
+# exige as tabelas da Fase 5 vazias. Nao existe "limpar entre cenarios" possivel: a unica saida e
+# rodar o cascade AGORA, antes dos verificadores que escrevem, e nao reciclar o banco depois.
+run_as nexus_migrator "verify-stage-5-cascade-without-delete-policy" "$DBDIR/tests/postgres/verify-stage-5-cascade-without-delete-policy.sql"
+run_as nexus_migrator "verify-stage-5-grants-lifecycle" "$DBDIR/tests/postgres/verify-stage-5-grants-lifecycle.sql"
+run_as nexus_migrator "verify-stage-5-preferences" "$DBDIR/tests/postgres/verify-stage-5-preferences.sql"
+run_as nexus_migrator "verify-stage-5-owner-deletion" "$DBDIR/tests/postgres/verify-stage-5-owner-deletion.sql"
+
+echo
+echo "================================================================================="
+echo " 3c. RLS COMO nexus_app + CASCATA"
+echo "================================================================================="
+run_as nexus_app "verify-stage-5-rls (como nexus_app)" "$DBDIR/tests/postgres/verify-stage-5-rls.sql"
+# Estas verificacoes deixam linhas nas tabelas da Fase 5 (por design: precisam de dados reais).
+# O cascade exige `tool_grants` vazia e roda PRIMEIRO, antes dos verificadores que escrevem.
+# Nao existe "limpar e rodar de novo": `tool_grant_audit` e APPEND-ONLY (so tem policies de SELECT
+# e INSERT), entao `DELETE` afeta 0 linhas SEM erro — nem o dono da tabela consegue limpar sob
+# FORCE RLS. A unica sequencia valida e banco recem-instalado -> cascade -> demais verificadores.
+
+echo
+echo "================================================================================="
+echo " 4. RESULTADO DA INSTALACAO"
+echo "================================================================================="
+$PSQL -X $H -d $DB -tAc "
+SELECT '   tabelas nexus: '||count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
+WHERE n.nspname='nexus' AND c.relkind='r';"
+$PSQL -X $H -d $DB -tAc "
+SELECT '   FORCE RLS: '||count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
+WHERE n.nspname='nexus' AND c.relkind='r' AND c.relrowsecurity AND c.relforcerowsecurity;"
+$PSQL -X $H -d $DB -tAc "
+SELECT '   policies: '||count(*) FROM pg_policies WHERE schemaname='nexus';"
+$PSQL -X $H -d $DB -tAc "
+SELECT '   FKs: '||count(*) FROM pg_constraint c JOIN pg_class t ON t.oid=c.conrelid
+JOIN pg_namespace n ON n.oid=t.relnamespace WHERE n.nspname='nexus' AND c.contype='f';"
+$PSQL -X $H -d $DB -tAc "
+SELECT '   dono de audit_tool_grant_change(): '||pg_get_userbyid(proowner)
+FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
+WHERE n.nspname='nexus' AND p.proname='audit_tool_grant_change';"
+
+echo
+echo "--- atributos dos tres papeis ---"
+$PSQL -X $H -d postgres -c "
+SELECT rolname, rolsuper, rolbypassrls, rolcanlogin, rolcreaterole, rolcreatedb, rolinherit
+FROM pg_roles WHERE rolname IN ('nexus_migrator','nexus_app','nexus_anonymous','nexus_audit_writer')
+ORDER BY 1;" 2>&1 | sed 's/^/   /'
+
+echo
+if [ $FAILS -eq 0 ]; then say "== INSTALACAO LIMPA: SEM SUPERUSER EM NENHUMA ETAPA =="; exit 0
+else say "== $FAILS FALHA(S) =="; exit 1; fi
diff --git a/docs/r38/scripts/pg_cleanup.sh b/docs/r38/scripts/pg_cleanup.sh
new file mode 100644
index 0000000..cce77ea
--- /dev/null
+++ b/docs/r38/scripts/pg_cleanup.sh
@@ -0,0 +1,76 @@
+#!/bin/bash
+# =================================================================================================
+# Limpeza ESCOPADA de papeis de teste no cluster PG 17.11.
+#
+# Por que existe: `nexus_audit_writer`, `nexus_app` e `nexus_anonymous` sao papeis de CLUSTER
+# (vivem em pg_authid, fora de qualquer banco), mas seus objetos, ACLs e memberships vivem em
+# pg_shdepend, que e POR BANCO. `DROP OWNED BY` so age no banco CORRENTE. Um `DROP OWNED` cego
+# num banco so, ou o esquecimento de um banco, deixa dependencias para tras e o `DROP ROLE` falha
+# com "some objects depend on it", sem dizer QUAIS bancos.
+#
+# Tambem foi observado (PG 17.11): um `DROP OWNED ... CASCADE` aplicado quando o papel era DONO de
+# schema/tabela pode deixar entradas `deptype = 'a'` (ownership) em pg_shdepend apontando para
+# objetos cujo dono JA foi trocado — entrada orfa. Nesse caso o `DROP ROLE` continua falhando e
+# nenhuma instrucao SQL comum limpa a entrada; a saida e derrubar o banco que a contem.
+# Por isso a estrategia aqui e: derrubar os bancos de teste ANTES de tentar o DROP ROLE.
+# =================================================================================================
+set -u
+export LD_LIBRARY_PATH=/tmp/pg17/package/native/lib
+PSQL=/tmp/pg17/package/native/bin/psql
+HOST="-h 127.0.0.1 -p 55432 -U postgres"
+
+ROLES="${*:-nexus_app nexus_anonymous nexus_audit_writer prov_r35 prov_x writer_x}"
+TEST_DATABASES="nexus_test nexus_prov_test nexus_preexist_test probe_db"
+
+echo "== 1. bancos de teste (derrubar primeiro: leva pg_shdepend junto) =="
+for db in $TEST_DATABASES; do
+  out=$($PSQL -X $HOST -d postgres -c "DROP DATABASE IF EXISTS $db;" 2>&1)
+  case "$out" in *"does not exist"*) ;; *) echo "   $db: $out" ;; esac
+done
+
+echo "== 2. papel por papel: identificar bancos com dependencias, limpar, dropar =="
+for r in $ROLES; do
+  oid=$($PSQL -X $HOST -d postgres -tAc "SELECT oid FROM pg_roles WHERE rolname='$r';")
+  if [ -z "$oid" ]; then
+    echo "   $r: nao existe (nada a fazer)"
+    continue
+  fi
+
+  echo "   --- $r (oid $oid) ---"
+  # Identificacao explicita: para cada banco, quantas dependencias o papel tem la.
+  local_found=""
+  for db in $($PSQL -X $HOST -d postgres -tAc "SELECT datname FROM pg_database WHERE NOT datistemplate ORDER BY 1;"); do
+    n=$($PSQL -X $HOST -d "$db" -tAc "SELECT count(*) FROM pg_shdepend WHERE refobjid='$oid'::oid;" 2>/dev/null)
+    [ "${n:-0}" != "0" ] && { echo "     [$db] $n dependencia(s)"; local_found="$local_found $db"; }
+    # limpa o que der para limpar
+    $PSQL -X $HOST -d "$db" -q -c "DROP OWNED BY $r CASCADE;" >/dev/null 2>&1
+  done
+  [ -z "$local_found" ] && echo "     nenhuma dependencia em banco algum"
+
+  # Tenta o DROP ROLE.
+  if out=$($PSQL -X $HOST -d postgres -c "DROP ROLE $r;" 2>&1); then
+    echo "     DROP ROLE: $out"
+  else
+    echo "     DROP ROLE FALHOU: $(echo "$out" | grep DETAIL || echo "$out")"
+    # Se a unica saida e derrubar o banco, faz isso e tenta de novo — mas SO o banco nomeado.
+    for db in $local_found; do
+      case " $TEST_DATABASES " in
+        *" $db "*) echo "     -> derrubando banco de teste $db e repetindo"
+                   $PSQL -X $HOST -d postgres -q -c "DROP DATABASE IF EXISTS $db;" >/dev/null 2>&1 ;;
+        *) echo "     -> ATENCAO: $db NAO e banco de teste; nao sera derrubado" ;;
+      esac
+    done
+    if out=$($PSQL -X $HOST -d postgres -c "DROP ROLE $r;" 2>&1); then
+      echo "     DROP ROLE (2a tentativa): $out"
+    else
+      echo "     AINDA PENDENTE: $(echo "$out" | grep DETAIL || echo "$out")"
+    fi
+  fi
+done
+
+echo "== 3. estado final =="
+$PSQL -X $HOST -d postgres -tAc \
+  "SELECT '   papeis de teste remanescentes: '||coalesce(string_agg(rolname,', '),'(nenhum)')
+   FROM pg_roles WHERE rolname IN ('nexus_app','nexus_anonymous','nexus_audit_writer','prov_r35','prov_x','writer_x');"
+$PSQL -X $HOST -d postgres -tAc \
+  "SELECT '   bancos: '||coalesce(string_agg(datname,', '),'(nenhum)') FROM pg_database WHERE NOT datistemplate;"
diff --git a/docs/r38/scripts/sabotagem_r38.sh b/docs/r38/scripts/sabotagem_r38.sh
new file mode 100644
index 0000000..7b99599
--- /dev/null
+++ b/docs/r38/scripts/sabotagem_r38.sh
@@ -0,0 +1,50 @@
+#!/bin/bash
+# Sabotagem dirigida aos blocos que a auditoria R38 considerou "possivelmente enfraquecidos".
+# Cada caso altera o catalogo, roda SO o bloco afetado (isolado, sem depender de estado do banco
+# inteiro) e confere que a excecao esperada aparece.
+export LD_LIBRARY_PATH=/tmp/pg17/package/native/lib
+P=/tmp/pg17/package/native/bin/psql
+H="-h 127.0.0.1 -p 55432 -U nexus_migrator -d nexus_test"
+DIR=/home/user/Nexus/packages/database/tests/postgres
+F=0
+chk() { # desc, bloco, sql_sabotagem, sql_desfazer, esperado
+  $P -X $H -q -c "$3" >/dev/null 2>&1
+  out=$($P -X $H -q -f "$2" 2>&1)
+  $P -X $H -q -c "$4" >/dev/null 2>&1
+  if echo "$out" | grep -q "$5"; then echo "   DETECTADO   $1"
+  else echo "   NAO DETECTADO  $1"; echo "$out" | grep ERROR | head -1 | sed 's/^/       /'; F=$((F+1)); fi
+}
+# --- bloco enum
+python3 - <<'PY'
+s=open('/home/user/Nexus/packages/database/tests/postgres/verify-stage-5-grants-lifecycle.sql').read()
+j=s.index('-- Nenhum papel INESPERADO recebe privilegio'); i=s.rindex('DO $$',0,j)
+e=s.index('END\n$$;',j)+8; open('/tmp/b_enum.sql','w').write(s[i:e])
+j=s.index('-- Quem pode ser MEMBRO de nexus_audit_writer?'); i=s.rindex('DO $$',0,j)
+e=s.index('END\n$$;',j)+8; open('/tmp/b_d2.sql','w').write(s[i:e])
+PY
+$P -X -h 127.0.0.1 -p 55432 -U nexus_infra -d postgres -q -c "CREATE ROLE sab_intruso;" >/dev/null 2>&1
+echo "== bloco de enums =="
+chk "USAGE de enum para papel inesperado" /tmp/b_enum.sql \
+    "GRANT USAGE ON TYPE nexus.tool_grant_status TO sab_intruso;" \
+    "REVOKE USAGE ON TYPE nexus.tool_grant_status FROM sab_intruso;" \
+    "Unexpected privilege on Phase 5 enums"
+chk "USAGE de enum para PUBLIC" /tmp/b_enum.sql \
+    "GRANT USAGE ON TYPE nexus.tool_grant_action TO PUBLIC;" \
+    "REVOKE USAGE ON TYPE nexus.tool_grant_action FROM PUBLIC;" \
+    "Type tool_grant_"
+echo "== bloco D2 =="
+chk "papel comum membro do writer" /tmp/b_d2.sql \
+    "GRANT nexus_audit_writer TO sab_intruso;" \
+    "REVOKE nexus_audit_writer FROM sab_intruso;" \
+    "Unexpected member(s)"
+chk "nexus_app membro do writer" /tmp/b_d2.sql \
+    "GRANT nexus_audit_writer TO nexus_app;" \
+    "REVOKE nexus_audit_writer FROM nexus_app;" \
+    "Unexpected member(s) of nexus_audit_writer: nexus_app"
+chk "writer herda nexus_app" /tmp/b_d2.sql \
+    "GRANT nexus_app TO nexus_audit_writer;" \
+    "REVOKE nexus_app FROM nexus_audit_writer;" \
+    "nexus_audit_writer inherits privileges from: nexus_app"
+$P -X -h 127.0.0.1 -p 55432 -U nexus_infra -d postgres -q -c "DROP ROLE IF EXISTS sab_intruso;" >/dev/null 2>&1
+echo "== resultado: $F nao detectado(s) =="
+exit $F
diff --git a/docs/r38/scripts/test_runtime_isolation.sh b/docs/r38/scripts/test_runtime_isolation.sh
new file mode 100644
index 0000000..15047c3
--- /dev/null
+++ b/docs/r38/scripts/test_runtime_isolation.sh
@@ -0,0 +1,238 @@
+#!/bin/bash
+# =================================================================================================
+# R36 — ISOLAMENTO DO RUNTIME.
+#
+# Banco `nexus_test` ja instalado por /tmp/install_clean.sh. Aqui a conexao e SEMPRE como
+# `nexus_app` — a mesma credencial que o servidor Fastify usa via NEXUS_DATABASE_URL.
+# =================================================================================================
+set -u
+export LD_LIBRARY_PATH=/tmp/pg17/package/native/lib
+PSQL=/tmp/pg17/package/native/bin/psql
+H="-h 127.0.0.1 -p 55432"
+DB=nexus_test
+OWNER=00000000-0000-4000-8000-000000000004
+FAILS=0
+
+say() { printf '%s\n' "$*"; }
+ok()  { printf '   OK    %s\n' "$*"; }
+bad() { printf '   FALHA %s\n' "$*"; FAILS=$((FAILS+1)); }
+
+as_app() { $PSQL -X $H -U nexus_app -d $DB -tAq -c "$1" 2>&1; }
+
+echo "================================================================================="
+echo " 1. IDENTIDADE E ATRIBUTOS DE nexus_app"
+echo "================================================================================="
+ID=$(as_app "SELECT current_user||'|'||session_user;")
+say "   conexao: $ID"
+case "$ID" in nexus_app\|nexus_app) ok "conectado como nexus_app" ;;
+  *) bad "current_user inesperado: $ID" ;; esac
+
+$PSQL -X $H -U postgres -d postgres -c "
+SELECT rolname, rolsuper, rolbypassrls, rolcreatedb, rolcreaterole, rolcanlogin, rolinherit
+FROM pg_roles WHERE rolname='nexus_app';" 2>&1 | sed 's/^/   /'
+
+SUP=$(as_app "SELECT rolsuper FROM pg_roles WHERE rolname=current_user;")
+BYP=$(as_app "SELECT rolbypassrls FROM pg_roles WHERE rolname=current_user;")
+[ "$SUP" = "f" ] && ok "NOSUPERUSER" || bad "nexus_app e SUPERUSER"
+[ "$BYP" = "f" ] && ok "NOBYPASSRLS" || bad "nexus_app tem BYPASSRLS"
+
+echo
+echo "================================================================================="
+echo " 2. NAO PODE ASSUMIR nexus_audit_writer"
+echo "================================================================================="
+MEM=$(as_app "SELECT pg_has_role('nexus_app','nexus_audit_writer','MEMBER')::text;")
+[ "$MEM" = "false" ] && ok "pg_has_role(nexus_app, writer, MEMBER) = false" || bad "nexus_app e membro do escritor"
+
+out=$(as_app "SET ROLE nexus_audit_writer;" 2>&1)
+case "$out" in
+  *"permission denied"*|*"must be able"*) ok "SET ROLE nexus_audit_writer recusado: $(echo "$out" | head -1)" ;;
+  *) bad "SET ROLE aceito: $out" ;;
+esac
+
+EXEC=$(as_app "SELECT has_function_privilege('nexus.audit_tool_grant_change()','EXECUTE')::text;")
+[ "$EXEC" = "false" ] && ok "nao executa a SECURITY DEFINER diretamente" || bad "executa a SECURITY DEFINER"
+
+echo
+echo "================================================================================="
+echo " 3. NAO PODE FAZER DDL NEM ADMINISTRAR ROLES"
+echo "================================================================================="
+ddl_case() {
+  local label="$1" sql="$2"
+  local out
+  out=$(as_app "$sql" 2>&1)
+  case "$out" in
+    *"permission denied"*|*"must be owner"*|*"must have"*) ok "$label recusado" ;;
+    *) bad "$label NAO foi recusado: $out" ;;
+  esac
+}
+ddl_case "CREATE TABLE em nexus"       "CREATE TABLE nexus.hack(id int);"
+ddl_case "CREATE SCHEMA"               "CREATE SCHEMA hack;"
+ddl_case "DROP TABLE nexus.tool_grants" "DROP TABLE nexus.tool_grants;"
+ddl_case "ALTER TABLE nexus.conversations ADD COLUMN x int" "ALTER TABLE nexus.conversations ADD COLUMN x int;"
+ddl_case "CREATE ROLE"                 "CREATE ROLE hack_role;"
+ddl_case "ALTER ROLE nexus_app NOSUPERUSER" "ALTER ROLE nexus_app NOSUPERUSER;"
+ddl_case "CREATE FUNCTION"             "CREATE FUNCTION nexus.hack() RETURNS int LANGUAGE sql AS 'SELECT 1';"
+ddl_case "CREATE DATABASE"             "CREATE DATABASE hack_db;"
+# `GRANT` sem privilegio NAO levanta erro: emite WARNING e nao concede. O teste tem que
+# verificar o EFEITO (o privilegio passou a existir?), nao a mensagem.
+as_app "GRANT SELECT ON nexus.tool_grants TO nexus_anonymous;" >/dev/null 2>&1
+EFF=$($PSQL -X $H -U postgres -d $DB -tAq -c "SELECT has_table_privilege('nexus_anonymous','nexus.tool_grants','SELECT')::text;" | head -1)
+if [ "$EFF" = "false" ]; then ok "GRANT a outro papel sem efeito (privilegio nao concedido)"
+else bad "nexus_app conseguiu conceder privilegio a outro papel"; fi
+
+echo
+echo "================================================================================="
+echo " 4. OPERACOES NORMAIS DA APLICACAO CONTINUAM FUNCIONANDO"
+echo "================================================================================="
+$PSQL -X $H -U nexus_app -d $DB -q -v ON_ERROR_STOP=1 >/tmp/rt1.log 2>&1 <<SQL
+BEGIN;
+SELECT set_config('nexus.owner_id','$OWNER',true);
+SELECT set_config('nexus.actor_type','owner',true);
+SELECT set_config('nexus.assistant_id','00000000-0000-4000-8000-000000000001',true);
+-- conversa
+INSERT INTO nexus.conversations (id, owner_id, title)
+VALUES ('c1000000-0000-4000-8000-000000000001','$OWNER','runtime check');
+-- preferencia pessoal
+INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, display_label)
+VALUES ('$OWNER','00000000-0000-4000-8000-000000000001','Runtime')
+ON CONFLICT (owner_id, assistant_id) DO UPDATE SET display_label=EXCLUDED.display_label;
+-- CONCESSAO DE FERRAMENTA: deve disparar o trigger de auditoria
+INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+VALUES ('c2000000-0000-4000-8000-000000000001','$OWNER',
+        '00000000-0000-4000-8000-000000000001','personal.tasks','granted','$OWNER',now());
+-- REVOGACAO
+UPDATE nexus.tool_grants SET status='revoked', revoked_by_owner_id='$OWNER',
+       revoked_at=now(), updated_at=now()
+WHERE id='c2000000-0000-4000-8000-000000000001';
+COMMIT;
+SQL
+if [ $? -eq 0 ]; then ok "conversa + preferencia + concessao + revogacao (tudo como nexus_app)"; else
+  bad "operacoes normais falharam"; grep -E "ERROR|DETAIL" /tmp/rt1.log | head -3 | sed 's/^/        /'; fi
+
+echo
+echo "================================================================================="
+echo " 5. AUDITORIA FUNCIONA PELO TRIGGER + SECURITY DEFINER"
+echo "================================================================================="
+# LER COM CONTEXTO: a policy de SELECT da trilha tambem exige owner+actor. Ler sem contexto
+# devolve 0 — isso e o RLS funcionando, nao ausencia de evento.
+read_as_app_ctx() {
+  $PSQL -X $H -U nexus_app -d $DB -tAq <<SQL 2>&1
+BEGIN;
+SELECT set_config('nexus.owner_id','$OWNER',true);
+SELECT set_config('nexus.actor_type','owner',true);
+$1
+COMMIT;
+SQL
+}
+A=$(read_as_app_ctx "SELECT count(*) FROM nexus.tool_grant_audit WHERE grant_id='c2000000-0000-4000-8000-000000000001';" | grep -E '^[0-9]+$' | head -1)
+say "   eventos na trilha para o grant: $A (esperado 2: granted + revoked)"
+[ "$A" = "2" ] && ok "trigger SECURITY DEFINER gravou 2 eventos sob nexus_app" || bad "esperado 2 eventos, veio $A"
+
+DET=$(read_as_app_ctx "SELECT 'ACOES='||string_agg(action::text,',' ORDER BY id) FROM nexus.tool_grant_audit WHERE grant_id='c2000000-0000-4000-8000-000000000001';" | grep -E '^ACOES=' | sed 's/^ACOES=//')
+say "   acoes registradas: $DET"
+case "$DET" in granted,revoked) ok "ordem e acoes corretas" ;; *) bad "acoes inesperadas: $DET" ;; esac
+
+SEMCTX=$($PSQL -X $H -U nexus_app -d $DB -tAq -c "SELECT count(*) FROM nexus.tool_grant_audit;" | grep -E '^[0-9]+$' | head -1)
+say "   mesma consulta SEM contexto: $SEMCTX (esperado 0 - RLS esconde a trilha)"
+[ "${SEMCTX:-1}" = "0" ] && ok "RLS esconde a trilha fora do contexto (defesa em profundidade)" \
+                          || bad "trilha visivel sem contexto: $SEMCTX"
+say "   quem gravou de fato (dono da funcao):"
+$PSQL -X $H -U postgres -d $DB -tAc "
+SELECT '     '||pg_get_userbyid(proowner) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
+WHERE n.nspname='nexus' AND p.proname='audit_tool_grant_change';"
+
+echo
+echo "================================================================================="
+echo " 6. TRILHA CONTINUA APPEND-ONLY PARA nexus_app"
+echo "================================================================================="
+for op in "UPDATE nexus.tool_grant_audit SET action='granted'" "DELETE FROM nexus.tool_grant_audit"; do
+  out=$(as_app "$op;")
+  case "$out" in
+    *"permission denied"*|*"violates row-level security"*) ok "recusado: $(echo "$out" | head -1)" ;;
+    *) bad "operacao aceita: $op -> $out" ;;
+  esac
+done
+INS=$(as_app "INSERT INTO nexus.tool_grant_audit (owner_id,grant_id,assistant_id,tool_id,action,actor_owner_id) VALUES ('$OWNER',gen_random_uuid(),'00000000-0000-4000-8000-000000000001','personal.tasks','granted','$OWNER');")
+case "$INS" in
+  *"permission denied"*) ok "INSERT direto na trilha recusado" ;;
+  *) bad "INSERT direto aceito: $INS" ;;
+esac
+
+echo
+echo "================================================================================="
+echo " 7. RLS CONTINUA EFETIVA (isolamento e falha fechada)"
+echo "================================================================================="
+# sem contexto: nao ve nada
+SEM=$(as_app "SELECT count(*) FROM nexus.conversations;")
+say "   conversas visiveis SEM contexto de owner: $SEM (esperado 0 = falha fechada)"
+[ "$SEM" = "0" ] && ok "RLS falha fechada sem contexto" || bad "vazou $SEM linhas sem contexto"
+
+# com contexto: ve as proprias
+COM=$($PSQL -X $H -U nexus_app -d $DB -tAq <<SQL 2>&1
+BEGIN;
+SELECT set_config('nexus.owner_id','$OWNER',true);
+SELECT set_config('nexus.actor_type','owner',true);
+SELECT count(*) FROM nexus.conversations;
+COMMIT;
+SQL
+)
+COM=$(echo "$COM" | grep -E '^[0-9]+$' | head -1)
+say "   conversas visiveis COM contexto: $COM (esperado >= 1)"
+[ "${COM:-0}" -ge 1 ] && ok "RLS libera o owner correto" || bad "owner nao ve as proprias linhas"
+
+# contexto de outro owner: nao ve nada
+OUTRO=$($PSQL -X $H -U nexus_app -d $DB -tAq <<'SQL' 2>&1
+BEGIN;
+SELECT set_config('nexus.owner_id','99999999-0000-4000-8000-000000000001',true);
+SELECT set_config('nexus.actor_type','owner',true);
+SELECT count(*) FROM nexus.conversations;
+COMMIT;
+SQL
+)
+OUTRO=$(echo "$OUTRO" | grep -E '^[0-9]+$' | head -1)
+say "   conversas visiveis com contexto de OUTRO owner: $OUTRO (esperado 0)"
+[ "${OUTRO:-1}" = "0" ] && ok "RLS isola o owner" || bad "vazou $OUTRO linhas para outro owner"
+
+# escrita com contexto de outro owner: recusada
+W=$($PSQL -X $H -U nexus_app -d $DB -tAq <<'SQL' 2>&1
+BEGIN;
+SELECT set_config('nexus.owner_id','99999999-0000-4000-8000-000000000001',true);
+SELECT set_config('nexus.actor_type','owner',true);
+INSERT INTO nexus.conversations (id, owner_id, title)
+VALUES ('c3000000-0000-4000-8000-000000000001','99999999-0000-4000-8000-000000000001','forged');
+COMMIT;
+SQL
+)
+case "$W" in
+  *"violates row-level security"*|*"foreign key"*) ok "escrita com owner forjado recusada" ;;
+  *) bad "escrita com owner forjado aceita: $W" ;;
+esac
+
+echo
+echo "================================================================================="
+echo " 8. nexus_app NAO E DONO DE NADA"
+echo "================================================================================="
+$PSQL -X $H -U postgres -d $DB -tAc "
+SELECT '   tabelas de que nexus_app e dono: '||count(*) FROM pg_class c
+JOIN pg_namespace n ON n.oid=c.relnamespace
+WHERE n.nspname='nexus' AND pg_get_userbyid(c.relowner)='nexus_app';"
+$PSQL -X $H -U postgres -d $DB -tAc "
+SELECT '   schemas de que nexus_app e dono: '||count(*) FROM pg_namespace
+WHERE pg_get_userbyid(nspowner)='nexus_app';"
+$PSQL -X $H -U postgres -d $DB -tAc "
+SELECT '   funcoes de que nexus_app e dono: '||count(*) FROM pg_proc p
+JOIN pg_namespace n ON n.oid=p.pronamespace
+WHERE n.nspname='nexus' AND pg_get_userbyid(p.proowner)='nexus_app';"
+
+echo
+echo "================================================================================="
+echo " 9. CREDENCIAL DE RUNTIME NAO CONSEGUE PROVISIONAR"
+echo "================================================================================="
+out=$(as_app "CREATE ROLE rogue NOLOGIN;" 2>&1)
+case "$out" in *"permission denied"*) ok "nexus_app nao cria papeis" ;; *) bad "criou papel: $out" ;; esac
+out=$(as_app "ALTER FUNCTION nexus.audit_tool_grant_change() OWNER TO nexus_app;" 2>&1)
+case "$out" in *"must be owner"*|*"permission denied"*) ok "nexus_app nao transfere propriedade de funcao" ;; *) bad "transferiu: $out" ;; esac
+
+echo
+if [ $FAILS -eq 0 ]; then say "== ISOLAMENTO DO RUNTIME: TODAS AS PROVAS PASSARAM =="; exit 0
+else say "== $FAILS FALHA(S) =="; exit 1; fi
diff --git a/packages/database/migrations/00007_tool_grants_and_preferences.sql b/packages/database/migrations/00007_tool_grants_and_preferences.sql
new file mode 100644
index 0000000..d54d581
--- /dev/null
+++ b/packages/database/migrations/00007_tool_grants_and_preferences.sql
@@ -0,0 +1,618 @@
+-- Etapa 3C.3, Fase 5 (G13): catalogo global x configuracoes pessoais.
+--
+-- Escopo desta migration: apenas persistencia e isolamento. Nao ha repositorio TypeScript,
+-- rota, nem integracao de `evaluateToolPolicy` aqui — isso e 5.2/5.3/5.4.
+--
+-- Modelo conceitual (docs/FASE_5_G13_CATALOGO_GLOBAL_CONFIGURACOES_PESSOAIS.md, §4):
+--   * `nexus.tool_grants`               autorizacao pessoal: quem (owner) permite qual ferramenta
+--                                       para qual assistente. Deny-by-default: a ausencia de linha
+--                                       significa "nao concedido".
+--   * `nexus.tool_grant_audit`          trilha append-only de concessoes e revogacoes.
+--   * `nexus.user_assistant_preferences` preferencias de apresentacao do owner. Nao autorizam nada.
+--
+-- Regras desta migration:
+--   * ADITIVA. Nenhuma tabela, coluna ou linha existente e alterada. 00001-00006 sao imutaveis.
+--   * IDENTIDADE COMPOSTA com `owner_id` nas tres tabelas. As tabelas de preferencia legadas
+--     (`assistant_provider_preferences`, `conversation_provider_preferences`) usam PK sem
+--     `owner_id` e so funcionam porque `nexus.owner_identity` e singleton. O padrao nao e
+--     repetido aqui: `(owner_id, assistant_id)` e `(owner_id, assistant_id, tool_id)`.
+--   * RLS `ENABLE` + `FORCE` nas tres tabelas. `FORCE` importa porque garante que o isolamento
+--     vale tambem para o proprietario das tabelas, nao apenas para `nexus_app`.
+--   * A auditoria e escrita exclusivamente por funcao `SECURITY DEFINER`, e a aplicacao recebe
+--     apenas `SELECT` sobre ela. A funcao pertence ao papel `nexus_audit_writer` (NOLOGIN,
+--     NOSUPERUSER, NOBYPASSRLS) e escreve via policy de INSERT escopada a esse papel — sem
+--     SUPERUSER/BYPASSRLS e sem policy generica de INSERT (ver secao 2.1).
+--   * Os enums desta migration nao ficam com `USAGE` para PUBLIC: ver bloco final de ACL.
+--
+-- Adaptacoes em relacao a `nexus.memory_permissions` (padrao de referencia), todas justificadas:
+--   1. `memory_permissions` usa `UNIQUE (memory_id, assistant_id)` sem `owner_id`. Aqui a
+--      unicidade inclui `owner_id`, pelo motivo acima.
+--   2. `memory_permissions` guarda `granted_by_owner_id`/`revoked_by_owner_id`; mantemos os dois
+--      campos e acrescentamos `created_at`/`updated_at`, que `memory_permissions` nao tem. Isso
+--      permite ordenar e auditar a linha sem depender de `granted_at`/`revoked_at`.
+--   3. `memory_permissions` aceita historico apenas pelo par status+timestamps. Aqui o mesmo par e
+--      exigido, mais um trigger que impede reaproveitar a linha para outro escopo (ver abaixo).
+BEGIN;
+
+CREATE TYPE nexus.tool_grant_status AS ENUM ('granted', 'revoked');
+CREATE TYPE nexus.tool_grant_action AS ENUM ('granted', 'revoked');
+
+-- ---------------------------------------------------------------------------------------------
+-- 1. Autorizacao pessoal de ferramenta
+-- ---------------------------------------------------------------------------------------------
+CREATE TABLE nexus.tool_grants (
+  id uuid PRIMARY KEY,
+  owner_id uuid NOT NULL REFERENCES nexus.owner_identity(id) ON DELETE CASCADE,
+  assistant_id uuid NOT NULL REFERENCES nexus.assistants(id) ON DELETE RESTRICT,
+  -- `tool_id` referencia o catalogo de `packages/tools`, que vive em codigo e nao em tabela.
+  -- Nao ha FK possivel: `nexus.tool_definitions` nao existe (decisao explicita da Fase 5 —
+  -- criar um espelho sem leitor seria estrutura sobreposta). A integridade e garantida por:
+  --   * formato, via CHECK de unicidade de id nao vazio;
+  --   * existencia no catalogo, na camada de dominio (5.3/5.4), antes do INSERT.
+  tool_id text NOT NULL,
+  status nexus.tool_grant_status NOT NULL,
+  granted_by_owner_id uuid NOT NULL,
+  granted_at timestamptz NOT NULL,
+  revoked_by_owner_id uuid,
+  revoked_at timestamptz,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  CONSTRAINT tool_grants_unique_scope UNIQUE (owner_id, assistant_id, tool_id),
+  CONSTRAINT tool_grants_tool_id_not_blank CHECK (btrim(tool_id) <> ''),
+  CONSTRAINT tool_grants_tool_id_format
+    CHECK (tool_id ~ '^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$'),
+  -- Um grant so pode ser concedido pelo proprio owner da linha. Este CHECK torna impossivel
+  -- gravar uma concessao "em nome de outro owner" mesmo por SQL privilegiado: o RLS compara com
+  -- o contexto, nao com a semantica da linha, entao essa coerencia precisa existir no schema.
+  CONSTRAINT tool_grants_granted_by_owner CHECK (granted_by_owner_id = owner_id),
+  CONSTRAINT tool_grants_revoked_by_owner
+    CHECK (revoked_by_owner_id IS NULL OR revoked_by_owner_id = owner_id),
+  -- Estados temporalmente coerentes: ou ativo sem revogacao, ou revogado com revogacao completa
+  -- e posterior a concessao. Nao existe "revogado sem quem revogou" nem "ativo com revoked_at".
+  CONSTRAINT tool_grants_state_coherent CHECK (
+    (status = 'granted' AND revoked_by_owner_id IS NULL AND revoked_at IS NULL)
+    OR (status = 'revoked' AND revoked_by_owner_id IS NOT NULL
+        AND revoked_at IS NOT NULL AND revoked_at >= granted_at)
+  ),
+  CONSTRAINT tool_grants_timestamps_ordered CHECK (updated_at >= created_at)
+);
+
+-- Caminho quente da politica: "existe grant ativo para (owner, assistente, ferramenta)?"
+CREATE INDEX tool_grants_active_lookup_idx
+  ON nexus.tool_grants (owner_id, assistant_id, tool_id)
+  WHERE status = 'granted';
+-- Listagem de interface, que inclui as linhas revogadas.
+CREATE INDEX tool_grants_by_owner_assistant_idx
+  ON nexus.tool_grants (owner_id, assistant_id);
+
+-- Coerencia de ciclo de vida que um CHECK nao consegue expressar (depende de OLD):
+--   * uma linha nasce concedida — nao existe "revogacao sem concessao previa";
+--   * o escopo (owner, assistente, ferramenta) e imutavel — uma linha revogada nao pode ser
+--     reaproveitada para autorizar outro par, o que criaria uma trilha de auditoria mentirosa.
+CREATE FUNCTION nexus.enforce_tool_grant_lifecycle()
+RETURNS trigger
+LANGUAGE plpgsql
+SET search_path = pg_catalog
+AS $$
+BEGIN
+  -- (1) Uma linha de autorizacao nasce CONCEDIDA. Nao existe historico que comece revogado, e
+  -- uma linha ativa nao pode nascer com marcadores de revogacao.
+  IF TG_OP = 'INSERT' THEN
+    IF NEW.status <> 'granted' THEN
+      RAISE EXCEPTION 'Tool grant history must begin with an explicit grant'
+        USING ERRCODE = '42501';
+    END IF;
+    IF NEW.revoked_at IS NOT NULL OR NEW.revoked_by_owner_id IS NOT NULL THEN
+      RAISE EXCEPTION 'An active tool grant cannot carry revocation markers'
+        USING ERRCODE = '42501';
+    END IF;
+    RETURN NEW;
+  END IF;
+
+  -- (3) e (5) `revoked` e TERMINAL e IMUTAVEL: nenhuma coluna pode mudar depois da revogacao.
+  -- Isto cobre `revoked -> granted`, `revoked -> revoked` com novo `revoked_at`, troca de
+  -- `revoked_by_owner_id` e qualquer outra atualizacao de linha revogada.
+  IF OLD.status = 'revoked' THEN
+    RAISE EXCEPTION 'Revoked tool grant is immutable' USING ERRCODE = '42501';
+  END IF;
+
+  -- (6) Escopo imutavel em QUALQUER atualizacao (inclusive na transicao para revogado).
+  IF NEW.id IS DISTINCT FROM OLD.id
+     OR NEW.owner_id IS DISTINCT FROM OLD.owner_id
+     OR NEW.assistant_id IS DISTINCT FROM OLD.assistant_id
+     OR NEW.tool_id IS DISTINCT FROM OLD.tool_id THEN
+    RAISE EXCEPTION 'Tool grant scope is immutable' USING ERRCODE = '42501';
+  END IF;
+
+  -- (7) Proveniencia da concessao imutavel: `granted_by`/`granted_at` nunca sao reescritos,
+  -- nem na transicao para revogado. Sem isso seria possivel retro-datar uma concessao ja
+  -- auditada e deixar a trilha contando uma historia falsa.
+  IF NEW.granted_by_owner_id IS DISTINCT FROM OLD.granted_by_owner_id
+     OR NEW.granted_at IS DISTINCT FROM OLD.granted_at THEN
+    RAISE EXCEPTION 'Tool grant provenance is immutable' USING ERRCODE = '42501';
+  END IF;
+
+  -- (2) A unica transicao de status a partir de `granted` e `granted -> revoked`.
+  -- `granted -> granted` e REJEITADO, inclusive tocar apenas `updated_at`: um grant ativo nao e
+  -- editavel. Isso fecha a ultima brecha na qual um UPDATE passava sem gerar evento de auditoria,
+  -- deixando a coluna alterada e a trilha sem registro. Toda escrita em `tool_grants` ou e a
+  -- concessao (INSERT) ou e a revogacao (unica transicao) — as duas auditadas.
+  IF NEW.status = 'granted' THEN
+    RAISE EXCEPTION 'Active tool grant is immutable: the only allowed update is granted -> revoked'
+      USING ERRCODE = '42501';
+  END IF;
+
+  -- (4) Aqui OLD.status = 'granted' e NEW.status = 'revoked'. A revogacao precisa estar completa:
+  -- quem revogou e quando. `tool_grants_state_coherent` tambem exige, mas o trigger da o erro
+  -- com nome de regra em vez de violacao de CHECK.
+  IF NEW.revoked_by_owner_id IS NULL OR NEW.revoked_at IS NULL THEN
+    RAISE EXCEPTION 'Revocation requires both revoked_by_owner_id and revoked_at'
+      USING ERRCODE = '42501';
+  END IF;
+
+  RETURN NEW;
+END
+$$;
+
+CREATE TRIGGER tool_grants_lifecycle_guard
+BEFORE INSERT OR UPDATE ON nexus.tool_grants
+FOR EACH ROW EXECUTE FUNCTION nexus.enforce_tool_grant_lifecycle();
+
+-- ---------------------------------------------------------------------------------------------
+-- 2. Auditoria append-only
+-- ---------------------------------------------------------------------------------------------
+-- POLITICA DE RETENCAO desta trilha (decidida e verificada):
+--
+--   * append-only durante toda a vida da instalacao: `nexus_app` nao tem privilegio de INSERT,
+--     UPDATE ou DELETE aqui, e existe apenas uma policy de SELECT. Escrita somente pela funcao
+--     SECURITY DEFINER abaixo;
+--   * excluir um GRANT preserva seus eventos. `grant_id` e deliberadamente SEM foreign key:
+--     e um snapshot historico, e sobrevive ao DELETE da linha correspondente em `tool_grants`.
+--     Verificado no bloco L de `tests/postgres/verify-stage-5-rls.sql`;
+--   * excluir DEFINITIVAMENTE o owner apaga a trilha junto. `owner_id` tem `ON DELETE CASCADE`
+--     porque remover a linha de `owner_identity` representa a destruicao integral dos dados da
+--     instalacao, e nao uma operacao de rotina. Verificado no bloco de cascata;
+--   * o mesmo raciocinio vale para `memory_permission_audit` em 00001, que guarda uuids como
+--     snapshot pelo mesmo motivo.
+--
+-- A distincao entre os dois primeiros casos e o que impede ler "append-only" como "imortal":
+-- a trilha e imutavel, nao e indestrutivel.
+--
+-- LIMITE DE SEGURANCA — SUPERUSER ESTA FORA DA FRONTEIRA DO RLS. Verificado em PostgreSQL 17.11:
+-- mesmo com `ENABLE` + `FORCE` e sem NENHUMA policy de INSERT para o dono, um SUPERUSER consegue
+-- inserir direto em `tool_grant_audit` sem contexto. `FORCE` faz o RLS valer para o DONO da
+-- tabela, nao para SUPERUSER/BYPASSRLS — isso e o modelo do PostgreSQL, nao um defeito desta
+-- policy, e nao ha como corrigi-lo dentro do RLS. Consequencias praticas, aceitas:
+--   * quem tem SUPERUSER pode forjar ou apagar auditoria; a trilha protege contra a APLICACAO
+--     (`nexus_app`), contra o dono do schema e contra papeis comuns, nao contra o DBA;
+--   * a operacao normal NAO precisa de SUPERUSER: a gravacao da trilha e feita pelo papel
+--     `nexus_audit_writer` (NOLOGIN, NOSUPERUSER, NOBYPASSRLS) via SECURITY DEFINER, e o
+--     provisionamento exige apenas CREATEROLE + GRANT OPTION (ver secao 2.1);
+--   * por isso a recomendacao operacional e: SUPERUSER so em janela administrativa, e
+--     `nexus_app`/`nexus_audit_writer` NUNCA com SUPERUSER ou BYPASSRLS.
+-- O teste `C2.4c` de `tests/postgres/verify-stage-5-grants-lifecycle.sql` fixa esse limite como
+-- comportamento ESPERADO: se um dia um superusuario deixar de conseguir furar o RLS, o teste
+-- falha e esta documentacao precisa ser revista.
+CREATE TABLE nexus.tool_grant_audit (
+  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  owner_id uuid NOT NULL REFERENCES nexus.owner_identity(id) ON DELETE CASCADE,
+  grant_id uuid NOT NULL,
+  assistant_id uuid NOT NULL REFERENCES nexus.assistants(id) ON DELETE RESTRICT,
+  tool_id text NOT NULL,
+  action nexus.tool_grant_action NOT NULL,
+  actor_owner_id uuid NOT NULL,
+  occurred_at timestamptz NOT NULL DEFAULT now(),
+  CONSTRAINT tool_grant_audit_actor_is_owner CHECK (actor_owner_id = owner_id)
+);
+CREATE INDEX tool_grant_audit_by_grant_idx
+  ON nexus.tool_grant_audit (owner_id, grant_id, occurred_at DESC);
+
+-- SECURITY DEFINER porque `nexus_app` tem apenas SELECT nesta tabela: a aplicacao le a trilha,
+-- nunca a escreve. Sem isso, um comprometimento da credencial de aplicacao permitiria forjar
+-- auditoria. Restricoes obrigatorias em toda funcao privilegiada:
+--   * `SET search_path = pg_catalog` — nada e resolvido fora de `pg_catalog`, exceto os nomes
+--     ja qualificados com `nexus.` abaixo;
+--   * os dados vem exclusivamente de NEW/OLD (linhas ja validadas pelos CHECK da tabela);
+--   * nao aceita parametro do chamador, portanto nao ha superficie de injecao;
+--   * `REVOKE ALL ... FROM PUBLIC` imediatamente apos a criacao.
+CREATE FUNCTION nexus.audit_tool_grant_change()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog
+AS $$
+DECLARE
+  audit_action nexus.tool_grant_action;
+BEGIN
+  -- Mapeamento EXPLICITO entre os dois enums, sem cast. `::text::` acoplava os rotulos dos dois
+  -- tipos: se um deles ganhasse um valor novo sem o outro, o cast falharia em runtime, dentro do
+  -- trigger. Com CASE, cada valor e tratado e um valor inesperado levanta erro nomeado.
+  IF TG_OP = 'INSERT' THEN
+    audit_action := 'granted';
+  ELSIF NEW.status IS DISTINCT FROM OLD.status THEN
+    audit_action := CASE NEW.status
+                      WHEN 'granted' THEN 'granted'::nexus.tool_grant_action
+                      WHEN 'revoked' THEN 'revoked'::nexus.tool_grant_action
+                      ELSE NULL
+                    END;
+    IF audit_action IS NULL THEN
+      RAISE EXCEPTION 'Unmapped tool grant status in audit trigger: %', NEW.status;
+    END IF;
+  ELSE
+    -- Inalcancavel pelo trigger de ciclo de vida (todo UPDATE nao-revogacao passa por
+    -- granted -> revoked). Mantido como barreira caso o trigger de lifecycle seja removido.
+    RAISE EXCEPTION 'Tool grant update without status change reached the audit trigger'
+      USING ERRCODE = '42501';
+  END IF;
+
+  INSERT INTO nexus.tool_grant_audit (
+    owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id
+  ) VALUES (
+    NEW.owner_id,
+    NEW.id,
+    NEW.assistant_id,
+    NEW.tool_id,
+    audit_action,
+    CASE WHEN audit_action = 'granted'
+         THEN NEW.granted_by_owner_id
+         ELSE NEW.revoked_by_owner_id
+    END
+  );
+
+  RETURN NEW;
+END
+$$;
+
+CREATE TRIGGER tool_grants_audit_changes
+AFTER INSERT OR UPDATE ON nexus.tool_grants
+FOR EACH ROW EXECUTE FUNCTION nexus.audit_tool_grant_change();
+REVOKE ALL ON FUNCTION nexus.audit_tool_grant_change() FROM PUBLIC;
+
+-- ---------------------------------------------------------------------------------------------
+-- 2.1 Papel de escrita da trilha — por que a funcao nao pertence ao dono do schema
+-- ---------------------------------------------------------------------------------------------
+-- `FORCE ROW LEVEL SECURITY` aplica as policies ao PROPRIO dono da tabela. Uma funcao
+-- `SECURITY DEFINER` cujo dono fosse um papel de bootstrap (NOSUPERUSER/NOBYPASSRLS) NAO teria
+-- policy de INSERT em `tool_grant_audit` e falharia com
+--     new row violates row-level security policy for table "tool_grant_audit"
+-- quando o bootstrap nao fosse superusuario. Verificado em PostgreSQL 17.11.
+--
+-- A saida NAO e uma policy permissiva para o dono nem BYPASSRLS: e um papel dedicado, sem login,
+-- que so consegue inserir NESTA tabela. A funcao passa a pertencer a ele e a policy de INSERT e
+-- escopada (`TO nexus_audit_writer`), de modo que o privilegio nao vaza para `nexus_app` nem para
+-- o dono do schema. Assim a gravacao da trilha funciona igual em instalacao real sem SUPERUSER.
+-- `CREATE ROLE` e objeto de CLUSTER, nao de banco: sobrevive a `DROP DATABASE` e nao e desfeito
+-- por ROLLBACK. A criacao e idempotente; os atributos de um papel PREEXISTENTE sao VERIFICADOS
+-- (nao reafirmados) — ver o bloco de checagem logo abaixo, que explica por que `ALTER ROLE` nao
+-- pode ser usado por um provisionador sem SUPERUSER/CREATEDB/BYPASSRLS.
+--
+-- =============================================================================================
+-- PROVISIONAMENTO EM INSTALACAO REAL SEM SUPERUSER (verificado em PostgreSQL 17.11)
+-- =============================================================================================
+-- O que NAO basta, comprovado por experimento:
+--   * `CREATEROLE` sozinho NAO permite `ALTER FUNCTION ... OWNER TO nexus_audit_writer`:
+--     falha com `must be able to SET ROLE "nexus_audit_writer"`.
+--   * Criar o papel pela propria migration (como `CREATE ROLE`) NAO da ao provisionador o
+--     direito de assumi-lo: a membresia automatica criada pelo `CREATE ROLE` tem
+--     `set_option = false` e `grantor` = papel de bootstrap, nao o provisionador.
+--   * `ALTER FUNCTION ... OWNER TO` exige que o NOVO dono tenha `CREATE` no schema do objeto.
+--     Sem isso a mensagem e enganosa: `permission denied for schema nexus` (o problema e o
+--     privilegio do novo dono, nao do executante).
+--
+-- Sequencia CORRETA para o provisionador (papel com CREATEROLE, NOSUPERUSER, NOBYPASSRLS):
+--   1. `CREATE ROLE nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;`
+--   2. `GRANT USAGE, CREATE ON SCHEMA nexus TO nexus_audit_writer;`
+--   3. `GRANT nexus_audit_writer TO <provisionador> WITH SET TRUE, INHERIT TRUE;`
+--   4. `GRANT USAGE, CREATE ON SCHEMA nexus TO <provisionador> WITH GRANT OPTION;`
+--      `GRANT ALL ON ALL TABLES IN SCHEMA nexus TO <provisionador> WITH GRANT OPTION;`
+--   5. aplicar as migrations (esta incluida), que fazem o `ALTER FUNCTION ... OWNER TO`.
+--   6. (depois) `REVOKE CREATE ON SCHEMA nexus FROM nexus_audit_writer;` — o `CREATE` so era
+--      necessario para a transferencia de propriedade; o INSERT nao precisa dele.
+--
+-- GRANT OPTION e obrigatorio no provisionador. Esta migration concede ao escritor
+--     privilegios sobre objetos cujo dono e OUTRO papel (o que aplicou a 00001). Sem
+--     `WITH GRANT OPTION` o PostgreSQL NAO levanta erro: emite
+--         WARNING:  no privileges were granted for "owner_identity"
+--     e o GRANT e silenciosamente ignorado. A migration "passa" com o escritor sem permissao e a
+--     falha so aparece em runtime, na primeira auditoria (ver passo 4 acima).
+--
+-- Privilegios minimos do provisionador, no total: CREATEROLE (para criar o escritor) + USAGE e
+-- CREATE no schema `nexus` + GRANT OPTION nos objetos que delega. Nada de SUPERUSER nem
+-- BYPASSRLS — nem no provisionador, nem no escritor, nem em `nexus_app`. Nada de ownership
+-- amplo: ele nao precisa ser dono das tabelas, so poder delegar sobre elas.
+DO $$
+BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'nexus_audit_writer') THEN
+    -- Os atributos sao definidos NA CRIACAO. `CREATE ROLE` permite ao papel com CREATEROLE
+    -- definir NOSUPERUSER/NOBYPASSRLS/NOCREATEDB; `ALTER ROLE` NAO permite (ver abaixo).
+    CREATE ROLE nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;
+  END IF;
+END
+$$;
+
+-- ATENCAO — armadilha verificada em PostgreSQL 17.11: `ALTER ROLE ... NOSUPERUSER` exige que o
+-- EXECUTANTE seja SUPERUSER, `ALTER ROLE ... NOCREATEDB` exige CREATEDB, e
+-- `ALTER ROLE ... NOBYPASSRLS` exige BYPASSRLS. Um provisionador apenas com CREATEROLE recebe
+--     ERROR: permission denied to alter role
+--     DETAIL: Only roles with the SUPERUSER attribute may change the SUPERUSER attribute.
+-- por isso a instrucao NAO e executada aqui: ela quebraria exatamente o cenario "sem superuser"
+-- que este bloco existe para suportar. Em vez de reafirmar, VERIFICAMOS e falhamos com uma
+-- mensagem acionavel — se um papel pre-existente estiver com atributo errado, quem corrige e um
+-- superusuario, uma unica vez, e o erro diz isso.
+DO $$
+DECLARE
+  r record;
+BEGIN
+  SELECT rolcanlogin, rolsuper, rolbypassrls, rolcreatedb, rolcreaterole
+    INTO r
+    FROM pg_roles WHERE rolname = 'nexus_audit_writer';
+
+  IF r.rolcanlogin OR r.rolsuper OR r.rolbypassrls OR r.rolcreatedb OR r.rolcreaterole THEN
+    RAISE EXCEPTION
+      'Role nexus_audit_writer has unsafe attributes (login=%, superuser=%, bypassrls=%, createdb=%, createrole=%). A superuser must fix it once with: ALTER ROLE nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;',
+      r.rolcanlogin, r.rolsuper, r.rolbypassrls, r.rolcreatedb, r.rolcreaterole
+      USING ERRCODE = '42501';
+  END IF;
+END
+$$;
+
+-- Memberships: o escritor nao herda nada de ninguem e nao e membro de nenhum outro papel. Se o
+-- papel foi pre-existente com memberships (por exemplo alguem o adicionou a `pg_read_all_data`),
+-- elas sao removidas aqui. Sem isso, o `INSERT` restrito a uma tabela poderia virar leitura
+-- ampla do banco por heranca.
+DO $$
+DECLARE
+  m record;
+BEGIN
+  FOR m IN
+    SELECT parent.rolname AS parent
+    FROM pg_auth_members am
+    JOIN pg_roles child ON child.oid = am.member
+    JOIN pg_roles parent ON parent.oid = am.roleid
+    WHERE child.rolname = 'nexus_audit_writer'
+  LOOP
+    EXECUTE format('REVOKE %I FROM nexus_audit_writer', m.parent);
+  END LOOP;
+END
+$$;
+
+-- `nexus_app` nunca pode ser membro do escritor: seria escalada de privilegio (o escritor tem
+-- INSERT na trilha). Se algum provisionamento deixou isso para tras, e removido aqui.
+DO $$
+BEGIN
+  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'nexus_app') THEN
+    IF pg_has_role('nexus_app', 'nexus_audit_writer', 'MEMBER') THEN
+      REVOKE nexus_audit_writer FROM nexus_app;
+    END IF;
+    IF pg_has_role('nexus_audit_writer', 'nexus_app', 'MEMBER') THEN
+      REVOKE nexus_app FROM nexus_audit_writer;
+    END IF;
+  END IF;
+END
+$$;
+
+GRANT USAGE ON SCHEMA nexus TO nexus_audit_writer;
+-- `CREATE` no schema e requisito do `ALTER FUNCTION ... OWNER TO` (ver bloco acima).
+GRANT CREATE ON SCHEMA nexus TO nexus_audit_writer;
+GRANT INSERT ON nexus.tool_grant_audit TO nexus_audit_writer;
+-- A policy de INSERT da trilha compara a linha com `nexus.current_owner_id()` e
+-- `nexus.configured_owner_id()`. A segunda le `nexus.owner_identity` como o PAPEL CORRENTE
+-- (a funcao nao e SECURITY DEFINER), entao o escritor precisa de SELECT nessa tabela. Sem isso a
+-- escrita falha com `permission denied for table owner_identity` dentro da policy. E o minimo
+-- necessario: SELECT apenas em `owner_identity`, nada mais.
+GRANT SELECT ON nexus.owner_identity TO nexus_audit_writer;
+ALTER FUNCTION nexus.audit_tool_grant_change() OWNER TO nexus_audit_writer;
+-- Depois da transferencia o `CREATE` nao serve para mais nada: a funcao ja e do escritor e ele
+-- so precisa de INSERT. Reduzir aqui evita que o papel crie objetos no schema `nexus`.
+REVOKE CREATE ON SCHEMA nexus FROM nexus_audit_writer;
+
+-- ---------------------------------------------------------------------------------------------
+-- 3. Preferencias pessoais de apresentacao
+-- ---------------------------------------------------------------------------------------------
+-- `user_assistant_settings` NAO e criada: teria a mesma chave `(owner_id, assistant_id)` e o
+-- mesmo ciclo de vida, ou seja, responsabilidade sobreposta. Verbosidade entra aqui como coluna
+-- tipada. "Confirmacoes" e "limites pessoais" nao entram: o primeiro precisa permanecer derivado
+-- de `tool.requiresUserConfirmation` (uma coluna configuravel permitiria ao cliente desligar uma
+-- exigencia de seguranca) e o segundo pertence a fase que o aplica (runtime de ferramentas).
+CREATE TABLE nexus.user_assistant_preferences (
+  owner_id uuid NOT NULL REFERENCES nexus.owner_identity(id) ON DELETE CASCADE,
+  assistant_id uuid NOT NULL REFERENCES nexus.assistants(id) ON DELETE CASCADE,
+  is_default boolean NOT NULL DEFAULT false,
+  sort_order integer NOT NULL DEFAULT 0,
+  display_label text,
+  response_verbosity text NOT NULL DEFAULT 'normal',
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (owner_id, assistant_id),
+  CONSTRAINT user_assistant_preferences_sort_order CHECK (sort_order >= 0),
+  CONSTRAINT user_assistant_preferences_label_length
+    CHECK (display_label IS NULL OR char_length(display_label) BETWEEN 1 AND 64),
+  -- `char_length` aceitaria '   ' (tres espacos) como rotulo de 3 caracteres. Branco apenas nao
+  -- e rotulo. `btrim` NAO serve sozinho: sem argumento ele remove apenas espaco, nao TAB/quebra
+  -- de linha — e `E'\t'` passaria. A expressao regular cobre todo branco POSIX
+  -- (espaco, tab, newline, CR, FF, VT). NULL continua permitido (rotulo e opcional).
+  CONSTRAINT user_assistant_preferences_label_not_blank
+    CHECK (display_label IS NULL OR display_label ~ '[^[:space:]]'),
+  -- Rotulo e texto livre digitado pelo owner; usa o helper de deteccao de credencial que ja
+  -- existe em 00001 para impedir colar um token aqui. Nao ha coluna JSONB nesta migration, por
+  -- isso `jsonb_has_credential_key` nao se aplica.
+  CONSTRAINT user_assistant_preferences_label_not_credential
+    CHECK (display_label IS NULL OR NOT nexus.text_looks_like_credential_material(display_label)),
+  CONSTRAINT user_assistant_preferences_verbosity
+    CHECK (response_verbosity IN ('concise', 'normal', 'detailed')),
+  CONSTRAINT user_assistant_preferences_timestamps_ordered
+    CHECK (updated_at >= created_at)
+);
+
+-- No maximo um assistente padrao por owner. Indice unico parcial em vez de trigger: a troca do
+-- padrao exige que o repositorio (5.2) desmarque o anterior e marque o novo na MESMA transacao.
+CREATE UNIQUE INDEX user_assistant_preferences_single_default_idx
+  ON nexus.user_assistant_preferences (owner_id)
+  WHERE is_default;
+
+-- ---------------------------------------------------------------------------------------------
+-- 4. Isolamento: RLS forcada + politicas explicitas por comando
+-- ---------------------------------------------------------------------------------------------
+-- Duas variantes de politica coexistem em 00001 e a escolha aqui e deliberada:
+--
+--   * `tool_grants` e `tool_grant_audit` usam a variante ESTRITA (SELECT tambem exige
+--     `actor_type = 'owner'`). Um actor `assistant` nunca le nem escreve autorizacao: a
+--     resolucao de "o que eu posso usar" e feita pelo servidor, com actor owner, antes de
+--     qualquer delegacao. Dar leitura a um actor assistant permitiria ao modelo descobrir o
+--     proprio conjunto de permissoes e contornar a regra de que YUI coordena mas nao e
+--     onipotente.
+--
+--   * `user_assistant_preferences` usa a variante com LEITURA AMPLA (SELECT sem `actor_type`;
+--     escrita exige `owner`), igual a `assistant_provider_preferences` em 00001. O motivo e o
+--     mesmo daquelas tabelas: o CORE precisa ler a preferencia de apresentacao dentro de uma
+--     transacao cujo actor e `assistant`, mas preferencia nunca e escrita por assistente.
+--
+-- A comparacao `owner_id = nexus.configured_owner_id()` e mantida em todas as policies. Hoje ela
+-- e redundante porque `owner_identity` e singleton, mas e o que garante que um contexto com
+-- `nexus.owner_id` sintetico (owner B) nao obtenha acesso — e continuara correta quando a Fase 7
+-- revisar o singleton.
+
+ALTER TABLE nexus.tool_grants ENABLE ROW LEVEL SECURITY;
+ALTER TABLE nexus.tool_grants FORCE ROW LEVEL SECURITY;
+CREATE POLICY tool_grants_owner_select ON nexus.tool_grants
+  FOR SELECT USING (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  );
+CREATE POLICY tool_grants_owner_insert ON nexus.tool_grants
+  FOR INSERT WITH CHECK (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  );
+CREATE POLICY tool_grants_owner_update ON nexus.tool_grants
+  FOR UPDATE USING (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  ) WITH CHECK (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  );
+-- DELETE existe para o CONTRATO DE DOMINIO: o owner pode apagar um grant que e dado pessoal seu.
+--
+-- ATENCAO — a policy de DELETE NAO e o que permite o `ON DELETE CASCADE` de `owner_identity`
+-- funcionar. Acoes de integridade referencial do PostgreSQL sao executadas como o dono da
+-- constraint e NAO passam pelo RLS como um DELETE da aplicacao. Verificado em PostgreSQL 17.11:
+-- remover esta policy e depois apagar a linha de `owner_identity` continua cascateando
+-- `tool_grants` e `tool_grant_audit`. A ausencia da policy faria o DELETE da aplicacao afetar
+-- 0 linhas silenciosamente, e so isso.
+--
+-- Nao ha policy de DELETE para actor assistant: a revogacao de autorizacao e representada por
+-- `status = 'revoked'`, nao por remocao da linha.
+CREATE POLICY tool_grants_owner_delete ON nexus.tool_grants
+  FOR DELETE USING (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  );
+
+-- Append-only: existem apenas policies de SELECT e INSERT. Sem policy de UPDATE/DELETE e com
+-- FORCE RLS, nenhum comando de alteracao encontra linha. `nexus_app` tambem nao recebe o
+-- privilegio de tabela correspondente (ver bootstrap), entao ha duas barreiras independentes.
+ALTER TABLE nexus.tool_grant_audit ENABLE ROW LEVEL SECURITY;
+ALTER TABLE nexus.tool_grant_audit FORCE ROW LEVEL SECURITY;
+CREATE POLICY tool_grant_audit_owner_select ON nexus.tool_grant_audit
+  FOR SELECT USING (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  );
+-- Insercao na trilha e permitida APENAS ao papel escritor da funcao SECURITY DEFINER acima.
+-- Nao existe policy de INSERT para `nexus_app` (que tambem nao possui o privilegio de tabela),
+-- nem para o dono do schema: FORCE RLS vale para ele e ele nao tem policy de INSERT.
+--
+-- `WITH CHECK (true)` foi substituido por verificacao de coerencia. A funcao SECURITY DEFINER
+-- roda com o GUC `nexus.owner_id` do chamador ainda ativo (e o mesmo GUC usado por
+-- `nexus.current_owner_id()` dentro do trigger de auditoria), entao a policy consegue comparar a
+-- linha que esta sendo gravada com o contexto da transacao. Isso impede que qualquer outra funcao
+-- futura com dono `nexus_audit_writer` grave evento de um owner ou de um actor que nao seja o do
+-- contexto — o privilegio de INSERT deixa de ser "pode escrever qualquer linha" e passa a ser
+-- "pode escrever a linha coerente com o contexto corrente".
+CREATE POLICY tool_grant_audit_writer_insert ON nexus.tool_grant_audit
+  FOR INSERT TO nexus_audit_writer WITH CHECK (
+    -- As clausulas `IS NOT NULL` sao DEFESA EM PROFUNDIDADE; a analise honesta e esta: hoje elas
+    -- nao mudam o resultado. `WITH CHECK` exige TRUE, e uma comparacao que resulte NULL conta
+    -- como violacao — sem contexto, `owner_id = current_owner_id()` vira `uuid = NULL` = NULL e
+    -- o INSERT ja seria recusado (verificado em PostgreSQL 17.11: remover as duas clausulas NAO
+    -- faz o teste C2.3b passar a aceitar a linha). O que elas garantem e que isso continue
+    -- valendo se alguem trocar a comparacao por `IS NOT DISTINCT FROM` (que devolve TRUE para
+    -- NULL = NULL) ou envolve-la em `coalesce`. Mantidas porque custo zero e intencao explicita.
+    nexus.current_owner_id() IS NOT NULL
+    AND nexus.configured_owner_id() IS NOT NULL
+    AND owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND actor_owner_id = owner_id
+  );
+
+ALTER TABLE nexus.user_assistant_preferences ENABLE ROW LEVEL SECURITY;
+ALTER TABLE nexus.user_assistant_preferences FORCE ROW LEVEL SECURITY;
+CREATE POLICY user_assistant_preferences_select ON nexus.user_assistant_preferences
+  FOR SELECT USING (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+  );
+CREATE POLICY user_assistant_preferences_owner_insert ON nexus.user_assistant_preferences
+  FOR INSERT WITH CHECK (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  );
+CREATE POLICY user_assistant_preferences_owner_update ON nexus.user_assistant_preferences
+  FOR UPDATE USING (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  ) WITH CHECK (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  );
+CREATE POLICY user_assistant_preferences_owner_delete ON nexus.user_assistant_preferences
+  FOR DELETE USING (
+    owner_id = nexus.current_owner_id()
+    AND owner_id = nexus.configured_owner_id()
+    AND nexus.current_actor_type() = 'owner'
+  );
+
+-- Defesa em profundidade: o schema ja revoga tudo de PUBLIC em 00001, mas as tabelas novas nao
+-- herdam esse REVOKE (ele foi executado antes de existirem). Repetir aqui garante que nenhum
+-- papel inesperado receba privilegio por heranca de PUBLIC.
+REVOKE ALL ON nexus.tool_grants FROM PUBLIC;
+REVOKE ALL ON nexus.tool_grant_audit FROM PUBLIC;
+REVOKE ALL ON nexus.user_assistant_preferences FROM PUBLIC;
+REVOKE ALL ON FUNCTION nexus.enforce_tool_grant_lifecycle() FROM PUBLIC;
+
+-- Enums: `CREATE TYPE` concede USAGE a PUBLIC por padrao. Registrado no catalogo:
+--   typacl IS NULL  =>  acldefault('T', owner)  =>  PUBLIC=USAGE
+-- Um tipo de dominio em `nexus` nao e material publico. Revogamos e concedemos apenas a quem
+-- precisa: `nexus_app` (valores em colunas e comparacoes) e `nexus_audit_writer` (a funcao da
+-- trilha materializa valores de `nexus.tool_grant_action` por CASE, sem cast de texto).
+--
+-- ORDEM DE BOOTSTRAP: as migrations rodam ANTES da criacao dos papeis de aplicacao, que vive em
+-- `tests/postgres/bootstrap.sql` e no provisionamento real. Conceder a `nexus_app` aqui exigiria
+-- que o papel ja existisse. Por isso o GRANT e condicional: se o papel existir, ele recebe USAGE
+-- agora; se nao existir, o bootstrap da o mesmo GRANT (ver `tests/postgres/bootstrap.sql`).
+-- A REVOKE de PUBLIC vale nos dois casos — e o que garante que ninguem herde USAGE por padrao.
+REVOKE ALL ON TYPE nexus.tool_grant_status FROM PUBLIC;
+REVOKE ALL ON TYPE nexus.tool_grant_action FROM PUBLIC;
+GRANT USAGE ON TYPE nexus.tool_grant_status TO nexus_audit_writer;
+GRANT USAGE ON TYPE nexus.tool_grant_action TO nexus_audit_writer;
+
+DO $$
+BEGIN
+  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'nexus_app') THEN
+    EXECUTE 'GRANT USAGE ON TYPE nexus.tool_grant_status TO nexus_app';
+    EXECUTE 'GRANT USAGE ON TYPE nexus.tool_grant_action TO nexus_app';
+  END IF;
+END
+$$;
+
+COMMIT;
diff --git a/packages/database/tests/postgres/verify-stage-5-cascade-without-delete-policy.sql b/packages/database/tests/postgres/verify-stage-5-cascade-without-delete-policy.sql
new file mode 100644
index 0000000..a14e568
--- /dev/null
+++ b/packages/database/tests/postgres/verify-stage-5-cascade-without-delete-policy.sql
@@ -0,0 +1,260 @@
+\set ON_ERROR_STOP on
+-- Fase 5 (G13): prova de que a cascata `ON DELETE CASCADE` de `owner_identity` NAO depende da
+-- policy de DELETE de `tool_grants`.
+--
+-- =============================================================================================
+-- O QUE ESTE ARQUIVO PROVA
+-- =============================================================================================
+-- O comentario de `00007_tool_grants_and_preferences.sql` (secao 4) afirma:
+--
+--     "a policy de DELETE NAO e o que permite o `ON DELETE CASCADE` de `owner_identity`
+--      funcionar. Acoes de integridade referencial sao executadas como o dono da constraint e
+--      NAO passam pelo RLS como um DELETE da aplicacao."
+--
+-- Aqui a policy e removida de verdade, a exclusao do owner e executada, e a cascata e observada.
+-- A remocao acontece DENTRO de uma transacao que termina em ROLLBACK: a policy de producao nunca
+-- fica ausente. Nada de `ALTER TABLE ... DISABLE ROW LEVEL SECURITY`, nada de privilégio extra,
+-- nada de alteracao permanente.
+--
+-- Nao confundir os dois efeitos:
+--   * SEGURANCA: sem a policy, o DELETE da APLICACAO (`nexus_app`) afeta 0 linhas em silencio;
+--   * INTEGRIDADE: sem a policy, a cascata por integridade referencial continua funcionando.
+-- Este arquivo prova o segundo e comprova o primeiro na mesma transacao.
+--
+-- =============================================================================================
+-- PRE-CONDICAO: banco recem-criado
+-- =============================================================================================
+-- Contexto de owner/ator na SESSAO: sob FORCE RLS um runner NAO-superuser so enxerga as linhas
+-- pessoais com o contexto definido. Sem isso, as pre-condicoes de "tabela vazia" e a checagem
+-- pos-ROLLBACK do bloco §4 enxergam 0 linhas sempre — e a de §4 passaria/acusaria por engano.
+-- (Um runner SUPERUSER ve tudo de qualquer forma; definir o contexto nao atrapalha.)
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', false);
+SELECT set_config('nexus.actor_type', 'owner', false);
+
+DO $$
+BEGIN
+  IF current_database() <> 'nexus_test' THEN
+    RAISE EXCEPTION 'Expected isolated nexus_test database, got %', current_database();
+  END IF;
+  IF EXISTS (SELECT 1 FROM nexus.tool_grants) OR EXISTS (SELECT 1 FROM nexus.tool_grant_audit) THEN
+    RAISE EXCEPTION
+      'Cascade-without-policy verification requires a fresh database: Phase 5 tables are not empty.'
+      USING ERRCODE = '55000';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_policies
+                 WHERE schemaname = 'nexus' AND tablename = 'tool_grants'
+                   AND policyname = 'tool_grants_owner_delete') THEN
+    RAISE EXCEPTION 'Precondition failed: tool_grants_owner_delete is missing before the experiment';
+  END IF;
+END
+$$;
+
+BEGIN;
+
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+-- ---------------------------------------------------------------------------------------------
+-- 1. Prepara um owner e seus registros relacionados (grants, auditoria, preferencias).
+-- ---------------------------------------------------------------------------------------------
+DO $$
+BEGIN
+  INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+  VALUES
+    ('d0000000-0000-4000-8000-000000000001', nexus.current_owner_id(),
+     '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted',
+     nexus.current_owner_id(), now()),
+    ('d0000000-0000-4000-8000-000000000002', nexus.current_owner_id(),
+     '00000000-0000-4000-8000-000000000003', 'technical.code_analysis', 'granted',
+     nexus.current_owner_id(), now());
+
+  UPDATE nexus.tool_grants
+  SET status = 'revoked', revoked_by_owner_id = nexus.current_owner_id(), revoked_at = now()
+  WHERE id = 'd0000000-0000-4000-8000-000000000002';
+
+  INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, is_default)
+  VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000001', true);
+END
+$$;
+
+DO $$
+DECLARE
+  grants integer;
+  audit integer;
+  prefs integer;
+BEGIN
+  SELECT count(*) INTO grants FROM nexus.tool_grants;
+  SELECT count(*) INTO audit FROM nexus.tool_grant_audit;
+  SELECT count(*) INTO prefs FROM nexus.user_assistant_preferences;
+  IF grants <> 2 OR audit <> 3 OR prefs <> 1 THEN
+    RAISE EXCEPTION 'Seed failed: grants=% audit=% prefs=% (expected 2/3/1)', grants, audit, prefs;
+  END IF;
+END
+$$;
+
+-- As tres tabelas com trigger de tombstone sao esvaziadas pelo mesmo motivo do verificador de
+-- exclusao do owner: `tombstones_owner_id_fkey` impede a exclusao com dados presentes (defeito
+-- pre-existente de 00001, alheio a esta fase). A cascata das tabelas da Fase 5 e o objeto aqui.
+DELETE FROM nexus.messages;
+DELETE FROM nexus.conversations;
+DELETE FROM nexus.assistant_memories;
+
+-- ---------------------------------------------------------------------------------------------
+-- 2. Remove TEMPORARIAMENTE a policy de DELETE de `tool_grants` (dentro da transacao).
+-- ---------------------------------------------------------------------------------------------
+DROP POLICY tool_grants_owner_delete ON nexus.tool_grants;
+
+DO $$
+BEGIN
+  IF EXISTS (SELECT 1 FROM pg_policies
+             WHERE schemaname = 'nexus' AND tablename = 'tool_grants'
+               AND policyname = 'tool_grants_owner_delete') THEN
+    RAISE EXCEPTION 'Experiment setup failed: policy still present after DROP';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+                 WHERE n.nspname = 'nexus' AND c.relname = 'tool_grants'
+                   AND c.relrowsecurity AND c.relforcerowsecurity) THEN
+    RAISE EXCEPTION 'Experiment setup failed: RLS must remain ENABLED and FORCED';
+  END IF;
+END
+$$;
+
+-- ---------------------------------------------------------------------------------------------
+-- 3. A exclusao do owner sob o contexto de teste apropriado.
+--    Roda como o dono do banco (quem executaria uma remocao definitiva), exatamente como o
+--    verificador de exclusao. O ponto NAO e o privilegio do invocador: e que a cascata nao
+--    consulta policies.
+-- ---------------------------------------------------------------------------------------------
+DO $$
+DECLARE
+  grants integer;
+  audit integer;
+  prefs integer;
+  owners integer;
+BEGIN
+  DELETE FROM nexus.owner_identity WHERE id = '00000000-0000-4000-8000-000000000004';
+
+  SELECT count(*) INTO owners FROM nexus.owner_identity;
+  SELECT count(*) INTO grants FROM nexus.tool_grants;
+  SELECT count(*) INTO audit FROM nexus.tool_grant_audit;
+  SELECT count(*) INTO prefs FROM nexus.user_assistant_preferences;
+
+  IF owners <> 0 THEN
+    RAISE EXCEPTION 'Owner row was not removed (found %)', owners;
+  END IF;
+  -- A cascata referencial tem de ter funcionado SEM a policy de DELETE.
+  IF grants <> 0 THEN
+    RAISE EXCEPTION 'Cascade depended on the DELETE policy: % tool grant(s) survived', grants;
+  END IF;
+  IF audit <> 0 THEN
+    RAISE EXCEPTION 'Cascade depended on the DELETE policy: % audit row(s) survived', audit;
+  END IF;
+  IF prefs <> 0 THEN
+    RAISE EXCEPTION 'Cascade depended on the DELETE policy: % preference(s) survived', prefs;
+  END IF;
+
+  RAISE NOTICE 'Cascade works with the DELETE policy removed: grants/audit/prefs all 0';
+END
+$$;
+
+-- ---------------------------------------------------------------------------------------------
+-- 4. E o efeito de SEGURANCA da policy ausente: a aplicacao apaga 0 linhas em silencio.
+--    Precisa de outra transacao porque a anterior ja removeu o owner. Aqui so se verifica o
+--    comportamento do DELETE da aplicacao, sem owner para cascatear.
+-- ---------------------------------------------------------------------------------------------
+ROLLBACK;
+
+-- O ROLLBACK tem de ter devolvido owner, policy e dados.
+DO $$
+BEGIN
+  IF (SELECT count(*) FROM nexus.owner_identity) <> 1 THEN
+    RAISE EXCEPTION 'ROLLBACK failed: owner row was not restored';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_policies
+                 WHERE schemaname = 'nexus' AND tablename = 'tool_grants'
+                   AND policyname = 'tool_grants_owner_delete') THEN
+    RAISE EXCEPTION 'ROLLBACK failed: the DELETE policy was NOT restored';
+  END IF;
+  IF EXISTS (SELECT 1 FROM nexus.tool_grants)
+     OR EXISTS (SELECT 1 FROM nexus.tool_grant_audit)
+     OR EXISTS (SELECT 1 FROM nexus.user_assistant_preferences) THEN
+    RAISE EXCEPTION 'ROLLBACK failed: Phase 5 rows survived the rollback';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM nexus.messages)
+     OR NOT EXISTS (SELECT 1 FROM nexus.conversations)
+     OR NOT EXISTS (SELECT 1 FROM nexus.assistant_memories) THEN
+    RAISE EXCEPTION 'ROLLBACK failed: the tombstone-triggered tables were not restored';
+  END IF;
+END
+$$;
+
+-- ---------------------------------------------------------------------------------------------
+-- 5. Seguranca: sem a policy, o DELETE de `nexus_app` afeta 0 linhas e NAO levanta erro.
+--    Recriamos a linha como `postgres`, removemos a policy de novo (na transacao), e apagamos
+--    como `nexus_app`. Espera-se `DELETE 0`.
+-- ---------------------------------------------------------------------------------------------
+BEGIN;
+
+-- Contexto de owner: o trigger de auditoria le `nexus.current_owner_id()` e a policy de INSERT
+-- da trilha (nova) exige que owner/actor coincidam com esse contexto. Sem os GUCs o INSERT nao
+-- grava auditoria e falha em `new row violates row-level security policy`.
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+VALUES ('d0000000-0000-4000-8000-0000000000ff', '00000000-0000-4000-8000-000000000004',
+        '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted',
+        '00000000-0000-4000-8000-000000000004', now());
+
+DROP POLICY tool_grants_owner_delete ON nexus.tool_grants;
+
+-- A premissa correta NAO e "ser o superusuario postgres" — e "ser DONO da tabela", que e quem
+-- pode `DROP POLICY` e cuja escrita nao e barrada pela policy de INSERT. Exigir `postgres` por
+-- nome obrigava a um provisionamento com superusuario, que e exatamente o que o R36 elimina.
+DO $$
+DECLARE
+  tbl_owner text;
+BEGIN
+  SELECT pg_get_userbyid(relowner) INTO tbl_owner
+  FROM pg_class WHERE oid = 'nexus.tool_grants'::regclass;
+  IF tbl_owner <> current_user THEN
+    RAISE EXCEPTION 'This block must run as the owner of nexus.tool_grants (%), got %',
+      tbl_owner, current_user;
+  END IF;
+END
+$$;
+
+-- Muda para `nexus_app` e tenta apagar. Quem executa este arquivo precisa poder SET ROLE em
+-- `nexus_app`. O provisionador normalmente e o CRIADOR de `nexus_app` e, no PG 16+, o criador
+-- recebe membership automatica com `admin_option` mas `set_option = false` (config
+-- `createrole_self_grant` vazia). `admin_option` sozinho NAO permite `SET ROLE`; e preciso
+-- conceder SET explicitamente (`GRANT nexus_app TO <provisioner> WITH SET TRUE`).
+-- Ver `docs/` do R38 e o script de provisionamento.
+SET LOCAL ROLE nexus_app;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+DECLARE
+  affected integer;
+BEGIN
+  DELETE FROM nexus.tool_grants WHERE id = 'd0000000-0000-4000-8000-0000000000ff';
+  GET DIAGNOSTICS affected = ROW_COUNT;
+  IF affected <> 0 THEN
+    RAISE EXCEPTION 'Without the DELETE policy the application deleted % row(s); expected 0', affected;
+  END IF;
+  -- O esperado: sem policy de DELETE, o comando nao encontra linha alguma. ROW_COUNT = 0 E a
+  -- linha continua la. Se ela tivesse sumido, seria um DELETE que ignorou a policy.
+  IF NOT EXISTS (SELECT 1 FROM nexus.tool_grants WHERE id = 'd0000000-0000-4000-8000-0000000000ff') THEN
+    RAISE EXCEPTION 'Row disappeared even though ROW_COUNT was 0';
+  END IF;
+END
+$$;
+RESET ROLE;
+
+ROLLBACK;
+
+DO $$
+BEGIN
+  RAISE NOTICE 'Phase 5 (G13) cascade-without-DELETE-policy verification passed';
+END
+$$;
diff --git a/packages/database/tests/postgres/verify-stage-5-grants-lifecycle.sql b/packages/database/tests/postgres/verify-stage-5-grants-lifecycle.sql
new file mode 100644
index 0000000..6d79ec3
--- /dev/null
+++ b/packages/database/tests/postgres/verify-stage-5-grants-lifecycle.sql
@@ -0,0 +1,745 @@
+\set ON_ERROR_STOP on
+-- Fase 5 (G13): ciclo de vida de `tool_grants`, auditoria de eventos e ACL dos tipos.
+--
+-- =============================================================================================
+-- O QUE ESTE ARQUIVO PROVA
+-- =============================================================================================
+-- §A  INSERT so nasce `granted`; `revoked` e terminal e imutavel; escopo e proveniencia fixos.
+-- §B  A trilha registra EXATAMENTE um evento por transicao — nunca zero, nunca dois.
+-- §C  ACL: os enums de 00007 nao tem `USAGE` para PUBLIC; `nexus_app` e `nexus_audit_writer` tem.
+-- §D  O papel escritor da trilha e seguro: NOLOGIN, NOSUPERUSER, NOBYPASSRLS, e o dono da funcao.
+--
+-- Roda como `postgres` (dono do schema). Transacoes com ROLLBACK: nada persiste.
+-- =============================================================================================
+-- PRE-CONDICAO: banco recem-criado
+-- =============================================================================================
+DO $$
+BEGIN
+  IF current_database() <> 'nexus_test' THEN
+    RAISE EXCEPTION 'Expected isolated nexus_test database, got %', current_database();
+  END IF;
+  IF EXISTS (SELECT 1 FROM nexus.tool_grants) OR EXISTS (SELECT 1 FROM nexus.tool_grant_audit) THEN
+    RAISE EXCEPTION
+      'Lifecycle verification requires a fresh database: Phase 5 tables are not empty.'
+      USING ERRCODE = '55000';
+  END IF;
+END
+$$;
+
+-- =============================================================================================
+-- §A. Ciclo de vida (enforce_tool_grant_lifecycle)
+-- =============================================================================================
+BEGIN;
+
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+DO $$
+DECLARE
+  owner uuid := nexus.current_owner_id();
+  other_owner uuid := '99999999-0000-4000-8000-000000000001';
+  assistant_a uuid := '00000000-0000-4000-8000-000000000001';
+  assistant_b uuid := '00000000-0000-4000-8000-000000000003';
+  target_grant uuid := 'e0000000-0000-4000-8000-000000000001';
+  probe_id uuid := 'e0000000-0000-4000-8000-0000000000ff';
+  rejected boolean;
+  audit_events integer;
+BEGIN
+  -- (1) INSERT com status revogado: proibido. Nao existe historico que comece revogado.
+  rejected := false;
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id,
+                                   granted_at, revoked_by_owner_id, revoked_at)
+    VALUES (probe_id, owner, assistant_a, 'personal.tasks', 'revoked', owner,
+            now(), owner, now());
+    EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'INSERT with status=revoked was accepted';
+  END IF;
+
+  -- INSERT ativo ja nasce com um evento de auditoria.
+  INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+  VALUES (target_grant, owner, assistant_a, 'personal.tasks', 'granted', owner, now());
+
+  SELECT count(*) INTO audit_events FROM nexus.tool_grant_audit a WHERE a.grant_id = target_grant;
+  IF audit_events <> 1 THEN
+    RAISE EXCEPTION 'Grant insert must produce exactly 1 audit row, found %', audit_events;
+  END IF;
+
+  -- (1b) granted -> granted e REJEITADO, inclusive tocar apenas `updated_at`.
+  -- Um grant ativo nao e editavel: toda escrita ou e a concessao (INSERT) ou a revogacao.
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET updated_at = now() WHERE id = target_grant;
+    RAISE EXCEPTION 'granted -> granted touching only updated_at was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'granted -> granted touching only updated_at was accepted';
+  END IF;
+
+  -- Qualquer outro campo de uma linha ativa tambem e imutavel.
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET created_at = created_at - interval '1 hour' WHERE id = target_grant;
+    RAISE EXCEPTION 'granted -> granted touching created_at was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'granted -> granted touching created_at was accepted';
+  END IF;
+
+  -- E nenhuma dessas tentativas pode ter gerado evento: continua exatamente 1.
+  SELECT count(*) INTO audit_events FROM nexus.tool_grant_audit a WHERE a.grant_id = target_grant;
+  IF audit_events <> 1 THEN
+    RAISE EXCEPTION 'Rejected no-op updates produced audit rows, found %', audit_events;
+  END IF;
+
+  -- (1c) ISOLAMENTO DAS DUAS BARREIRAS. `granted -> granted` e barrado por DOIS lugares: o
+  -- trigger BEFORE de lifecycle (42501 "Active tool grant is immutable") e o trigger AFTER de
+  -- auditoria (42501 "update without status change"). Se um dos dois for removido por engano, o
+  -- outro ainda segura a escrita — o que e bom — mas o teste nao percebe qual sumiu. Aqui
+  -- verificamos a MENSAGEM, para garantir que a barreira primaria (lifecycle) esta ativa.
+  BEGIN
+    UPDATE nexus.tool_grants SET updated_at = now() WHERE id = target_grant;
+  EXCEPTION WHEN SQLSTATE '42501' THEN
+    IF position('immutable' in SQLERRM) = 0 THEN
+      RAISE EXCEPTION
+        'granted -> granted was rejected, but not by the lifecycle trigger (message: %)', SQLERRM;
+    END IF;
+  END;
+
+  -- (2) granted -> revoked: a unica transicao permitida, e ela audita.
+  UPDATE nexus.tool_grants
+  SET status = 'revoked', revoked_by_owner_id = owner, revoked_at = now()
+  WHERE id = target_grant;
+
+  SELECT count(*) INTO audit_events FROM nexus.tool_grant_audit a WHERE a.grant_id = target_grant;
+  IF audit_events <> 2 THEN
+    RAISE EXCEPTION 'Grant + revoke must produce exactly 2 audit rows, found %', audit_events;
+  END IF;
+  IF NOT EXISTS (
+    SELECT 1 FROM nexus.tool_grant_audit a
+    WHERE a.grant_id = target_grant AND a.action = 'revoked' AND a.actor_owner_id = owner
+  ) THEN
+    RAISE EXCEPTION 'Revocation audit row missing or wrong';
+  END IF;
+
+  -- (4) revoked -> granted: proibido.
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants
+    SET status = 'granted', revoked_by_owner_id = NULL, revoked_at = NULL
+    WHERE id = target_grant;
+    RAISE EXCEPTION 'revoked -> granted was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'revoked -> granted was accepted';
+  END IF;
+
+  -- (5a) revoked -> revoked alterando revoked_at: proibido.
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET revoked_at = now() + interval '1 hour' WHERE id = target_grant;
+    RAISE EXCEPTION 'revoked -> revoked with new revoked_at was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'revoked -> revoked with new revoked_at was accepted';
+  END IF;
+
+  -- (5b) revoked -> revoked alterando revoked_by_owner_id: proibido.
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET revoked_by_owner_id = other_owner WHERE id = target_grant;
+    RAISE EXCEPTION 'revoked -> revoked with new revoked_by_owner_id was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'revoked -> revoked with new revoked_by_owner_id was accepted';
+  END IF;
+
+  -- (5c) qualquer outro campo apos revogacao: proibido.
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET updated_at = now() WHERE id = target_grant;
+    RAISE EXCEPTION 'Field update after revocation was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'Field update after revocation was accepted';
+  END IF;
+
+  -- (6) escopo imutavel: owner_id, assistant_id e tool_id.
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET owner_id = other_owner WHERE id = target_grant;
+    RAISE EXCEPTION 'owner_id mutation was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'owner_id mutation was accepted';
+  END IF;
+
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET assistant_id = assistant_b WHERE id = target_grant;
+    RAISE EXCEPTION 'assistant_id mutation was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'assistant_id mutation was accepted';
+  END IF;
+
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET tool_id = 'personal.organize' WHERE id = target_grant;
+    RAISE EXCEPTION 'tool_id mutation was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'tool_id mutation was accepted';
+  END IF;
+
+  -- (7) proveniencia imutavel: granted_by / granted_at nao podem ser reescritos.
+  -- Usa uma linha NOVA (a anterior ja esta revogada e seria barrada antes pelo teste (5c)).
+  INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+  VALUES (probe_id, owner, assistant_b, 'technical.code_analysis', 'granted', owner, now() - interval '2 days');
+
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET granted_at = now() WHERE id = probe_id;
+    RAISE EXCEPTION 'granted_at mutation was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'granted_at mutation was accepted';
+  END IF;
+
+  rejected := false;
+  BEGIN
+    UPDATE nexus.tool_grants SET granted_by_owner_id = other_owner WHERE id = probe_id;
+    RAISE EXCEPTION 'granted_by_owner_id mutation was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'granted_by_owner_id mutation was accepted';
+  END IF;
+
+  -- Nenhuma das tentativas acima pode ter gerado evento.
+  SELECT count(*) INTO audit_events FROM nexus.tool_grant_audit;
+  IF audit_events <> 3 THEN
+    RAISE EXCEPTION 'Rejected mutations produced audit rows: found % events, expected 3', audit_events;
+  END IF;
+
+  RAISE NOTICE 'Lifecycle: 1 grant + 1 revoke audited, 11 mutations rejected';
+END
+$$;
+
+-- Verifica no catalogo que a trilha continua sem policy de UPDATE/DELETE.
+DO $$
+DECLARE
+  forbidden integer;
+BEGIN
+  SELECT count(*) INTO forbidden FROM pg_policies
+  WHERE schemaname = 'nexus' AND tablename = 'tool_grant_audit' AND cmd IN ('UPDATE', 'DELETE');
+  IF forbidden <> 0 THEN
+    RAISE EXCEPTION 'Audit trail must not have UPDATE/DELETE policies, found %', forbidden;
+  END IF;
+END
+$$;
+
+ROLLBACK;
+
+-- =============================================================================================
+-- §C. ACL dos enums
+-- =============================================================================================
+DO $$
+DECLARE
+  t record;
+  public_usage integer;
+  app_usage integer;
+  writer_usage integer;
+BEGIN
+  FOR t IN
+    SELECT typname, oid FROM pg_type
+    WHERE typnamespace = 'nexus'::regnamespace AND typname IN ('tool_grant_status', 'tool_grant_action')
+  LOOP
+    -- `typacl` NULL significa "default do tipo": PUBLIC=USAGE. Depois do REVOKE, a ACL e explicita.
+    IF (SELECT typacl FROM pg_type WHERE oid = t.oid) IS NULL THEN
+      RAISE EXCEPTION 'Type % still has NULL acl (default PUBLIC=USAGE)', t.typname;
+    END IF;
+
+    SELECT count(*) INTO public_usage
+    FROM aclexplode((SELECT typacl FROM pg_type WHERE oid = t.oid)) a
+    WHERE a.grantee = 0 AND a.privilege_type = 'USAGE';
+
+    SELECT count(*) INTO app_usage
+    FROM aclexplode((SELECT typacl FROM pg_type WHERE oid = t.oid)) a
+    JOIN pg_roles r ON r.oid = a.grantee
+    WHERE r.rolname = 'nexus_app' AND a.privilege_type = 'USAGE';
+
+    SELECT count(*) INTO writer_usage
+    FROM aclexplode((SELECT typacl FROM pg_type WHERE oid = t.oid)) a
+    JOIN pg_roles r ON r.oid = a.grantee
+    WHERE r.rolname = 'nexus_audit_writer' AND a.privilege_type = 'USAGE';
+
+    IF public_usage <> 0 THEN
+      RAISE EXCEPTION 'Type % still grants USAGE to PUBLIC', t.typname;
+    END IF;
+    IF app_usage <> 1 THEN
+      RAISE EXCEPTION 'Type % must grant USAGE to nexus_app', t.typname;
+    END IF;
+    IF writer_usage <> 1 THEN
+      RAISE EXCEPTION 'Type % must grant USAGE to nexus_audit_writer', t.typname;
+    END IF;
+  END LOOP;
+
+  RAISE NOTICE 'Enum ACL: PUBLIC revoked; nexus_app + nexus_audit_writer have USAGE';
+END
+$$;
+
+-- Nenhum papel INESPERADO recebe privilegio nos dois tipos.
+--
+-- `os DETENTORES DA PROPRIEDADE` sao aceitos por construcao: em PostgreSQL o dono de um objeto
+-- tem todos os privilegios sobre ele, independentemente de ACL. Quando o provisionador aplica as
+-- migrations como dono do schema (`nexus_migrator`), ele se torna dono destes tipos e aparece na
+-- ACL com `=U/`. Isso NAO e vazamento e NAO pode ser revogado — tentar `REVOKE` do dono e no-op.
+-- A versao anterior desta verificacao listava apenas `postgres` como dono aceito e por isso
+-- acusava falso positivo em qualquer provisionamento real que nao fosse o superusuario.
+--
+-- O que a verificacao DEVE garantir e: (a) PUBLIC nao tem USAGE; (b) ninguem alem do dono e dos
+-- dois papeis funcionais (`nexus_app`, `nexus_audit_writer`) aparece na ACL.
+DO $$
+DECLARE
+  offender text;
+BEGIN
+  SELECT string_agg(DISTINCT coalesce(r.rolname, 'PUBLIC') || ':' || a.privilege_type, ', ')
+    INTO offender
+  FROM pg_type t
+  CROSS JOIN LATERAL aclexplode(t.typacl) a
+  LEFT JOIN pg_roles r ON r.oid = a.grantee
+  WHERE t.typnamespace = 'nexus'::regnamespace
+    AND t.typname IN ('tool_grant_status', 'tool_grant_action')
+    AND coalesce(r.rolname, 'PUBLIC') NOT IN ('nexus_app', 'nexus_audit_writer')
+    -- isenta o(s) dono(s) do proprio tipo, seja qual for o papel de provisionamento
+    AND a.grantee <> t.typowner;
+  IF offender IS NOT NULL THEN
+    RAISE EXCEPTION 'Unexpected privilege on Phase 5 enums: %', offender;
+  END IF;
+
+  -- PUBLIC nao e coberto pelo predicado acima (grants a PUBLIC tem grantee = 0 e nao aparecem em
+  -- pg_roles). Ele ja e verificado de forma exaustiva em §C1.2 (linhas ~278-291), que percorre
+  -- aclexplode e falha com "Type ... still grants USAGE to PUBLIC". Nao duplicamos aqui.
+END
+$$;
+
+-- =============================================================================================
+-- §D1. Papel escritor da trilha e SECURITY DEFINER
+-- =============================================================================================
+DO $$
+DECLARE
+  r record;
+  fn record;
+BEGIN
+  SELECT rolname, rolcanlogin, rolsuper, rolbypassrls, rolcreatedb, rolcreaterole
+    INTO r FROM pg_roles WHERE rolname = 'nexus_audit_writer';
+  IF r IS NULL THEN
+    RAISE EXCEPTION 'Role nexus_audit_writer does not exist';
+  END IF;
+  IF r.rolcanlogin THEN RAISE EXCEPTION 'nexus_audit_writer must not be able to log in'; END IF;
+  IF r.rolsuper THEN RAISE EXCEPTION 'nexus_audit_writer must not be SUPERUSER'; END IF;
+  IF r.rolbypassrls THEN RAISE EXCEPTION 'nexus_audit_writer must not have BYPASSRLS'; END IF;
+  IF r.rolcreatedb OR r.rolcreaterole THEN
+    RAISE EXCEPTION 'nexus_audit_writer must not create databases or roles';
+  END IF;
+
+  SELECT p.proname, p.prosecdef, p.proconfig,
+         pg_get_userbyid(p.proowner) AS fn_owner,
+         p.proacl
+    INTO fn FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
+   WHERE n.nspname = 'nexus' AND p.proname = 'audit_tool_grant_change';
+  IF fn IS NULL THEN
+    RAISE EXCEPTION 'audit_tool_grant_change() is missing';
+  END IF;
+  IF NOT fn.prosecdef THEN
+    RAISE EXCEPTION 'audit_tool_grant_change() must be SECURITY DEFINER';
+  END IF;
+  IF fn.proconfig IS DISTINCT FROM ARRAY['search_path=pg_catalog'] THEN
+    RAISE EXCEPTION 'audit_tool_grant_change() must pin search_path=pg_catalog, found %', fn.proconfig;
+  END IF;
+  IF fn.fn_owner IS DISTINCT FROM 'nexus_audit_writer' THEN
+    RAISE EXCEPTION 'audit_tool_grant_change() must be owned by nexus_audit_writer, found %', fn.fn_owner;
+  END IF;
+
+  -- Sem EXECUTE para PUBLIC nem para nexus_app: a funcao so roda como trigger.
+  IF EXISTS (
+    SELECT 1 FROM aclexplode(fn.proacl) a
+    WHERE a.privilege_type = 'EXECUTE'
+      AND (a.grantee = 0
+           OR a.grantee = (SELECT oid FROM pg_roles WHERE rolname = 'nexus_app'))
+  ) THEN
+    RAISE EXCEPTION 'audit_tool_grant_change() is executable by PUBLIC or nexus_app';
+  END IF;
+
+  -- A policy de INSERT da trilha e escopada ao papel escritor.
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_policies
+    WHERE schemaname = 'nexus' AND tablename = 'tool_grant_audit'
+      AND policyname = 'tool_grant_audit_writer_insert' AND cmd = 'INSERT'
+      AND roles = ARRAY['nexus_audit_writer']::name[]
+  ) THEN
+    RAISE EXCEPTION 'tool_grant_audit_writer_insert must exist and be scoped to nexus_audit_writer';
+  END IF;
+
+  RAISE NOTICE 'Audit writer role is least-privilege and the definer function is correctly constrained';
+END
+$$;
+
+-- =============================================================================================
+-- §C2. Policy de INSERT da trilha: restrita ao escritor E coerente com o contexto
+-- =============================================================================================
+-- A policy deixou de ser `WITH CHECK (true)`. Ela exige que a linha gravada tenha
+-- `owner_id = current_owner_id() = configured_owner_id()` e `actor_owner_id = owner_id`.
+-- Provamos os quatro casos exigidos pela revisao.
+BEGIN;
+
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+DO $$
+DECLARE
+  owner uuid := nexus.current_owner_id();
+  other uuid := '99999999-0000-4000-8000-000000000001';
+  c2_grant uuid := 'e0000000-0000-4000-8000-0000000000c2';
+BEGIN
+  -- 1. Insercao VALIDA pelo trigger (caminho normal da aplicacao).
+  INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+  VALUES (c2_grant, owner, '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted', owner, now());
+
+  IF (SELECT count(*) FROM nexus.tool_grant_audit a WHERE a.grant_id = c2_grant) <> 1 THEN
+    RAISE EXCEPTION 'Valid grant produced no audit row';
+  END IF;
+  RAISE NOTICE 'C2.1) insercao valida pelo trigger: 1 evento';
+END
+$$;
+
+-- 2/3. Dono ou actor divergentes: a policy recusa. O teste troca os GUCs para um contexto de
+-- owner diferente e tenta inserir direto na trilha (sem passar pelo trigger de grants).
+DO $$
+DECLARE
+  rejected boolean;
+  owner uuid := nexus.current_owner_id();
+  other uuid := '99999999-0000-4000-8000-000000000001';
+BEGIN
+  -- CONTEXTO: a FK `tool_grant_audit_owner_id_fkey` roda ANTES da RLS (acoes de integridade nao
+  -- passam pelo RLS). Portanto testar com um `owner_id` INEXISTENTE nao prova nada sobre a
+  -- policy: quem recusa e a FK. E `owner_identity` e singleton, entao nao existe "segundo owner
+  -- real" para usar. A forma de isolar a policy e assumir o papel escritor e variar apenas o
+  -- contexto do GUC: a FK satisfaz (o owner existe) e so a policy pode recusar.
+  SET LOCAL ROLE nexus_audit_writer;
+
+  -- 2. Owner da LINHA diferente do contexto da transacao: o GUC aponta para um uuid que nao e o
+  -- do owner real, a linha usa o owner real. FK satisfaz; a policy recusa.
+  PERFORM set_config('nexus.owner_id', other::text, true);
+  rejected := false;
+  BEGIN
+    INSERT INTO nexus.tool_grant_audit (owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id)
+    VALUES (owner, 'e0000000-0000-4000-8000-0000000000c3',
+            '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted', owner);
+    RAISE EXCEPTION 'Audit row with owner_id outside the transaction context was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'Audit row with owner_id outside the transaction context was accepted';
+  END IF;
+
+  -- 3. Actor divergente: contexto restaurado, owner da linha correto, mas `actor_owner_id`
+  -- diferente do owner. A policy recusa; o CHECK `actor_owner_id = owner_id` e a segunda
+  -- barreira.
+  PERFORM set_config('nexus.owner_id', owner::text, true);
+  rejected := false;
+  BEGIN
+    INSERT INTO nexus.tool_grant_audit (owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id)
+    VALUES (owner, 'e0000000-0000-4000-8000-0000000000c4',
+            '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted', other);
+    RAISE EXCEPTION 'Audit row with divergent actor was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' OR check_violation THEN rejected := true;
+  END;
+  IF NOT rejected THEN RAISE EXCEPTION 'Audit row with divergent actor was accepted'; END IF;
+
+  -- 4. Controle POSITIVO: com o contexto de volta ao owner correto, o MESMO papel consegue
+  -- inserir. Sem isso os dois testes acima passariam por qualquer motivo (inclusive falta de
+  -- privilegio), e nao por causa da policy.
+  INSERT INTO nexus.tool_grant_audit (owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id)
+  VALUES (owner, 'e0000000-0000-4000-8000-0000000000c6',
+          '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted', owner);
+  RAISE NOTICE 'C2.control) mesma linha, contexto correto: aceita (prova que a recusa e da policy)';
+
+  -- 3b. CONTEXTO AUSENTE: nenhum GUC definido. `current_owner_id()` devolve NULL e a comparacao
+  -- `owner_id = NULL` resulta NULL; `WITH CHECK` so aceita TRUE, entao o INSERT e recusado.
+  -- (Roda AINDA como nexus_audit_writer: depois do RESET ROLE quem executaria seria o dono, que
+  -- nao passa por RLS sem policy — ver C2.4c.)
+  PERFORM set_config('nexus.owner_id', '', true);
+  rejected := false;
+  BEGIN
+    INSERT INTO nexus.tool_grant_audit (owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id)
+    VALUES (owner, 'e0000000-0000-4000-8000-0000000000c7',
+            '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted', owner);
+    RAISE EXCEPTION 'Audit insert without owner context was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN rejected := true;
+  END;
+  IF NOT rejected THEN RAISE EXCEPTION 'Audit insert without owner context was accepted'; END IF;
+
+  -- Restaura o contexto para o controle positivo abaixo.
+  PERFORM set_config('nexus.owner_id', owner::text, true);
+
+  RAISE NOTICE 'C2.2/C2.3/C2.3b) owner divergente, actor divergente e contexto ausente: recusados pela policy';
+
+  RESET ROLE;
+END
+$$;
+
+-- 4c. LIMITE CONHECIDO E EXPLICITO: FORCE ROW LEVEL SECURITY NAO protege contra o dono da tabela
+-- e, com mais razao, contra SUPERUSER/BYPASSRLS. Um superusuario consegue inserir na trilha sem
+-- nenhuma policy de INSERT e sem contexto. Isso NAO e um defeito da policy: e o modelo do
+-- PostgreSQL (documentado em R28). Registramos aqui para que ninguem leia "FORCE RLS" como
+-- "a trilha e imutavel ate para o DBA".
+-- Este bloco so pode ser executado por um SUPERUSER. Ele roda CONDICIONALMENTE: em instalacao
+-- real o runner normalmente NAO e superusuario (ver R36), e nesse caso o limite e registrado sem
+-- ser reexecutado. A prova positiva do limite continua valendo quando o runner e superusuario
+-- (o harness de CI e o `run_pg17.sh`), e nao ha falso negativo: se o runner for superusuario e o
+-- INSERT falhar, isso significa que o modelo do PostgreSQL mudou e o teste quebra de proposito.
+DO $$
+DECLARE
+  inserted boolean := false;
+  is_super boolean;
+BEGIN
+  SELECT rolsuper INTO is_super FROM pg_roles WHERE rolname = current_user;
+  IF NOT coalesce(is_super, false) THEN
+    RAISE NOTICE 'C2.4c) LIMITE DOCUMENTADO: runner nao e superusuario; prova de bypass nao executavel aqui (esperado em instalacao real)';
+    RETURN;
+  END IF;
+
+  BEGIN
+    INSERT INTO nexus.tool_grant_audit (owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id)
+    VALUES ('00000000-0000-4000-8000-000000000004','e0000000-0000-4000-8000-0000000000c8',
+            '00000000-0000-4000-8000-000000000001','personal.tasks','granted',
+            '00000000-0000-4000-8000-000000000004');
+    inserted := true;
+  EXCEPTION WHEN insufficient_privilege OR SQLSTATE '42501' THEN NULL;
+  END;
+  IF NOT inserted THEN
+    RAISE EXCEPTION 'Unexpected: a superuser could NOT bypass RLS. The documented limitation changed.';
+  END IF;
+  RAISE NOTICE 'C2.4c) LIMITE DOCUMENTADO: SUPERUSER ignora RLS e pode forjar a trilha';
+END
+$$;
+
+ROLLBACK;
+
+-- 4. Tentativa direta por `nexus_app`: o papel nao tem privilegio de INSERT (barreira 1) e nao
+-- tem policy de INSERT (barreira 2). Rejeitado antes de qualquer RLS.
+DO $$
+DECLARE
+  rejected boolean := false;
+  msg text;
+BEGIN
+  BEGIN
+    SET LOCAL ROLE nexus_app;
+    INSERT INTO nexus.tool_grant_audit (owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id)
+    VALUES ('00000000-0000-4000-8000-000000000004', 'e0000000-0000-4000-8000-0000000000c5',
+            '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted',
+            '00000000-0000-4000-8000-000000000004');
+  EXCEPTION WHEN insufficient_privilege THEN rejected := true; msg := SQLERRM;
+  END;
+  RESET ROLE;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'nexus_app wrote the audit trail';
+  END IF;
+  RAISE NOTICE 'C2.4) nexus_app barrado: %', msg;
+END
+$$;
+
+-- 4b. DISCRIMINACAO DA CAUSA: as recusas acima tem que vir da POLICY, nao de FK nem de falta de
+-- privilegio. Provamos isso por eliminacao, restaurando a policy e comparando o erro.
+DO $$
+DECLARE
+  owner uuid;
+  other uuid := '99999999-0000-4000-8000-000000000001';
+  msg_fk text;
+  rejected boolean;
+BEGIN
+  SELECT id INTO owner FROM nexus.owner_identity WHERE singleton;
+
+  -- (a) A FK existe e esta ativa. Tentar gravar para um owner INEXISTENTE tem que falhar — mas
+  -- QUAL barreira dispara primeiro depende do papel do runner:
+  --   * runner SUPERUSER: a RLS e ignorada (ver C2.4c) e quem barra e a FK -> 23503;
+  --   * runner NAO-superuser sem policy de INSERT para ele: a RLS barra antes -> 42501.
+  -- Aceitar as duas e o correto. Exigir 23503 sempre seria exigir um runner superusuario, que e
+  -- exatamente o que a instalacao real NAO tem (R36).
+  rejected := false;
+  BEGIN
+    INSERT INTO nexus.tool_grant_audit (owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id)
+    VALUES (other, 'e0000000-0000-4000-8000-0000000000d1',
+            '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted', other);
+    RAISE EXCEPTION 'A non-existent owner was accepted on the audit trail';
+  EXCEPTION
+    WHEN foreign_key_violation THEN msg_fk := '23503 (FK)';
+    WHEN SQLSTATE '42501' THEN msg_fk := '42501 (RLS)';
+  END;
+  IF msg_fk IS NULL THEN RAISE EXCEPTION 'A non-existent owner was accepted on the audit trail'; END IF;
+
+  -- (b) Privilegio: `nexus_app` nao tem INSERT na tabela. Isso e uma barreira ANTERIOR e
+  -- DIFERENTE da RLS — o teste C2.4 comprova que ela dispara antes.
+  IF has_table_privilege('nexus_app','nexus.tool_grant_audit','INSERT') THEN
+    RAISE EXCEPTION 'nexus_app unexpectedly holds INSERT on the audit trail';
+  END IF;
+
+  -- (c) RLS: o escritor TEM INSERT (privilegio garantido) e a FK satisfaz (owner real); logo a
+  -- recusa so pode ser a policy.
+  IF NOT has_table_privilege('nexus_audit_writer','nexus.tool_grant_audit','INSERT') THEN
+    RAISE EXCEPTION 'nexus_audit_writer lacks INSERT: the RLS tests would be meaningless';
+  END IF;
+  IF NOT (SELECT relrowsecurity AND relforcerowsecurity FROM pg_class WHERE oid='nexus.tool_grant_audit'::regclass) THEN
+    RAISE EXCEPTION 'FORCE ROW LEVEL SECURITY is not enabled on the audit trail';
+  END IF;
+  IF NOT EXISTS (
+       SELECT 1 FROM pg_policy p JOIN pg_class c ON c.oid = p.polrelid
+       WHERE c.oid = 'nexus.tool_grant_audit'::regclass AND p.polname = 'tool_grant_audit_writer_insert'
+         AND p.polcmd = 'a'
+         AND pg_get_expr(p.polwithcheck, p.polrelid) <> 'true'
+     ) THEN
+    RAISE EXCEPTION 'tool_grant_audit_writer_insert missing or still WITH CHECK (true)';
+  END IF;
+
+  RAISE NOTICE 'C2.4b) recusa vem da RLS: barreira efetiva foi % (FK e privilegio descartados)', msg_fk;
+END
+$$;
+
+-- 5. Ausencia de privilegios de UPDATE e DELETE para nexus_app e para o escritor.
+DO $$
+DECLARE
+  privs text;
+BEGIN
+  SELECT string_agg(DISTINCT privilege_type, ', ') INTO privs
+  FROM information_schema.role_table_grants
+  WHERE table_schema='nexus' AND table_name='tool_grant_audit'
+    AND grantee IN ('nexus_app','nexus_audit_writer')
+    AND privilege_type IN ('UPDATE','DELETE','TRUNCATE');
+  IF privs IS NOT NULL THEN
+    RAISE EXCEPTION 'Unexpected write privilege on the audit trail: %', privs;
+  END IF;
+  RAISE NOTICE 'C2.5) sem UPDATE/DELETE/TRUNCATE na trilha';
+END
+$$;
+
+-- =============================================================================================
+-- §D2. Memberships de nexus_audit_writer
+-- =============================================================================================
+DO $$
+DECLARE
+  offender text;
+BEGIN
+  -- Nao pode ser membro de NENHUM outro papel (nem pg_read_all_data, nem nexus_app...).
+  SELECT string_agg(parent.rolname, ', ') INTO offender
+  FROM pg_auth_members am
+  JOIN pg_roles child ON child.oid = am.member
+  JOIN pg_roles parent ON parent.oid = am.roleid
+  WHERE child.rolname = 'nexus_audit_writer';
+  IF offender IS NOT NULL THEN
+    RAISE EXCEPTION 'nexus_audit_writer inherits privileges from: %', offender;
+  END IF;
+
+  -- Quem pode ser MEMBRO de nexus_audit_writer?
+  --
+  -- Duas categorias sao LEGITIMAS e nao configuram escalada:
+  --   (a) o PROPRIO PROVISIONADOR. `ALTER FUNCTION ... OWNER TO nexus_audit_writer` exige que o
+  --       executante possa SET ROLE no novo dono (verificado em PG 17.11: sem isso o erro e
+  --       `must be able to SET ROLE "nexus_audit_writer"`). O provisionador precisa dessa
+  --       membresia com set_option=true. Ela NAO da a ele acesso a nada que ele ja nao tenha:
+  --       quem aplica migrations e dono do schema e pode criar/alterar tudo.
+  --   (b) SUPERUSER/BYPASSRLS de bootstrap — fora da fronteira do RLS de qualquer forma.
+  --
+  -- `nexus_app` e QUALQUER OUTRO papel NAO podem. Isso e verificado abaixo, de forma explicita.
+  SELECT string_agg(DISTINCT member.rolname, ', ') INTO offender
+  FROM pg_auth_members am
+  JOIN pg_roles member ON member.oid = am.member
+  JOIN pg_roles parent ON parent.oid = am.roleid
+  WHERE parent.rolname = 'nexus_audit_writer'
+    AND member.rolname <> 'postgres'
+    AND member.rolname <> current_user
+    AND NOT member.rolsuper;
+  IF offender IS NOT NULL THEN
+    RAISE EXCEPTION 'Unexpected member(s) of nexus_audit_writer: %', offender;
+  END IF;
+
+  -- O provisionador (`current_user`) pode ser membro. A membresia que o habilita a fazer o
+  -- `ALTER FUNCTION ... OWNER TO` e a de `set_option = true`; ela e suficiente e nao permite
+  -- delegar o papel a terceiros.
+  --
+  -- A membresia com `admin_option = true` tambem existe, e sua origem e o proprio `CREATE ROLE`
+  -- do PostgreSQL 16+: ao criar um papel, o criador recebe automaticamente membership com
+  -- `admin_option = true`, `set_option = false` e `grantor` = quem executou o CREATE ROLE. Nao e
+  -- algo que esteja sob controle do schema, e NAO e escalada pratica: o unico exercicio possivel
+  -- e o proprio provisionador conceder `nexus_audit_writer` a alguem — e ele ja e dono do schema,
+  -- ou seja, ja pode criar qualquer objeto e ler qualquer tabela. O que importa para a seguranca
+  -- e que `nexus_app` NUNCA esteja nessa lista, o que e verificado abaixo e em §E.
+  --
+  -- Registramos a situacao em vez de falhar, para que um endurecimento futuro (criar o papel com
+  -- um papel dedicado que nao seja o de migrations) seja uma decisao consciente e visivel.
+  IF EXISTS (
+       SELECT 1 FROM pg_auth_members am
+       JOIN pg_roles member ON member.oid = am.member
+       JOIN pg_roles parent ON parent.oid = am.roleid
+       WHERE parent.rolname = 'nexus_audit_writer'
+         AND member.rolname = current_user
+         AND am.admin_option
+     ) THEN
+    RAISE NOTICE 'D2 nota: o provisionador tem ADMIN OPTION (membership automatica do CREATE ROLE); nao e escalada porque ele ja e dono do schema';
+  END IF;
+
+  -- E as funcoes de checagem confirmam a ausencia de escalada.
+  IF pg_has_role('nexus_app', 'nexus_audit_writer', 'MEMBER') THEN
+    RAISE EXCEPTION 'nexus_app can assume nexus_audit_writer';
+  END IF;
+  IF pg_has_role('nexus_audit_writer', 'nexus_app', 'MEMBER') THEN
+    RAISE EXCEPTION 'nexus_audit_writer inherits nexus_app';
+  END IF;
+  IF pg_has_role('nexus_audit_writer', 'pg_read_all_data', 'MEMBER') THEN
+    RAISE EXCEPTION 'nexus_audit_writer is a member of pg_read_all_data';
+  END IF;
+
+  RAISE NOTICE 'D2) nexus_audit_writer sem membros inesperados (so o provisionador, por necessidade) e inassumivel por nexus_app';
+END
+$$;
+
+-- =============================================================================================
+-- §E. A aplicacao NAO escreve a trilha nem usa os enums sem permissao indevida
+-- =============================================================================================
+DO $$
+DECLARE
+  privs text;
+BEGIN
+  SELECT string_agg(privilege_type, ', ' ORDER BY privilege_type) INTO privs
+  FROM information_schema.role_table_grants
+  WHERE grantee = 'nexus_app' AND table_schema = 'nexus' AND table_name = 'tool_grant_audit';
+  IF privs IS DISTINCT FROM 'SELECT' THEN
+    RAISE EXCEPTION 'nexus_app must have exactly SELECT on the audit trail, found %', coalesce(privs, '<none>');
+  END IF;
+
+  IF has_function_privilege('nexus_app', 'nexus.audit_tool_grant_change()', 'EXECUTE') THEN
+    RAISE EXCEPTION 'nexus_app can execute the audit definer function';
+  END IF;
+
+  RAISE NOTICE 'nexus_app keeps SELECT-only on the audit trail and cannot execute the definer';
+END
+$$;
+
+DO $$
+BEGIN
+  RAISE NOTICE 'Phase 5 (G13) lifecycle, audit and ACL verification passed';
+END
+$$;
diff --git a/packages/database/tests/postgres/verify-stage-5-owner-deletion.sql b/packages/database/tests/postgres/verify-stage-5-owner-deletion.sql
new file mode 100644
index 0000000..78264f0
--- /dev/null
+++ b/packages/database/tests/postgres/verify-stage-5-owner-deletion.sql
@@ -0,0 +1,657 @@
+\set ON_ERROR_STOP on
+-- Fase 5 (G13): comportamento da EXCLUSAO DEFINITIVA DO OWNER sobre `tool_grants`,
+-- `tool_grant_audit` e `user_assistant_preferences`, mais a auditoria append-only.
+--
+-- =============================================================================================
+-- POR QUE ESTE ARQUIVO E SEPARADO DE `verify-stage-5-rls.sql`
+-- =============================================================================================
+-- `verify-stage-5-rls.sql` roda como `nexus_app` e prova o que a APLICACAO pode e nao pode fazer.
+-- A remocao da linha de `owner_identity` nao esta nesse conjunto: `nexus_app` tem apenas SELECT
+-- nessa tabela. Portanto a exclusao do owner nao pode ser exercitada de dentro do teste de RLS —
+-- e essa impossibilidade ja e uma garantia de projeto: a destruicao integral da instalacao nao e
+-- alcancavel pela credencial da aplicacao.
+--
+-- Este arquivo roda como o proprietario do banco (`postgres`), que e quem executaria uma remocao
+-- definitiva.
+--
+-- =============================================================================================
+-- O QUE ESTE ARQUIVO PROVA — E O QUE ELE DELIBERADAMENTE NAO PROVA
+-- =============================================================================================
+-- PROVA:
+--   §1 excluir UM GRANT preserva os eventos de auditoria dele (append-only na vida da instalacao);
+--   §2 o trigger BEFORE DELETE de `messages` anula `assistant_memories.source_message_id` antes
+--      de a linha sumir, e o ROLLBACK devolve a referencia;
+--   §3 com DADOS PRESENTES, excluir o owner HOJE FALHA: SQLSTATE 23503 na constraint
+--      `tombstones_owner_id_fkey`. O defeito fica registrado, isolado e testado (ver abaixo);
+--   §4 depois de esvaziar as tres tabelas com trigger de tombstone, a cascata de `owner_id`
+--      leva `tool_grants`, `tool_grant_audit` e `user_assistant_preferences` a zero;
+--   §5 o ROLLBACK restaura integralmente owner, grants, auditoria, preferencias, tombstones,
+--      mensagens, conversas e memorias — comparando CONTEUDO, nao apenas contagem.
+--
+-- NAO PROVA, E NAO PODE PROVAR ENQUANTO O DEFEITO EXISTIR:
+--   que excluir o owner funciona com dados reais presentes. Nao funciona (e o que §3 demonstra).
+--
+-- =============================================================================================
+-- A LIMITACAO PRE-EXISTENTE (de 00001, fora do escopo desta fase)
+-- =============================================================================================
+-- `nexus.record_deleted_entity()` e SECURITY DEFINER e faz:
+--     INSERT INTO nexus.tombstones (id, owner_id, entity_type, entity_id)
+--     VALUES (OLD.id, OLD.owner_id, deleted_type, OLD.id) ON CONFLICT DO NOTHING;
+-- Ele e disparado por AFTER DELETE em `messages`, `conversations` e `assistant_memories`.
+--
+-- Quando o owner e excluido, as FKs `*_owner_id_fkey` dessas tabelas cascateiam e cada linha
+-- apagada dispara o trigger. O trigger insere um tombstone com `OLD.owner_id` — um owner que,
+-- naquele instante, ja nao existe mais. `tombstones_owner_id_fkey` rejeita:
+--     ERROR: insert or update on table "tombstones" violates foreign key constraint
+--            "tombstones_owner_id_fkey"   (SQLSTATE 23503)
+--
+-- Consequencia: excluir o owner SO funciona quando nao sobra nenhuma linha nas tres tabelas.
+-- §4 esvazia as tres de proposito. Isso e um CONTORNO da limitacao, nao uma demonstracao de
+-- que a exclusao do owner funciona com dados reais — §3 e que documenta a falha.
+--
+-- Tudo acontece em transacoes com ROLLBACK e em subtransacoes com EXCEPTION: o banco nao e
+-- alterado ao final.
+--
+-- =============================================================================================
+-- PRE-CONDICAO: banco recem-criado (uma execucao por banco)
+-- =============================================================================================
+-- O verificador precisa ENXERGAR as linhas semeadas. Sob FORCE RLS isso depende de contexto:
+-- um runner SUPERUSER ve tudo (ignora RLS), mas um provisionador NAO-superuser ve zero sem os
+-- GUCs de contexto — e antes esta pre-condicao acusava "faltam seeds" quando na verdade elas
+-- existiam. Definimos o contexto de owner/ator para o runner enxergar como o dono das linhas.
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', false);
+SELECT set_config('nexus.actor_type', 'owner', false);
+
+DO $$
+BEGIN
+  IF current_database() <> 'nexus_test' THEN
+    RAISE EXCEPTION 'Expected isolated nexus_test database, got %', current_database();
+  END IF;
+  IF (SELECT count(*) FROM nexus.owner_identity) <> 1 THEN
+    RAISE EXCEPTION 'Expected the single seeded owner; found % rows', (SELECT count(*) FROM nexus.owner_identity);
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM nexus.messages)
+     OR NOT EXISTS (SELECT 1 FROM nexus.conversations)
+     OR NOT EXISTS (SELECT 1 FROM nexus.assistant_memories) THEN
+    RAISE EXCEPTION
+      'This file needs the seeded rows in messages, conversations and assistant_memories to exercise the tombstone triggers.';
+  END IF;
+  IF EXISTS (SELECT 1 FROM nexus.tool_grants)
+     OR EXISTS (SELECT 1 FROM nexus.tool_grant_audit)
+     OR EXISTS (SELECT 1 FROM nexus.user_assistant_preferences) THEN
+    RAISE EXCEPTION
+      'Owner-deletion verification requires a fresh database: Phase 5 tables are not empty. Recreate nexus_test before running this file.'
+      USING ERRCODE = '55000';
+  END IF;
+END
+$$;
+
+-- =============================================================================================
+-- RETRATO DO ESTADO PRISTINO — usado por §5 para provar que o ROLLBACK foi integral
+-- =============================================================================================
+-- Fica em tabela TEMPORARIA criada FORA de qualquer transacao, para sobreviver aos ROLLBACKs
+-- das secoes seguintes.
+--
+-- O retrato guarda `jsonb_agg` ORDENADO das linhas inteiras. A comparacao e feita por igualdade
+-- de JSONB (`IS DISTINCT FROM`), nao por hash de concatenacao: nao ha separador ambiguo, nao ha
+-- colisao de hash e a diferenca aparece como os dois valores completos, nao como "DIFFERS".
+--
+-- Duas colunas ficam de fora, por nao serem transacionais:
+--   * `nexus.tool_grant_audit.id`  — bigint GENERATED ALWAYS AS IDENTITY;
+--   * `nexus.tombstones.sequence`  — bigint de sequence.
+-- Uma sequence avanca mesmo quando a transacao faz ROLLBACK. Comparar esses valores faria o
+-- teste falhar por um motivo que nao e defeito.
+DROP TABLE IF EXISTS pg_temp.verify_baseline;
+CREATE TEMP TABLE verify_baseline AS
+SELECT
+  (SELECT count(*) FROM nexus.owner_identity) AS owners_count,
+  (SELECT jsonb_agg(to_jsonb(o) ORDER BY to_jsonb(o)::text) FROM nexus.owner_identity o) AS owners_doc,
+  (SELECT count(*) FROM nexus.tool_grants) AS grants_count,
+  (SELECT jsonb_agg(to_jsonb(g) ORDER BY to_jsonb(g)::text) FROM nexus.tool_grants g) AS grants_doc,
+  (SELECT count(*) FROM nexus.tool_grant_audit) AS audit_count,
+  (SELECT jsonb_agg(to_jsonb(a) - 'id' ORDER BY (to_jsonb(a) - 'id')::text) FROM nexus.tool_grant_audit a) AS audit_doc,
+  (SELECT count(*) FROM nexus.user_assistant_preferences) AS prefs_count,
+  (SELECT jsonb_agg(to_jsonb(p) ORDER BY to_jsonb(p)::text) FROM nexus.user_assistant_preferences p) AS prefs_doc,
+  (SELECT count(*) FROM nexus.tombstones) AS tombstones_count,
+  (SELECT jsonb_agg(to_jsonb(t) - 'sequence' ORDER BY (to_jsonb(t) - 'sequence')::text) FROM nexus.tombstones t) AS tombstones_doc,
+  (SELECT count(*) FROM nexus.messages) AS messages_count,
+  (SELECT jsonb_agg(to_jsonb(m) ORDER BY to_jsonb(m)::text) FROM nexus.messages m) AS messages_doc,
+  (SELECT count(*) FROM nexus.conversations) AS conversations_count,
+  (SELECT jsonb_agg(to_jsonb(c) ORDER BY to_jsonb(c)::text) FROM nexus.conversations c) AS conversations_doc,
+  (SELECT count(*) FROM nexus.assistant_memories) AS memories_count,
+  (SELECT jsonb_agg(to_jsonb(mem) ORDER BY to_jsonb(mem)::text) FROM nexus.assistant_memories mem) AS memories_doc,
+  (SELECT count(*) FROM nexus.assistant_memories WHERE source_message_id IS NOT NULL) AS memories_source_count;
+
+-- =============================================================================================
+-- §1. Excluir um GRANT preserva os eventos dele (append-only durante a vida da instalacao)
+-- =============================================================================================
+BEGIN;
+
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+DO $$
+BEGIN
+  INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+  VALUES
+    ('f0000000-0000-4000-8000-000000000001', nexus.current_owner_id(),
+     '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted',
+     nexus.current_owner_id(), now()),
+    ('f0000000-0000-4000-8000-000000000002', nexus.current_owner_id(),
+     '00000000-0000-4000-8000-000000000003', 'technical.code_analysis', 'granted',
+     nexus.current_owner_id(), now());
+
+  UPDATE nexus.tool_grants
+  SET status = 'revoked', revoked_by_owner_id = nexus.current_owner_id(), revoked_at = now()
+  WHERE id = 'f0000000-0000-4000-8000-000000000002';
+END
+$$;
+
+DO $$
+DECLARE
+  audit_before integer;
+  audit_after integer;
+  doc_before jsonb;
+  doc_after jsonb;
+BEGIN
+  -- Conteudo integral dos eventos do grant ANTES do delete (sem `id`, que e sequence).
+  SELECT jsonb_agg(to_jsonb(a) - 'id' ORDER BY (to_jsonb(a) - 'id')::text), count(*)
+    INTO doc_before, audit_before
+  FROM nexus.tool_grant_audit a
+  WHERE a.grant_id = 'f0000000-0000-4000-8000-000000000001';
+
+  DELETE FROM nexus.tool_grants WHERE id = 'f0000000-0000-4000-8000-000000000001';
+
+  IF EXISTS (SELECT 1 FROM nexus.tool_grants WHERE id = 'f0000000-0000-4000-8000-000000000001') THEN
+    RAISE EXCEPTION 'Deleted grant is still present';
+  END IF;
+
+  -- Conteudo integral DEPOIS. Igualdade de linha, nao contagem: um evento substituido ou alterado
+  -- (mesma quantidade) tem de falhar.
+  SELECT jsonb_agg(to_jsonb(a) - 'id' ORDER BY (to_jsonb(a) - 'id')::text), count(*)
+    INTO doc_after, audit_after
+  FROM nexus.tool_grant_audit a
+  WHERE a.grant_id = 'f0000000-0000-4000-8000-000000000001';
+
+  IF doc_after IS DISTINCT FROM doc_before THEN
+    RAISE EXCEPTION 'Deleting a grant changed its audit history. Before: %  After: %',
+      doc_before, doc_after;
+  END IF;
+  IF audit_after IS DISTINCT FROM audit_before THEN
+    RAISE EXCEPTION 'Deleting a grant erased its audit history (% -> %)', audit_before, audit_after;
+  END IF;
+  IF audit_after <> 1 THEN
+    RAISE EXCEPTION 'Expected 1 surviving audit row for the deleted grant, found %', audit_after;
+  END IF;
+  IF (SELECT action FROM nexus.tool_grant_audit WHERE grant_id = 'f0000000-0000-4000-8000-000000000001') <> 'granted' THEN
+    RAISE EXCEPTION 'Surviving audit row is not the original grant event';
+  END IF;
+END
+$$;
+
+ROLLBACK;
+
+-- =============================================================================================
+-- §2. O trigger BEFORE DELETE de `messages` anula `assistant_memories.source_message_id`
+-- =============================================================================================
+-- `clear_memory_source_before_message_delete()` roda ANTES do delete da mensagem e desfaz a
+-- referencia. Sem ele, `assistant_memories_source_message_id_fkey` (DEFERRABLE INITIALLY
+-- DEFERRED) faria o DELETE falhar no fim da transacao. Este bloco prova o EFEITO, nao a
+-- existencia do trigger, e o ROLLBACK tem de devolver `source_message_id` e `updated_at`.
+BEGIN;
+
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+DO $$
+DECLARE
+  target_message uuid := '30000000-0000-4000-8000-000000000001';
+  memory_id uuid := '40000000-0000-4000-8000-0000000000f1';
+  source_before uuid;
+  updated_before timestamptz;
+  source_after uuid;
+  updated_after timestamptz;
+BEGIN
+  -- `created_at` e `updated_at` vao para o PASSADO (a CHECK `timestamps_ordered` exige
+  -- `updated_at >= created_at`, entao os dois andam juntos). `now()` e o instante de inicio da
+  -- TRANSACAO, nao do comando: sem esse ajuste, a linha nasceria com `updated_at = now()` e o
+  -- trigger reescreveria o mesmo valor, tornando o efeito invisivel.
+  INSERT INTO nexus.assistant_memories
+    (id, owner_id, visibility, origin, source_message_id, origin_assistant_id, content, format_version,
+     created_at, updated_at)
+  VALUES
+    (memory_id, nexus.current_owner_id(), 'individual', 'test', target_message,
+     '00000000-0000-4000-8000-000000000001', 'memory whose source message is about to be deleted', 1,
+     now() - interval '1 day', now() - interval '1 day');
+
+  SELECT source_message_id, updated_at INTO source_before, updated_before
+  FROM nexus.assistant_memories WHERE id = memory_id;
+
+  IF source_before IS DISTINCT FROM target_message THEN
+    RAISE EXCEPTION 'Seed failed: expected source_message_id = %, found %', target_message, source_before;
+  END IF;
+
+  DELETE FROM nexus.messages WHERE id = target_message;
+
+  IF EXISTS (SELECT 1 FROM nexus.messages WHERE id = target_message) THEN
+    RAISE EXCEPTION 'Message % was not deleted', target_message;
+  END IF;
+
+  SELECT source_message_id, updated_at INTO source_after, updated_after
+  FROM nexus.assistant_memories WHERE id = memory_id;
+
+  -- O efeito do trigger: a referencia some sozinha, antes de o delete concluir.
+  IF source_after IS NOT NULL THEN
+    RAISE EXCEPTION 'BEFORE DELETE trigger did not clear source_message_id (still %)', source_after;
+  END IF;
+  -- Prova de que o trigger escreveu na linha (e nao apenas que a coluna ja era nula).
+  IF updated_after <= updated_before THEN
+    RAISE EXCEPTION 'BEFORE DELETE trigger did not touch updated_at (% -> %)', updated_before, updated_after;
+  END IF;
+  IF updated_after < now() - interval '1 hour' THEN
+    RAISE EXCEPTION 'BEFORE DELETE trigger did not refresh updated_at to the transaction time (found %)', updated_after;
+  END IF;
+END
+$$;
+
+ROLLBACK;
+
+-- E o ROLLBACK tem de ter devolvido a mensagem e descartado a memoria temporaria.
+DO $$
+DECLARE
+  memory_rows integer;
+  message_rows integer;
+BEGIN
+  SELECT count(*) INTO memory_rows FROM nexus.assistant_memories
+  WHERE id = '40000000-0000-4000-8000-0000000000f1';
+  SELECT count(*) INTO message_rows FROM nexus.messages
+  WHERE id = '30000000-0000-4000-8000-000000000001';
+
+  IF memory_rows <> 0 THEN
+    RAISE EXCEPTION 'ROLLBACK failed: the temporary memory seeded by this section survived';
+  END IF;
+  IF message_rows <> 1 THEN
+    RAISE EXCEPTION 'ROLLBACK failed: message % was not restored', '30000000-0000-4000-8000-000000000001';
+  END IF;
+END
+$$;
+
+-- =============================================================================================
+-- §3. COM DADOS PRESENTES, excluir o owner FALHA (SQLSTATE 23503 / tombstones_owner_id_fkey)
+-- =============================================================================================
+-- Este bloco registra o DEFEITO ATUAL. Se ele passar a falhar dizendo "owner deletion SUCCEEDED",
+-- a limitacao dos triggers de tombstone foi corrigida (ou contornada) e §4 precisa ser reescrita,
+-- junto com a documentacao da Fase 5.
+--
+-- O erro e capturado em subtransacao propria (bloco com EXCEPTION): ao capturar, o PostgreSQL
+-- desfaz tudo o que aquele bloco fez. Nada residual permanece — as assercoes finais confirmam.
+DO $$
+DECLARE
+  deleted boolean := false;
+  err_state text;
+  err_constraint text;
+  err_message text;
+  doc_now jsonb;
+  doc_base jsonb;
+BEGIN
+  BEGIN
+    DELETE FROM nexus.owner_identity WHERE id = '00000000-0000-4000-8000-000000000004';
+    deleted := true;
+  EXCEPTION WHEN OTHERS THEN
+    GET STACKED DIAGNOSTICS
+      err_state = RETURNED_SQLSTATE,
+      err_constraint = CONSTRAINT_NAME,
+      err_message = MESSAGE_TEXT;
+  END;
+
+  IF deleted THEN
+    RAISE EXCEPTION
+      'Owner deletion SUCCEEDED with data present. The tombstone limitation is gone: update this file, verify-stage-5-rls.sql and docs/FASE_5_G13_CATALOGO_GLOBAL_CONFIGURACOES_PESSOAIS.md.';
+  END IF;
+
+  -- A exclusao do owner falha por UMA DE DUAS barreiras, e qual delas aparece depende do papel
+  -- do runner — o defeito e real nos dois casos, mas o SQLSTATE muda:
+  --
+  --   * runner SUPERUSER: ignora RLS; o INSERT em `tombstones` feito pelo trigger
+  --     `record_deleted_entity` chega a rodar e viola `tombstones_owner_id_fkey` -> 23503.
+  --   * runner NAO-superuser (o caso de PRODUCAO, ver R36): o trigger tambem e SECURITY DEFINER
+  --     com dono `postgres`, mas a tabela `tombstones` tem FORCE RLS e o INSERT nao tem contexto
+  --     coerente para o dono excluido -> 42501 (row-level security).
+  --
+  -- Exigir 23503 sempre foi exigir um runner superusuario, o que a instalacao real nao tem.
+  -- O que o teste DEVE garantir e: (a) a exclusao NAO acontece; (b) a causa e o mecanismo de
+  -- tombstone (FK ou RLS de `tombstones`), nunca algo generico.
+  IF err_state NOT IN ('23503', '42501') THEN
+    RAISE EXCEPTION 'Expected SQLSTATE 23503 (FK) or 42501 (RLS on tombstones), got %: %',
+      err_state, err_message;
+  END IF;
+  IF err_state = '23503' AND err_constraint IS DISTINCT FROM 'tombstones_owner_id_fkey' THEN
+    RAISE EXCEPTION 'Expected constraint tombstones_owner_id_fkey, got %', coalesce(err_constraint, '<none>');
+  END IF;
+  IF err_state = '42501' AND err_message NOT LIKE '%tombstones%' THEN
+    RAISE EXCEPTION 'RLS rejection did not come from the tombstones table: %', err_message;
+  END IF;
+
+  -- Isolamento: a subtransacao desfez a tentativa por completo. Contagem E conteudo.
+  IF (SELECT count(*) FROM nexus.owner_identity) <> 1 THEN
+    RAISE EXCEPTION 'Exception handling left the owner table inconsistent (% rows)', (SELECT count(*) FROM nexus.owner_identity);
+  END IF;
+
+  SELECT jsonb_agg(to_jsonb(t) - 'sequence' ORDER BY (to_jsonb(t) - 'sequence')::text) INTO doc_now FROM nexus.tombstones t;
+  SELECT tombstones_doc INTO doc_base FROM pg_temp.verify_baseline;
+  IF doc_now IS DISTINCT FROM doc_base THEN
+    RAISE EXCEPTION 'Exception handling changed tombstones content. Before: %  After: %', doc_base, doc_now;
+  END IF;
+
+  SELECT jsonb_agg(to_jsonb(m) ORDER BY to_jsonb(m)::text) INTO doc_now FROM nexus.messages m;
+  SELECT messages_doc INTO doc_base FROM pg_temp.verify_baseline;
+  IF doc_now IS DISTINCT FROM doc_base THEN
+    RAISE EXCEPTION 'Exception handling changed messages content';
+  END IF;
+
+  SELECT jsonb_agg(to_jsonb(c) ORDER BY to_jsonb(c)::text) INTO doc_now FROM nexus.conversations c;
+  SELECT conversations_doc INTO doc_base FROM pg_temp.verify_baseline;
+  IF doc_now IS DISTINCT FROM doc_base THEN
+    RAISE EXCEPTION 'Exception handling changed conversations content';
+  END IF;
+
+  SELECT jsonb_agg(to_jsonb(mem) ORDER BY to_jsonb(mem)::text) INTO doc_now FROM nexus.assistant_memories mem;
+  SELECT memories_doc INTO doc_base FROM pg_temp.verify_baseline;
+  IF doc_now IS DISTINCT FROM doc_base THEN
+    RAISE EXCEPTION 'Exception handling changed assistant_memories content';
+  END IF;
+
+  RAISE NOTICE 'Owner deletion correctly fails today: % / % (% )', err_state, coalesce(err_constraint,'-'), err_message;
+END
+$$;
+
+-- =============================================================================================
+-- §4. CONTORNO EXPLICITO: esvaziar as tres tabelas e entao provar a cascata das tabelas da Fase 5
+-- =============================================================================================
+-- A limpeza abaixo NAO e preparatoria "neutra": ela remove justamente os dados que disparam os
+-- triggers de tombstone e impedem a exclusao do owner (§3). O que este bloco prova e a cascata
+-- das tabelas da Fase 5 — nao que a exclusao do owner funcione na presenca de dados.
+BEGIN;
+
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+-- Semeia: 1 grant ativo + 1 grant revogado (3 eventos de auditoria) + 1 preferencia.
+DO $$
+BEGIN
+  INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+  VALUES
+    ('f0000000-0000-4000-8000-000000000001', nexus.current_owner_id(),
+     '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted',
+     nexus.current_owner_id(), now()),
+    ('f0000000-0000-4000-8000-000000000002', nexus.current_owner_id(),
+     '00000000-0000-4000-8000-000000000003', 'technical.code_analysis', 'granted',
+     nexus.current_owner_id(), now());
+
+  UPDATE nexus.tool_grants
+  SET status = 'revoked', revoked_by_owner_id = nexus.current_owner_id(), revoked_at = now()
+  WHERE id = 'f0000000-0000-4000-8000-000000000002';
+
+  INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, is_default)
+  VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000001', true);
+END
+$$;
+
+DO $$
+DECLARE
+  grant_rows integer;
+  audit_rows integer;
+  preference_rows integer;
+BEGIN
+  SELECT count(*) INTO grant_rows FROM nexus.tool_grants;
+  SELECT count(*) INTO audit_rows FROM nexus.tool_grant_audit;
+  SELECT count(*) INTO preference_rows FROM nexus.user_assistant_preferences;
+
+  IF grant_rows <> 2 THEN RAISE EXCEPTION 'Seed expected 2 grants, found %', grant_rows; END IF;
+  IF audit_rows <> 3 THEN RAISE EXCEPTION 'Seed expected 3 audit rows, found %', audit_rows; END IF;
+  IF preference_rows <> 1 THEN RAISE EXCEPTION 'Seed expected 1 preference, found %', preference_rows; END IF;
+END
+$$;
+
+-- --- Contorno: esvaziar as tres tabelas com trigger de tombstone -------------------------------
+DO $$
+DECLARE
+  tombstones_before integer;
+  messages_to_delete integer;
+  conversations_to_delete integer;
+  memories_to_delete integer;
+  expected integer;
+  tombstones_after integer;
+BEGIN
+  SELECT count(*) INTO tombstones_before FROM nexus.tombstones;
+  SELECT count(*) INTO messages_to_delete FROM nexus.messages;
+  SELECT count(*) INTO conversations_to_delete FROM nexus.conversations;
+  SELECT count(*) INTO memories_to_delete FROM nexus.assistant_memories;
+
+  -- ON CONFLICT (entity_type, entity_id) DO NOTHING tornaria a aritmetica abaixo otimista se
+  -- algum desses ids ja fosse um tombstone. Melhor falhar explicando do que subestimar.
+  IF EXISTS (
+    SELECT 1 FROM nexus.tombstones t
+    WHERE (t.entity_type = 'message' AND t.entity_id IN (SELECT id FROM nexus.messages))
+       OR (t.entity_type = 'conversation' AND t.entity_id IN (SELECT id FROM nexus.conversations))
+       OR (t.entity_type = 'memory' AND t.entity_id IN (SELECT id FROM nexus.assistant_memories))
+  ) THEN
+    RAISE EXCEPTION 'Unexpected: a row about to be deleted is already tombstoned; the count assertion below would be wrong';
+  END IF;
+
+  DELETE FROM nexus.messages;
+  DELETE FROM nexus.conversations;
+  DELETE FROM nexus.assistant_memories;
+
+  IF EXISTS (SELECT 1 FROM nexus.messages)
+     OR EXISTS (SELECT 1 FROM nexus.conversations)
+     OR EXISTS (SELECT 1 FROM nexus.assistant_memories) THEN
+    RAISE EXCEPTION 'Cleanup did not empty the three tombstone-triggered tables';
+  END IF;
+
+  SELECT count(*) INTO tombstones_after FROM nexus.tombstones;
+  expected := tombstones_before + messages_to_delete + conversations_to_delete + memories_to_delete;
+
+  -- Prova de que os triggers de tombstone REALMENTE dispararam durante a limpeza: e por isso
+  -- que §3 falha. Sem esta assercao, a limpeza pareceria inofensiva.
+  IF tombstones_after <> expected THEN
+    RAISE EXCEPTION 'Cleanup should have added % tombstone(s) (%), but % -> %',
+      messages_to_delete + conversations_to_delete + memories_to_delete, expected, tombstones_before, tombstones_after;
+  END IF;
+
+  RAISE NOTICE 'Cleanup bypassed the tombstone limitation: % -> % tombstones (+%)',
+    tombstones_before, tombstones_after, tombstones_after - tombstones_before;
+END
+$$;
+
+-- --- ESTADO IMEDIATAMENTE ANTES DA EXCLUSAO DO OWNER -------------------------------------------
+DO $$
+DECLARE
+  grant_rows integer;
+  audit_rows integer;
+  preference_rows integer;
+  tombstone_rows integer;
+  grants_doc jsonb;
+  prefs_doc jsonb;
+  audit_doc jsonb;
+BEGIN
+  SELECT count(*) INTO grant_rows FROM nexus.tool_grants;
+  SELECT count(*) INTO audit_rows FROM nexus.tool_grant_audit;
+  SELECT count(*) INTO preference_rows FROM nexus.user_assistant_preferences;
+  SELECT count(*) INTO tombstone_rows FROM nexus.tombstones;
+
+  IF (SELECT count(*) FROM nexus.owner_identity) <> 1 THEN
+    RAISE EXCEPTION 'Expected exactly 1 owner before deletion';
+  END IF;
+  IF grant_rows <> 2 OR audit_rows <> 3 OR preference_rows <> 1 THEN
+    RAISE EXCEPTION 'Unexpected Phase 5 seed before deletion: grants=% audit=% prefs=%', grant_rows, audit_rows, preference_rows;
+  END IF;
+  -- Todos os tombstones remanescentes apontam para o owner que sera excluido.
+  IF EXISTS (SELECT 1 FROM nexus.tombstones WHERE owner_id <> '00000000-0000-4000-8000-000000000004') THEN
+    RAISE EXCEPTION 'Found tombstone(s) belonging to another owner; the assertion below would not be meaningful';
+  END IF;
+
+  -- Conteudo que sera destruido pela cascata: guardado para provar que ele EXISTIA antes e que
+  -- nao sobrou nada depois (contagem zero por conteudo vazio, nao por filtro).
+  SELECT jsonb_agg(to_jsonb(g) ORDER BY to_jsonb(g)::text) INTO grants_doc FROM nexus.tool_grants g;
+  SELECT jsonb_agg(to_jsonb(p) ORDER BY to_jsonb(p)::text) INTO prefs_doc FROM nexus.user_assistant_preferences p;
+  SELECT jsonb_agg(to_jsonb(a) - 'id' ORDER BY (to_jsonb(a) - 'id')::text) INTO audit_doc FROM nexus.tool_grant_audit a;
+
+  IF grants_doc IS NULL OR jsonb_array_length(grants_doc) <> 2 THEN
+    RAISE EXCEPTION 'Expected 2 grant rows before deletion, found %', coalesce(jsonb_array_length(grants_doc), 0);
+  END IF;
+  IF prefs_doc IS NULL OR jsonb_array_length(prefs_doc) <> 1 THEN
+    RAISE EXCEPTION 'Expected 1 preference row before deletion, found %', coalesce(jsonb_array_length(prefs_doc), 0);
+  END IF;
+  IF audit_doc IS NULL OR jsonb_array_length(audit_doc) <> 3 THEN
+    RAISE EXCEPTION 'Expected 3 audit rows before deletion, found %', coalesce(jsonb_array_length(audit_doc), 0);
+  END IF;
+
+  RAISE NOTICE 'Before owner deletion: owners=1 grants=% audit=% prefs=% tombstones=%',
+    grant_rows, audit_rows, preference_rows, tombstone_rows;
+END
+$$;
+
+-- --- A CASCATA DAS TABELAS DA FASE 5 ----------------------------------------------------------
+DO $$
+DECLARE
+  remaining_owners integer;
+  grant_rows integer;
+  audit_rows integer;
+  preference_rows integer;
+  tombstone_rows integer;
+BEGIN
+  DELETE FROM nexus.owner_identity WHERE id = '00000000-0000-4000-8000-000000000004';
+
+  SELECT count(*) INTO remaining_owners FROM nexus.owner_identity;
+  SELECT count(*) INTO grant_rows FROM nexus.tool_grants;
+  SELECT count(*) INTO audit_rows FROM nexus.tool_grant_audit;
+  SELECT count(*) INTO preference_rows FROM nexus.user_assistant_preferences;
+  SELECT count(*) INTO tombstone_rows FROM nexus.tombstones;
+
+  IF remaining_owners <> 0 THEN
+    RAISE EXCEPTION 'Owner row was not removed (found %)', remaining_owners;
+  END IF;
+
+  IF grant_rows <> 0 THEN
+    RAISE EXCEPTION 'Owner deletion left % tool grant(s) behind', grant_rows;
+  END IF;
+  IF preference_rows <> 0 THEN
+    RAISE EXCEPTION 'Owner deletion left % assistant preference(s) behind', preference_rows;
+  END IF;
+  IF audit_rows <> 0 THEN
+    RAISE EXCEPTION 'Owner deletion left % grant audit row(s) behind', audit_rows;
+  END IF;
+  -- Os tombstones gerados pela limpeza cascateiam pelo mesmo motivo: todos eram do owner.
+  IF tombstone_rows <> 0 THEN
+    RAISE EXCEPTION 'Owner deletion left % tombstone(s) behind', tombstone_rows;
+  END IF;
+END
+$$;
+
+ROLLBACK;
+
+-- =============================================================================================
+-- §5. O ROLLBACK RESTAUROU TUDO? (conteudo, nao apenas contagem)
+-- =============================================================================================
+-- Compara o estado atual com o retrato tirado antes de qualquer secao. Cobre as oito entidades
+-- e, explicitamente, `assistant_memories.source_message_id`.
+--
+-- NAO compara `tool_grant_audit.id` nem `tombstones.sequence`: sequences nao sao transacionais e
+-- avancam mesmo com ROLLBACK. Ambas foram removidas dos documentos no retrato inicial.
+DO $$
+DECLARE
+  b record;
+  v_count integer;
+  v_doc jsonb;
+BEGIN
+  SELECT * INTO b FROM pg_temp.verify_baseline;
+
+  -- owner_identity
+  SELECT count(*), jsonb_agg(to_jsonb(o) ORDER BY to_jsonb(o)::text) INTO v_count, v_doc FROM nexus.owner_identity o;
+  IF v_doc IS DISTINCT FROM b.owners_doc THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore owner_identity content. Expected: %  Got: %', b.owners_doc, v_doc;
+  END IF;
+  IF v_count IS DISTINCT FROM b.owners_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore owner_identity count (% vs %)', v_count, b.owners_count;
+  END IF;
+
+  -- tool_grants
+  SELECT count(*), jsonb_agg(to_jsonb(g) ORDER BY to_jsonb(g)::text) INTO v_count, v_doc FROM nexus.tool_grants g;
+  IF v_doc IS DISTINCT FROM b.grants_doc THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore tool_grants content. Expected: %  Got: %', b.grants_doc, v_doc;
+  END IF;
+  IF v_count IS DISTINCT FROM b.grants_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore tool_grants count (% vs %)', v_count, b.grants_count;
+  END IF;
+
+  -- tool_grant_audit (sem `id`: sequence nao e transacional)
+  SELECT count(*), jsonb_agg(to_jsonb(a) - 'id' ORDER BY (to_jsonb(a) - 'id')::text) INTO v_count, v_doc FROM nexus.tool_grant_audit a;
+  IF v_doc IS DISTINCT FROM b.audit_doc THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore tool_grant_audit content';
+  END IF;
+  IF v_count IS DISTINCT FROM b.audit_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore tool_grant_audit count (% vs %)', v_count, b.audit_count;
+  END IF;
+
+  -- user_assistant_preferences
+  SELECT count(*), jsonb_agg(to_jsonb(p) ORDER BY to_jsonb(p)::text) INTO v_count, v_doc FROM nexus.user_assistant_preferences p;
+  IF v_doc IS DISTINCT FROM b.prefs_doc THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore user_assistant_preferences content';
+  END IF;
+  IF v_count IS DISTINCT FROM b.prefs_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore user_assistant_preferences count (% vs %)', v_count, b.prefs_count;
+  END IF;
+
+  -- tombstones (sem `sequence`)
+  SELECT count(*), jsonb_agg(to_jsonb(t) - 'sequence' ORDER BY (to_jsonb(t) - 'sequence')::text) INTO v_count, v_doc FROM nexus.tombstones t;
+  IF v_doc IS DISTINCT FROM b.tombstones_doc THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore tombstones content';
+  END IF;
+  IF v_count IS DISTINCT FROM b.tombstones_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore tombstones count (% vs %)', v_count, b.tombstones_count;
+  END IF;
+
+  -- messages
+  SELECT count(*), jsonb_agg(to_jsonb(m) ORDER BY to_jsonb(m)::text) INTO v_count, v_doc FROM nexus.messages m;
+  IF v_doc IS DISTINCT FROM b.messages_doc THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore messages content';
+  END IF;
+  IF v_count IS DISTINCT FROM b.messages_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore messages count (% vs %)', v_count, b.messages_count;
+  END IF;
+
+  -- conversations
+  SELECT count(*), jsonb_agg(to_jsonb(c) ORDER BY to_jsonb(c)::text) INTO v_count, v_doc FROM nexus.conversations c;
+  IF v_doc IS DISTINCT FROM b.conversations_doc THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore conversations content';
+  END IF;
+  IF v_count IS DISTINCT FROM b.conversations_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore conversations count (% vs %)', v_count, b.conversations_count;
+  END IF;
+
+  -- assistant_memories (o documento inclui source_message_id e updated_at)
+  SELECT count(*), jsonb_agg(to_jsonb(mem) ORDER BY to_jsonb(mem)::text) INTO v_count, v_doc FROM nexus.assistant_memories mem;
+  IF v_doc IS DISTINCT FROM b.memories_doc THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore assistant_memories content. Expected: %  Got: %', b.memories_doc, v_doc;
+  END IF;
+  IF v_count IS DISTINCT FROM b.memories_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore assistant_memories count (% vs %)', v_count, b.memories_count;
+  END IF;
+
+  -- Referencia explicita: §2 mexeu em source_message_id, e o ROLLBACK tem de ter devolvido.
+  SELECT count(*) INTO v_count FROM nexus.assistant_memories WHERE source_message_id IS NOT NULL;
+  IF v_count <> b.memories_source_count THEN
+    RAISE EXCEPTION 'ROLLBACK did not restore assistant_memories.source_message_id (% non-null vs % expected)',
+      v_count, b.memories_source_count;
+  END IF;
+END
+$$;
+
+DROP TABLE pg_temp.verify_baseline;
+
+DO $$
+BEGIN
+  RAISE NOTICE 'Phase 5 (G13) owner-deletion verification passed';
+END
+$$;
diff --git a/packages/database/tests/postgres/verify-stage-5-preferences.sql b/packages/database/tests/postgres/verify-stage-5-preferences.sql
new file mode 100644
index 0000000..ae7ce96
--- /dev/null
+++ b/packages/database/tests/postgres/verify-stage-5-preferences.sql
@@ -0,0 +1,110 @@
+\set ON_ERROR_STOP on
+-- Fase 5 (G13): validacao de `user_assistant_preferences.display_label`.
+--
+-- Nas duas versoes da constraint:
+--   * `user_assistant_preferences_label_length`     -> entre 1 e 64 caracteres;
+--   * `user_assistant_preferences_label_not_blank`  -> rejeita string so de espacos;
+-- e `display_label` continua OPCIONAL (NULL permitido).
+--
+-- Roda como `postgres`; tudo em transacao com ROLLBACK.
+-- =============================================================================================
+DO $$
+BEGIN
+  IF current_database() <> 'nexus_test' THEN
+    RAISE EXCEPTION 'Expected isolated nexus_test database, got %', current_database();
+  END IF;
+  IF EXISTS (SELECT 1 FROM nexus.user_assistant_preferences) THEN
+    RAISE EXCEPTION
+      'Preferences verification requires a fresh database: user_assistant_preferences is not empty.'
+      USING ERRCODE = '55000';
+  END IF;
+END
+$$;
+
+BEGIN;
+
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+DO $$
+DECLARE
+  owner uuid := nexus.current_owner_id();
+  assistant uuid := '00000000-0000-4000-8000-000000000001';
+  rejected boolean;
+  label text;
+BEGIN
+  -- 1. NULL e permitido (rotulo e opcional).
+  INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, display_label)
+  VALUES (owner, assistant, NULL);
+  IF NOT FOUND THEN
+    RAISE EXCEPTION 'NULL display_label was not accepted';
+  END IF;
+
+  -- 2. String vazia: rejeitada por `label_length`.
+  rejected := false;
+  BEGIN
+    UPDATE nexus.user_assistant_preferences SET display_label = '' WHERE owner_id = owner AND assistant_id = assistant;
+    RAISE EXCEPTION 'Empty display_label was accepted';
+  EXCEPTION WHEN check_violation THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION 'Empty display_label was accepted';
+  END IF;
+
+  -- 3. Apenas branco: rejeitada por `label_not_blank`. Cobre espaco, tab, CR e VT — nao apenas
+  -- espaco, que e o que `btrim` sem argumento removeria.
+  FOR label IN SELECT unnest(ARRAY[' ', '   ', E'\t', E' \t ', E'\n', E'\r\n', E'\v'])
+  LOOP
+    rejected := false;
+    BEGIN
+      UPDATE nexus.user_assistant_preferences SET display_label = label WHERE owner_id = owner AND assistant_id = assistant;
+      RAISE EXCEPTION 'Whitespace-only display_label (len %) was accepted', length(label);
+    EXCEPTION WHEN check_violation THEN rejected := true;
+    END;
+    IF NOT rejected THEN
+      RAISE EXCEPTION 'Whitespace-only display_label (len %) was accepted', length(label);
+    END IF;
+  END LOOP;
+
+  -- 4. Rotulo valido: aceito, inclusive com espacos nas pontas (o requisito e "nao ser SO espaco").
+  UPDATE nexus.user_assistant_preferences SET display_label = '  Yui  ' WHERE owner_id = owner AND assistant_id = assistant;
+  IF (SELECT display_label FROM nexus.user_assistant_preferences WHERE owner_id = owner AND assistant_id = assistant)
+     IS DISTINCT FROM '  Yui  ' THEN
+    RAISE EXCEPTION 'Valid label was not stored verbatim';
+  END IF;
+
+  -- 5. Limites: 1 e 64 aceitos; 65 rejeitado.
+  UPDATE nexus.user_assistant_preferences SET display_label = 'A' WHERE owner_id = owner AND assistant_id = assistant;
+  UPDATE nexus.user_assistant_preferences SET display_label = repeat('B', 64) WHERE owner_id = owner AND assistant_id = assistant;
+  IF char_length((SELECT display_label FROM nexus.user_assistant_preferences
+                  WHERE owner_id = owner AND assistant_id = assistant)) <> 64 THEN
+    RAISE EXCEPTION '64-char label was not stored';
+  END IF;
+
+  rejected := false;
+  BEGIN
+    UPDATE nexus.user_assistant_preferences SET display_label = repeat('C', 65) WHERE owner_id = owner AND assistant_id = assistant;
+    RAISE EXCEPTION '65-char display_label was accepted';
+  EXCEPTION WHEN check_violation THEN rejected := true;
+  END;
+  IF NOT rejected THEN
+    RAISE EXCEPTION '65-char display_label was accepted';
+  END IF;
+
+  -- Apos todas as rejeicoes, o valor anterior continua intacto (rollback de subtransacao).
+  IF char_length((SELECT display_label FROM nexus.user_assistant_preferences
+                  WHERE owner_id = owner AND assistant_id = assistant)) <> 64 THEN
+    RAISE EXCEPTION 'Rejected updates damaged the stored label';
+  END IF;
+
+  RAISE NOTICE 'display_label: NULL/1/64 accepted; empty, whitespace-only and 65 rejected';
+END
+$$;
+
+ROLLBACK;
+
+DO $$
+BEGIN
+  RAISE NOTICE 'Phase 5 (G13) preferences display_label verification passed';
+END
+$$;
diff --git a/packages/database/tests/postgres/verify-stage-5-rls.sql b/packages/database/tests/postgres/verify-stage-5-rls.sql
new file mode 100644
index 0000000..248ef47
--- /dev/null
+++ b/packages/database/tests/postgres/verify-stage-5-rls.sql
@@ -0,0 +1,904 @@
+\set ON_ERROR_STOP on
+-- Fase 5 (G13): verificacao de integridade, RLS e auditoria de `nexus.tool_grants`,
+-- `nexus.tool_grant_audit` e `nexus.user_assistant_preferences`.
+--
+-- Roda como `nexus_app` (LOGIN NOSUPERUSER NOBYPASSRLS), igual a integration.sql, depois do
+-- bootstrap. Cada bloco prova um requisito da subfase 5.1. Nenhum mock: e PostgreSQL 17 real.
+--
+-- Convencao: um DO que nao levanta excecao e um requisito satisfeito.
+
+DO $$
+BEGIN
+  IF current_user <> 'nexus_app' THEN
+    RAISE EXCEPTION 'Phase 5 checks must run as nexus_app, got %', current_user;
+  END IF;
+END
+$$;
+
+-- =============================================================================================
+-- A0. Invariantes de ESQUEMA (catalogo) — nao podem ser provados por comportamento
+-- =============================================================================================
+-- `FORCE ROW LEVEL SECURITY` merece verificacao propria por duas razoes:
+--   * para `nexus_app`, que NAO e dono da tabela, `ENABLE` ja basta: FORCE nao muda nada. Logo,
+--     nenhum teste de comportamento executado como `nexus_app` poderia detectar a remocao de
+--     FORCE. So o catalogo prova.
+--   * a protecao que FORCE oferece e contra o PROPRIO DONO da tabela. Ele NAO protege contra
+--     SUPERUSER nem contra papeis com BYPASSRLS — esses ignoram RLS com ou sem FORCE. Sao duas
+--     defesas distintas e por isso sao verificadas separadamente abaixo.
+DO $$
+DECLARE
+  relation record;
+  checked integer := 0;
+  expected_tables constant text[] := ARRAY[
+    'tool_grants', 'tool_grant_audit', 'user_assistant_preferences'
+  ];
+BEGIN
+  FOR relation IN
+    SELECT c.relname, c.relrowsecurity, c.relforcerowsecurity
+    FROM pg_class c
+    JOIN pg_namespace n ON n.oid = c.relnamespace
+    WHERE n.nspname = 'nexus' AND c.relname = ANY (expected_tables)
+    ORDER BY c.relname
+  LOOP
+    checked := checked + 1;
+    IF NOT relation.relrowsecurity THEN
+      RAISE EXCEPTION '%.% must have ROW LEVEL SECURITY enabled', 'nexus', relation.relname;
+    END IF;
+    IF NOT relation.relforcerowsecurity THEN
+      RAISE EXCEPTION '%.% must have FORCE ROW LEVEL SECURITY', 'nexus', relation.relname;
+    END IF;
+  END LOOP;
+
+  IF checked <> array_length(expected_tables, 1) THEN
+    RAISE EXCEPTION 'Expected % Phase 5 tables, found %', array_length(expected_tables, 1), checked;
+  END IF;
+
+  -- O papel de aplicacao nao pode ser dono: enquanto nao for, FORCE e redundante para ele; se a
+  -- propriedade mudar, FORCE passa a ser a unica barreira. Verificar as duas coisas torna a
+  -- regressao visivel nos dois cenarios.
+  IF EXISTS (
+    SELECT 1 FROM pg_tables
+    WHERE schemaname = 'nexus' AND tablename = ANY (expected_tables)
+      AND tableowner = current_user
+  ) THEN
+    RAISE EXCEPTION 'Application role must not own personal-data tables';
+  END IF;
+END
+$$;
+
+-- Nenhum papel alem de `nexus_app` pode receber privilegio de tabela nas tabelas da Fase 5.
+-- Defesa em profundidade: hoje `nexus_anonymous` tambem nao tem USAGE no schema `nexus`, entao um
+-- GRANT acidental nao chega a ser exploravel — mas depender so dessa segunda barreira deixaria a
+-- regressao invisivel. Aqui as duas sao verificadas de forma independente.
+DO $$
+DECLARE
+  expected_tables constant text[] := ARRAY[
+    'tool_grants', 'tool_grant_audit', 'user_assistant_preferences'
+  ];
+  offender record;
+BEGIN
+  FOR offender IN
+    SELECT c.relname, acl.grantee::regrole::text AS role_name, acl.privilege_type
+    FROM pg_class c
+    JOIN pg_namespace n ON n.oid = c.relnamespace
+    CROSS JOIN LATERAL aclexplode(COALESCE(c.relacl, acldefault('r', c.relowner))) AS acl
+    WHERE n.nspname = 'nexus'
+      AND c.relname = ANY (expected_tables)
+      AND acl.grantee <> 0                              -- 0 = PUBLIC
+      AND acl.grantee <> c.relowner                     -- o dono sempre tem privilegio
+      AND acl.grantee <> 'nexus_app'::regrole
+      -- Unica excecao: o papel escritor da trilha. Ele so pode INSERT, e so em
+      -- tool_grant_audit — o que e verificado explicitamente logo abaixo. Qualquer outro
+      -- privilegio dele em qualquer dessas tabelas continua sendo falha.
+      AND NOT (acl.grantee = 'nexus_audit_writer'::regrole
+               AND c.relname = 'tool_grant_audit'
+               AND acl.privilege_type = 'INSERT')
+  LOOP
+    RAISE EXCEPTION 'Unexpected grant on nexus.% to % (%)',
+      offender.relname, offender.role_name, offender.privilege_type;
+  END LOOP;
+
+  -- O papel escritor da trilha: exatamente INSERT em tool_grant_audit, e nada mais em lugar
+  -- nenhum. Sem esta assercao positiva, a excecao acima poderia mascarar um GRANT a mais.
+  FOR offender IN
+    SELECT c.relname AS role_name, a.privilege_type
+    FROM pg_class c
+    JOIN pg_namespace n ON n.oid = c.relnamespace
+    CROSS JOIN LATERAL aclexplode(COALESCE(c.relacl, acldefault('r', c.relowner))) AS a
+    WHERE n.nspname = 'nexus'
+      AND c.relname = ANY (expected_tables)
+      AND a.grantee = 'nexus_audit_writer'::regrole
+      AND NOT (c.relname = 'tool_grant_audit' AND a.privilege_type = 'INSERT')
+  LOOP
+    RAISE EXCEPTION 'nexus_audit_writer must only INSERT on tool_grant_audit, found % on nexus.%',
+      offender.role_name, offender.role_name;
+  END LOOP;
+
+  -- E a aplicacao NAO pode escrever a trilha: SELECT e o teto.
+  FOR offender IN
+    SELECT a.privilege_type
+    FROM pg_class c
+    JOIN pg_namespace n ON n.oid = c.relnamespace
+    CROSS JOIN LATERAL aclexplode(COALESCE(c.relacl, acldefault('r', c.relowner))) AS a
+    WHERE n.nspname = 'nexus'
+      AND c.relname = 'tool_grant_audit'
+      AND a.grantee = 'nexus_app'::regrole
+      AND a.privilege_type <> 'SELECT'
+  LOOP
+    RAISE EXCEPTION 'nexus_app must not hold % on the grant audit trail', offender.privilege_type;
+  END LOOP;
+
+  -- PUBLIC nao pode ter privilegio nenhum.
+  FOR offender IN
+    SELECT c.relname, acl.privilege_type
+    FROM pg_class c
+    JOIN pg_namespace n ON n.oid = c.relnamespace
+    CROSS JOIN LATERAL aclexplode(COALESCE(c.relacl, acldefault('r', c.relowner))) AS acl
+    WHERE n.nspname = 'nexus'
+      AND c.relname = ANY (expected_tables)
+      AND acl.grantee = 0
+  LOOP
+    RAISE EXCEPTION 'PUBLIC must not hold % on nexus.%', offender.privilege_type, offender.relname;
+  END LOOP;
+END
+$$;
+
+-- `nexus_anonymous` continua sem acesso ao schema (barreira que ja existe desde 00001).
+DO $$
+BEGIN
+  IF has_schema_privilege('nexus_anonymous', 'nexus', 'USAGE') THEN
+    RAISE EXCEPTION 'nexus_anonymous must not have USAGE on schema nexus';
+  END IF;
+END
+$$;
+
+-- `nexus_app` nunca pode escapar do RLS por atributo de papel. Esta e a unica verificacao que
+-- cobre SUPERUSER/BYPASSRLS: FORCE nao cobre, por definicao.
+DO $$
+DECLARE
+  role_record record;
+BEGIN
+  SELECT rolsuper, rolbypassrls, rolcanlogin, rolinherit INTO role_record
+  FROM pg_roles WHERE rolname = 'nexus_app';
+
+  IF NOT FOUND THEN
+    RAISE EXCEPTION 'Role nexus_app does not exist';
+  END IF;
+  IF role_record.rolsuper THEN
+    RAISE EXCEPTION 'nexus_app must not be SUPERUSER (would bypass RLS regardless of FORCE)';
+  END IF;
+  IF role_record.rolbypassrls THEN
+    RAISE EXCEPTION 'nexus_app must not have BYPASSRLS (would bypass RLS regardless of FORCE)';
+  END IF;
+  IF NOT role_record.rolcanlogin THEN
+    RAISE EXCEPTION 'nexus_app must be able to log in';
+  END IF;
+  -- NOINHERIT: nenhum privilegio chega por heranca de outro papel.
+  IF role_record.rolinherit THEN
+    RAISE EXCEPTION 'nexus_app must be NOINHERIT';
+  END IF;
+
+  -- Reforco no proprio backend: os atributos que importam vem do catalogo acima, mas o
+  -- `current_user` efetivo tambem precisa confirmar que nao ha elevacao nesta sessao.
+  IF (SELECT rolsuper FROM pg_roles WHERE rolname = current_user) THEN
+    RAISE EXCEPTION 'Current user must not be SUPERUSER';
+  END IF;
+END
+$$;
+
+-- =============================================================================================
+-- A00. Repetibilidade
+-- =============================================================================================
+-- Este arquivo usa UUIDs fixos para que as assercoes sejam legiveis. Sem isolamento, uma segunda
+-- execucao no mesmo banco colidiria na PK e falharia por motivo errado — foi exatamente o que
+-- aconteceu durante a investigacao das sabotagens B e D.
+--
+-- A limpeza NAO e feita aqui: `nexus_app` nao tem privilegio de DELETE na auditoria (por design),
+-- e conceder esse privilegio para "facilitar o teste" seria exatamente o enfraquecimento que a
+-- subfase proibe. O isolamento e responsabilidade do harness, que roda este arquivo em banco
+-- recem-criado (uma execucao por banco). Ver `scripts/test-postgres-integration.sh`.
+--
+-- O arquivo VERIFICA a propria pre-condicao em vez de assumi-la. Se rodar sobre um banco que ja
+-- executou esta verificacao, falha imediatamente com a causa real, em vez de produzir um erro
+-- enganoso de PK mais adiante (foi o que aconteceu durante a investigacao de B e D).
+-- A checagem PRECISA rodar com contexto RLS: sem ele, o RLS faz toda leitura devolver 0 linhas e
+-- a guarda seria estruturalmente incapaz de detectar um banco sujo (foi o que aconteceu na
+-- primeira tentativa). `nexus.tool_grants` e `nexus.tool_grant_audit` exigem `actor_type='owner'`
+-- no SELECT; `user_assistant_preferences` apenas contexto de owner.
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+DECLARE
+  grant_rows integer;
+  audit_rows integer;
+  preference_rows integer;
+BEGIN
+  SELECT count(*) INTO grant_rows FROM nexus.tool_grants;
+  SELECT count(*) INTO audit_rows FROM nexus.tool_grant_audit;
+  SELECT count(*) INTO preference_rows FROM nexus.user_assistant_preferences;
+
+  IF grant_rows <> 0 OR audit_rows <> 0 OR preference_rows <> 0 THEN
+    RAISE EXCEPTION
+      'Phase 5 verification requires a fresh database (found grants=%, audit=%, preferences=%). Recreate nexus_test or use a new database.',
+      grant_rows, audit_rows, preference_rows
+      USING ERRCODE = '55000';
+  END IF;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- A. Privilegios efetivos do papel de aplicacao
+-- =============================================================================================
+DO $$
+DECLARE
+  can_insert_audit boolean;
+  can_update_audit boolean;
+  can_delete_audit boolean;
+  can_select_audit boolean;
+  can_write_grants boolean;
+BEGIN
+  can_select_audit := has_table_privilege(current_user, 'nexus.tool_grant_audit', 'SELECT');
+  can_insert_audit := has_table_privilege(current_user, 'nexus.tool_grant_audit', 'INSERT');
+  can_update_audit := has_table_privilege(current_user, 'nexus.tool_grant_audit', 'UPDATE');
+  can_delete_audit := has_table_privilege(current_user, 'nexus.tool_grant_audit', 'DELETE');
+  can_write_grants := has_table_privilege(current_user, 'nexus.tool_grants', 'INSERT,UPDATE,DELETE');
+
+  IF NOT can_select_audit THEN
+    RAISE EXCEPTION 'Application role must be able to read the grant audit trail';
+  END IF;
+  IF can_insert_audit OR can_update_audit OR can_delete_audit THEN
+    RAISE EXCEPTION 'Application role must not write the grant audit trail (insert=%, update=%, delete=%)',
+      can_insert_audit, can_update_audit, can_delete_audit;
+  END IF;
+  IF NOT can_write_grants THEN
+    RAISE EXCEPTION 'Application role must be able to grant and revoke';
+  END IF;
+END
+$$;
+
+-- =============================================================================================
+-- B. Sem contexto RLS: nenhuma operacao pessoal obtem acesso
+-- =============================================================================================
+DO $$
+BEGIN
+  IF (SELECT count(*) FROM nexus.tool_grants) <> 0 THEN
+    RAISE EXCEPTION 'Missing owner context exposed tool grants';
+  END IF;
+  IF (SELECT count(*) FROM nexus.tool_grant_audit) <> 0 THEN
+    RAISE EXCEPTION 'Missing owner context exposed grant audit';
+  END IF;
+  IF (SELECT count(*) FROM nexus.user_assistant_preferences) <> 0 THEN
+    RAISE EXCEPTION 'Missing owner context exposed assistant preferences';
+  END IF;
+
+  BEGIN
+    INSERT INTO nexus.tool_grants (
+      id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at
+    ) VALUES (
+      'a0000000-0000-4000-8000-000000000001',
+      '00000000-0000-4000-8000-000000000004',
+      '00000000-0000-4000-8000-000000000001',
+      'personal.tasks', 'granted',
+      '00000000-0000-4000-8000-000000000004', now()
+    );
+    RAISE EXCEPTION 'Grant insert without owner context unexpectedly succeeded';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+
+  BEGIN
+    INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id)
+    VALUES ('00000000-0000-4000-8000-000000000004', '00000000-0000-4000-8000-000000000001');
+    RAISE EXCEPTION 'Preference insert without owner context unexpectedly succeeded';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+END
+$$;
+
+-- =============================================================================================
+-- C. Owner A: concessao, leitura, auditoria automatica e revogacao
+-- =============================================================================================
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+
+DO $$
+DECLARE
+  active_count integer;
+  audit_count integer;
+BEGIN
+  INSERT INTO nexus.tool_grants (
+    id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at
+  ) VALUES (
+    'a1000000-0000-4000-8000-000000000001', nexus.current_owner_id(),
+    '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted',
+    nexus.current_owner_id(), now()
+  );
+
+  -- 7. grant ativo persistido corretamente
+  SELECT count(*) INTO active_count
+  FROM nexus.tool_grants
+  WHERE owner_id = nexus.current_owner_id()
+    AND assistant_id = '00000000-0000-4000-8000-000000000001'
+    AND tool_id = 'personal.tasks'
+    AND status = 'granted'
+    AND revoked_at IS NULL;
+  IF active_count <> 1 THEN
+    RAISE EXCEPTION 'Active grant was not persisted (found %)', active_count;
+  END IF;
+
+  -- 11. auditoria gerada automaticamente
+  SELECT count(*) INTO audit_count FROM nexus.tool_grant_audit WHERE grant_id = 'a1000000-0000-4000-8000-000000000001';
+  IF audit_count <> 1 THEN
+    RAISE EXCEPTION 'Grant insert must produce exactly one audit row, found %', audit_count;
+  END IF;
+
+  UPDATE nexus.tool_grants
+  SET status = 'revoked', revoked_by_owner_id = nexus.current_owner_id(), revoked_at = now()
+  WHERE id = 'a1000000-0000-4000-8000-000000000001';
+
+  -- 8. revogacao mantem historico coerente: 1 linha, 2 eventos
+  SELECT count(*) INTO audit_count FROM nexus.tool_grant_audit WHERE grant_id = 'a1000000-0000-4000-8000-000000000001';
+  IF audit_count <> 2 THEN
+    RAISE EXCEPTION 'Grant + revoke must produce two audit rows, found %', audit_count;
+  END IF;
+  IF NOT EXISTS (
+    SELECT 1 FROM nexus.tool_grant_audit
+    WHERE grant_id = 'a1000000-0000-4000-8000-000000000001'
+      AND action = 'revoked'
+      AND actor_owner_id = nexus.current_owner_id()
+  ) THEN
+    RAISE EXCEPTION 'Revocation audit row is missing or has the wrong actor';
+  END IF;
+
+  -- Atualizacao sem mudanca de status nao gera evento espurio. Aqui a linha JA esta revogada, e
+  -- `revoked` e terminal (trigger `enforce_tool_grant_lifecycle`): o UPDATE tem de ser recusado,
+  -- nao silenciosamente aceito. Fazer o UPDATE "passar" para testar o silencio da auditoria
+  -- contradiria a imutabilidade da revogacao.
+  BEGIN
+    UPDATE nexus.tool_grants SET updated_at = now() WHERE id = 'a1000000-0000-4000-8000-000000000001';
+    RAISE EXCEPTION 'Update of a revoked tool grant was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN NULL;
+  END;
+  SELECT count(*) INTO audit_count FROM nexus.tool_grant_audit WHERE grant_id = 'a1000000-0000-4000-8000-000000000001';
+  IF audit_count <> 2 THEN
+    RAISE EXCEPTION 'A rejected update must not produce an audit row, found %', audit_count;
+  END IF;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- D. Rejeicoes de dominio (estados e duplicidade)
+-- =============================================================================================
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+BEGIN
+  -- 9a. linha nao pode nascer revogada
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at, revoked_by_owner_id, revoked_at)
+    VALUES ('a2000000-0000-4000-8000-000000000001', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000002',
+            'research.search', 'revoked', nexus.current_owner_id(), now(), nexus.current_owner_id(), now());
+    RAISE EXCEPTION 'Revoked row was accepted on insert';
+  EXCEPTION WHEN SQLSTATE '42501' THEN NULL;
+  END;
+
+  -- 9b. ativo com revoked_at preenchido e recusado. O trigger `enforce_tool_grant_lifecycle`
+  -- roda ANTES dos CHECK e agora tambem recusa (42501); quando o trigger nao intervier, o CHECK
+  -- `tool_grants_state_coherent` recusa (23514). As duas barreiras valem: o que nao pode existir
+  -- e a linha, nao um SQLSTATE especifico.
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at, revoked_at)
+    VALUES ('a2000000-0000-4000-8000-000000000002', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000002',
+            'research.search', 'granted', nexus.current_owner_id(), now(), now());
+    RAISE EXCEPTION 'Granted row with revoked_at was accepted';
+  EXCEPTION WHEN check_violation OR SQLSTATE '42501' THEN NULL;
+  END;
+
+  -- 9c. revogado sem quem revogou viola o CHECK
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at, revoked_at)
+    VALUES ('a2000000-0000-4000-8000-000000000003', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000002',
+            'research.search', 'revoked', nexus.current_owner_id(), now(), now());
+    RAISE EXCEPTION 'Revoked row without revoked_by_owner_id was accepted';
+  EXCEPTION WHEN check_violation OR SQLSTATE '42501' THEN NULL;
+  END;
+
+  -- 9d. grant em nome de outro owner viola o CHECK (nao depende do RLS)
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+    VALUES ('a2000000-0000-4000-8000-000000000004', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000002',
+            'research.search', 'granted', '99999999-0000-4000-8000-000000000001', now());
+    RAISE EXCEPTION 'Grant attributed to another owner was accepted';
+  EXCEPTION WHEN check_violation THEN NULL;
+  END;
+
+  -- 9e. revogacao anterior a concessao viola o CHECK
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at, revoked_by_owner_id, revoked_at)
+    VALUES ('a2000000-0000-4000-8000-000000000005', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000002',
+            'research.search', 'revoked', nexus.current_owner_id(), now(), nexus.current_owner_id(), now() - interval '1 hour');
+    RAISE EXCEPTION 'Revocation dated before grant was accepted';
+  EXCEPTION WHEN check_violation OR SQLSTATE '42501' THEN NULL;
+  END;
+
+  -- 9f. tool_id vazio
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+    VALUES ('a2000000-0000-4000-8000-000000000006', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000002',
+            '   ', 'granted', nexus.current_owner_id(), now());
+    RAISE EXCEPTION 'Blank tool_id was accepted';
+  EXCEPTION WHEN check_violation THEN NULL;
+  END;
+
+  -- 10. duplicidade de grant
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+    VALUES ('a2000000-0000-4000-8000-000000000007', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000001',
+            'personal.tasks', 'granted', nexus.current_owner_id(), now());
+    RAISE EXCEPTION 'Duplicate (owner, assistant, tool) grant was accepted';
+  EXCEPTION WHEN unique_violation THEN NULL;
+  END;
+
+  -- escopo imutavel: nao se reaproveita a linha revogada para outra ferramenta
+  BEGIN
+    UPDATE nexus.tool_grants SET tool_id = 'personal.organize'
+    WHERE id = 'a1000000-0000-4000-8000-000000000001';
+    RAISE EXCEPTION 'Tool grant scope mutation was accepted';
+  EXCEPTION WHEN SQLSTATE '42501' THEN NULL;
+  END;
+
+  -- FK: assistente inexistente
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+    VALUES ('a2000000-0000-4000-8000-000000000008', nexus.current_owner_id(), '99999999-0000-4000-8000-000000000009',
+            'personal.tasks', 'granted', nexus.current_owner_id(), now());
+    RAISE EXCEPTION 'Grant for an unknown assistant was accepted';
+  EXCEPTION WHEN foreign_key_violation THEN NULL;
+  END;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- E. Actor `assistant`: le grants? nao (variante estrita). Escreve? nao.
+--    Le preferencias? sim (variante de leitura ampla). Escreve? nao.
+-- =============================================================================================
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, sort_order, is_default)
+VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000002', 1, true);
+COMMIT;
+
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'assistant', true);
+SELECT set_config('nexus.assistant_id', '00000000-0000-4000-8000-000000000002', true);
+DO $$
+BEGIN
+  -- 5. actor assistant nao le grants
+  IF (SELECT count(*) FROM nexus.tool_grants) <> 0 THEN
+    RAISE EXCEPTION 'Assistant actor must not read tool grants';
+  END IF;
+  IF (SELECT count(*) FROM nexus.tool_grant_audit) <> 0 THEN
+    RAISE EXCEPTION 'Assistant actor must not read the grant audit trail';
+  END IF;
+
+  -- mas precisa ler a preferencia (o CORE le dentro de transacao com actor assistant)
+  IF (SELECT count(*) FROM nexus.user_assistant_preferences) <> 1 THEN
+    RAISE EXCEPTION 'Assistant actor must be able to read assistant preferences';
+  END IF;
+
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+    VALUES ('a3000000-0000-4000-8000-000000000001', nexus.current_owner_id(), nexus.current_assistant_id(),
+            'personal.tasks', 'granted', nexus.current_owner_id(), now());
+    RAISE EXCEPTION 'Assistant actor wrote a tool grant';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+
+  -- O USING da policy exige actor owner, entao nenhuma linha e visivel e o UPDATE afeta 0 sem
+  -- sequer chegar ao trigger. `42501` tambem e aceito: sob algumas versoes o planner avalia a
+  -- WITH CHECK antes. O que nao pode acontecer e a linha mudar de estado.
+  BEGIN
+    UPDATE nexus.tool_grants SET status = 'revoked', revoked_by_owner_id = nexus.current_owner_id(), revoked_at = now()
+    WHERE tool_id = 'personal.tasks';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+  IF EXISTS (SELECT 1 FROM nexus.tool_grants WHERE tool_id = 'personal.tasks' AND status = 'revoked') THEN
+    RAISE EXCEPTION 'Assistant actor revoked a tool grant';
+  END IF;
+
+  BEGIN
+    DELETE FROM nexus.tool_grants WHERE tool_id = 'personal.tasks';
+    IF FOUND THEN RAISE EXCEPTION 'Assistant actor deleted a tool grant'; END IF;
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+
+  -- Preferencia tambem nao e escrita por assistente. Sob RLS, um UPDATE cujo USING nao casa
+  -- nenhuma linha NAO levanta erro: ele afeta 0 linhas. O que se prova aqui e exatamente isso
+  -- (nenhuma linha alterada), e nao uma excecao.
+  UPDATE nexus.user_assistant_preferences SET sort_order = 99;
+  IF FOUND THEN
+    RAISE EXCEPTION 'Assistant actor wrote assistant preferences';
+  END IF;
+  IF (SELECT count(*) FROM nexus.user_assistant_preferences WHERE sort_order = 99) <> 0 THEN
+    RAISE EXCEPTION 'Assistant actor changed a preference value';
+  END IF;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- F. Isolamento entre owners (owner B sintetico)
+--     `owner_identity` e singleton, entao um segundo owner legivel e impossivel de semear.
+--     O que se prova aqui e a barreira que importa: um contexto cujo `nexus.owner_id` difere de
+--     `nexus.configured_owner_id()` nao ve nem escreve nada, por mais que o cliente controle o
+--     `set_config`. E o caso que continua correto quando a Fase 7 revisar o singleton.
+-- =============================================================================================
+BEGIN;
+SELECT set_config('nexus.owner_id', '99999999-0000-4000-8000-000000000001', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+BEGIN
+  -- 2. owner B nao le grants do owner A (nem os proprios, porque nao e o owner configurado)
+  IF (SELECT count(*) FROM nexus.tool_grants) <> 0 THEN
+    RAISE EXCEPTION 'Foreign owner context exposed tool grants';
+  END IF;
+  IF (SELECT count(*) FROM nexus.tool_grant_audit) <> 0 THEN
+    RAISE EXCEPTION 'Foreign owner context exposed the grant audit trail';
+  END IF;
+  IF (SELECT count(*) FROM nexus.user_assistant_preferences) <> 0 THEN
+    RAISE EXCEPTION 'Foreign owner context exposed assistant preferences';
+  END IF;
+
+  -- 3/4. nao modifica nem exclui (0 linhas afetadas, e o CHECK/RLS barra o insert)
+  UPDATE nexus.tool_grants SET status = 'revoked', revoked_by_owner_id = nexus.current_owner_id(), revoked_at = now()
+  WHERE tool_id = 'personal.tasks';
+  IF FOUND THEN RAISE EXCEPTION 'Foreign owner context modified a grant'; END IF;
+
+  DELETE FROM nexus.tool_grants WHERE tool_id = 'personal.tasks';
+  IF FOUND THEN RAISE EXCEPTION 'Foreign owner context deleted a grant'; END IF;
+
+  DELETE FROM nexus.user_assistant_preferences;
+  IF FOUND THEN RAISE EXCEPTION 'Foreign owner context deleted a preference'; END IF;
+
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+    VALUES ('a4000000-0000-4000-8000-000000000001', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000001',
+            'personal.tasks', 'granted', nexus.current_owner_id(), now());
+    RAISE EXCEPTION 'Foreign owner context created a grant';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- G. Auditoria append-only para a aplicacao (privilegio de tabela)
+-- =============================================================================================
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+BEGIN
+  -- 12. `nexus_app` nao altera nem exclui auditoria, nem consegue inserir manualmente
+  BEGIN
+    UPDATE nexus.tool_grant_audit SET tool_id = 'forged';
+    RAISE EXCEPTION 'Application role updated the grant audit trail';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+
+  BEGIN
+    DELETE FROM nexus.tool_grant_audit;
+    RAISE EXCEPTION 'Application role deleted from the grant audit trail';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+
+  BEGIN
+    INSERT INTO nexus.tool_grant_audit (owner_id, grant_id, assistant_id, tool_id, action, actor_owner_id)
+    VALUES (nexus.current_owner_id(), 'a1000000-0000-4000-8000-000000000001',
+            '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted', nexus.current_owner_id());
+    RAISE EXCEPTION 'Application role inserted into the grant audit trail';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- H. Preferencias: chave composta, padrao unico, limites de dominio
+-- =============================================================================================
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+DECLARE
+  pref_count integer;
+BEGIN
+  -- 14/15. a mesma assistente tem uma linha; a chave e (owner, assistente)
+  SELECT count(*) INTO pref_count
+  FROM nexus.user_assistant_preferences
+  WHERE owner_id = nexus.current_owner_id() AND assistant_id = '00000000-0000-4000-8000-000000000002';
+  IF pref_count <> 1 THEN
+    RAISE EXCEPTION 'Expected exactly one preference row for (owner, assistant), found %', pref_count;
+  END IF;
+
+  BEGIN
+    INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id)
+    VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000002');
+    RAISE EXCEPTION 'Duplicate (owner, assistant) preference was accepted';
+  EXCEPTION WHEN unique_violation THEN NULL;
+  END;
+
+  -- 15b. dois padroes para o mesmo owner
+  BEGIN
+    INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, is_default)
+    VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000003', true);
+    RAISE EXCEPTION 'A second default assistant was accepted for the same owner';
+  EXCEPTION WHEN unique_violation THEN NULL;
+  END;
+
+  -- ordem negativa
+  BEGIN
+    INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, sort_order)
+    VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000003', -1);
+    RAISE EXCEPTION 'Negative sort_order was accepted';
+  EXCEPTION WHEN check_violation THEN NULL;
+  END;
+
+  -- rotulo com material de credencial
+  BEGIN
+    INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, display_label)
+    VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000003', 'Bearer abcdefghijklmnopqrstuvwx');
+    RAISE EXCEPTION 'Credential-looking display_label was accepted';
+  EXCEPTION WHEN check_violation THEN NULL;
+  END;
+
+  -- verbosidade fora do vocabulario
+  BEGIN
+    INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, response_verbosity)
+    VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000003', 'verbose');
+    RAISE EXCEPTION 'Unknown response_verbosity was accepted';
+  EXCEPTION WHEN check_violation THEN NULL;
+  END;
+
+  -- rotulo normal e aceito
+  INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id, display_label, sort_order)
+  VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000003', 'Pesquisa', 2);
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- I. 13. Rollback da operacao reverte tambem a auditoria
+-- =============================================================================================
+-- O bloco roda dentro de uma transacao com contexto valido: sem ele, o INSERT seria barrado pelo
+-- RLS antes de chegar ao ponto que interessa (a atomicidade grant + audit).
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+DECLARE
+  audit_before integer;
+  audit_after integer;
+BEGIN
+  SELECT count(*) INTO audit_before FROM nexus.tool_grant_audit;
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+    VALUES ('a5000000-0000-4000-8000-000000000001', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000003',
+            'technical.code_analysis', 'granted', nexus.current_owner_id(), now());
+    RAISE EXCEPTION 'forced rollback';
+  EXCEPTION WHEN raise_exception THEN NULL;
+  END;
+  SELECT count(*) INTO audit_after FROM nexus.tool_grant_audit;
+  IF audit_after <> audit_before THEN
+    RAISE EXCEPTION 'Rolled-back grant left % audit row(s) behind', audit_after - audit_before;
+  END IF;
+  IF EXISTS (SELECT 1 FROM nexus.tool_grants WHERE id = 'a5000000-0000-4000-8000-000000000001') THEN
+    RAISE EXCEPTION 'Rolled-back grant is still present';
+  END IF;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- J. 16. Concorrencia serializada pelo UNIQUE (duas sessoes nao podem criar o mesmo par)
+--     O teste de corrida real com dois backends esta no bloco de sessao dupla abaixo; aqui se
+--     prova que uma segunda concessao do mesmo par, depois do commit da primeira, e rejeitada.
+-- =============================================================================================
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+BEGIN
+  INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+  VALUES ('a6000000-0000-4000-8000-000000000001', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000003',
+          'technical.code_analysis', 'granted', nexus.current_owner_id(), now());
+
+  BEGIN
+    INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+    VALUES ('a6000000-0000-4000-8000-000000000002', nexus.current_owner_id(), '00000000-0000-4000-8000-000000000003',
+            'technical.code_analysis', 'granted', nexus.current_owner_id(), now());
+    RAISE EXCEPTION 'Concurrent-style duplicate grant was accepted';
+  EXCEPTION WHEN unique_violation THEN NULL;
+  END;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- L. DELETE direto pelo owner (CONTRATO DE DOMINIO)
+-- =============================================================================================
+-- Este teste e POSITIVO de proposito. Todos os outros testes de DELETE deste arquivo sao
+-- negativos ("nao pode apagar"), e um DELETE barrado por RLS afeta 0 linhas SEM erro — o que
+-- torna esses testes cegos para a remocao da policy `tool_grants_owner_delete`. Sem um teste
+-- positivo, apagar a policy passaria despercebido.
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+DECLARE
+  audit_before integer;
+  audit_after integer;
+BEGIN
+  SELECT count(*) INTO audit_before
+  FROM nexus.tool_grant_audit WHERE grant_id = 'a1000000-0000-4000-8000-000000000001';
+
+  DELETE FROM nexus.tool_grants WHERE id = 'a1000000-0000-4000-8000-000000000001';
+  IF NOT FOUND THEN
+    RAISE EXCEPTION 'Owner could not delete their own tool grant';
+  END IF;
+
+  IF EXISTS (SELECT 1 FROM nexus.tool_grants WHERE id = 'a1000000-0000-4000-8000-000000000001') THEN
+    RAISE EXCEPTION 'Deleted grant is still present';
+  END IF;
+
+  -- A trilha sobrevive: `grant_id` e snapshot historico, sem FK para `tool_grants`.
+  SELECT count(*) INTO audit_after
+  FROM nexus.tool_grant_audit WHERE grant_id = 'a1000000-0000-4000-8000-000000000001';
+  IF audit_after <> audit_before THEN
+    RAISE EXCEPTION 'Deleting a grant erased its audit history (% -> %)', audit_before, audit_after;
+  END IF;
+END
+$$;
+COMMIT;
+
+-- =============================================================================================
+-- M. ON DELETE CASCADE (INDEPENDENTE de policy de DELETE)
+-- =============================================================================================
+-- Ponto central, e o que explica a sabotagem D:
+--   * acoes de integridade referencial do PostgreSQL rodam como o DONO da constraint e NAO passam
+--     pelo RLS como um DELETE da aplicacao;
+--   * logo, o `ON DELETE CASCADE` de `owner_identity` NAO depende de `tool_grants_owner_delete`;
+--   * consequentemente, remover essa policy e invisivel para qualquer teste de cascade — o que
+--     sobra para detecta-la e o teste POSITIVO de DELETE do bloco L.
+--
+-- Aqui se verifica o que esta ao alcance de `nexus_app`: as FKs estao declaradas com as acoes
+-- corretas, e a aplicacao NAO consegue apagar a trilha de auditoria por conta propria (o que
+-- tambem impede "limpar" a evidencia antes de uma cascata).
+DO $$
+DECLARE
+  delete_rule_grants text;
+  delete_rule_audit_owner text;
+  delete_rule_prefs text;
+BEGIN
+  SELECT confdeltype INTO delete_rule_grants
+  FROM pg_constraint WHERE conname = 'tool_grants_owner_id_fkey';
+  SELECT confdeltype INTO delete_rule_audit_owner
+  FROM pg_constraint WHERE conname = 'tool_grant_audit_owner_id_fkey';
+  SELECT confdeltype INTO delete_rule_prefs
+  FROM pg_constraint WHERE conname = 'user_assistant_preferences_owner_id_fkey';
+
+  -- 'c' = CASCADE.
+  -- Usa `IS DISTINCT FROM` e nao `<>`: se a constraint nao existir, a subconsulta devolve NULL e
+  -- a comparacao `NULL <> 'c'` avalia NULL — que nao dispara o RAISE. Seria uma falha silenciosa
+  -- exatamente no caso mais grave (FK ausente). `IS DISTINCT FROM` trata NULL como distinto.
+  IF delete_rule_grants IS DISTINCT FROM 'c' THEN
+    RAISE EXCEPTION 'tool_grants.owner_id must cascade on owner deletion, found %', coalesce(delete_rule_grants, 'missing constraint');
+  END IF;
+  IF delete_rule_audit_owner IS DISTINCT FROM 'c' THEN
+    RAISE EXCEPTION 'tool_grant_audit.owner_id must cascade on owner deletion, found %', coalesce(delete_rule_audit_owner, 'missing constraint');
+  END IF;
+  IF delete_rule_prefs IS DISTINCT FROM 'c' THEN
+    RAISE EXCEPTION 'user_assistant_preferences.owner_id must cascade, found %', coalesce(delete_rule_prefs, 'missing constraint');
+  END IF;
+
+  -- `grant_id` NAO tem FK: e snapshot, sobrevive ao DELETE do grant (provado no bloco L).
+  IF EXISTS (
+    SELECT 1 FROM pg_constraint
+    WHERE conrelid = 'nexus.tool_grant_audit'::regclass
+      AND contype = 'f'
+      AND pg_get_constraintdef(oid) LIKE '%grant_id%'
+  ) THEN
+    RAISE EXCEPTION 'tool_grant_audit.grant_id must not have a foreign key';
+  END IF;
+
+  -- A aplicacao nao pode apagar a trilha (nem para "preparar" uma cascata).
+  BEGIN
+    DELETE FROM nexus.tool_grant_audit WHERE owner_id = nexus.current_owner_id();
+    RAISE EXCEPTION 'Application role deleted grant audit rows';
+  EXCEPTION WHEN insufficient_privilege THEN NULL;
+  END;
+END
+$$;
+
+-- O efeito pratico da cascata sobre as tres tabelas, exercitado onde e observavel: `tool_grants`
+-- e `user_assistant_preferences` aceitam DELETE do owner, e a auditoria NAO e apagada por isso.
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+DECLARE
+  audit_before integer;
+  audit_after integer;
+BEGIN
+  INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+  VALUES ('a8000000-0000-4000-8000-000000000001', nexus.current_owner_id(),
+          '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted',
+          nexus.current_owner_id(), now());
+  INSERT INTO nexus.user_assistant_preferences (owner_id, assistant_id)
+  VALUES (nexus.current_owner_id(), '00000000-0000-4000-8000-000000000001');
+
+  SELECT count(*) INTO audit_before FROM nexus.tool_grant_audit;
+
+  DELETE FROM nexus.tool_grants WHERE owner_id = nexus.current_owner_id();
+  IF NOT FOUND THEN
+    RAISE EXCEPTION 'Owner could not remove their tool grants';
+  END IF;
+  DELETE FROM nexus.user_assistant_preferences WHERE owner_id = nexus.current_owner_id();
+  IF NOT FOUND THEN
+    RAISE EXCEPTION 'Owner could not remove their assistant preferences';
+  END IF;
+
+  SELECT count(*) INTO audit_after FROM nexus.tool_grant_audit;
+  IF audit_after < audit_before THEN
+    RAISE EXCEPTION 'Deleting grants removed audit history (% -> %)', audit_before, audit_after;
+  END IF;
+END
+$$;
+ROLLBACK;
+
+-- =============================================================================================
+-- K. Estados finais coerentes
+-- =============================================================================================
+BEGIN;
+SELECT set_config('nexus.owner_id', '00000000-0000-4000-8000-000000000004', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+DO $$
+DECLARE
+  grants integer;
+  audit_rows integer;
+  prefs integer;
+BEGIN
+  -- Concessoes: bloco C (1), bloco J (1), bloco M (1, revertido) e bloco L (1, apagado
+  -- explicitamente) => 1 linha no fim. Somente o bloco L foi DELETE direto do owner.
+  SELECT count(*) INTO grants FROM nexus.tool_grants;
+  IF grants <> 1 THEN RAISE EXCEPTION 'Expected 1 grant at the end, found %', grants; END IF;
+
+  -- Eventos persistidos: concessao do bloco C (1) + revogacao do bloco C (1) + concessao do
+  -- bloco J (1) = 3. O bloco L apagou o grant do bloco C, mas a trilha dele SOBREVIVEU (por isso
+  -- as duas primeiras linhas continuam contando). Os eventos do bloco M foram revertidos.
+  SELECT count(*) INTO audit_rows FROM nexus.tool_grant_audit;
+  IF audit_rows <> 3 THEN RAISE EXCEPTION 'Expected 3 audit rows at the end, found %', audit_rows; END IF;
+
+  SELECT count(*) INTO prefs FROM nexus.user_assistant_preferences;
+  IF prefs <> 2 THEN RAISE EXCEPTION 'Expected 2 preferences at the end, found %', prefs; END IF;
+
+  -- nenhuma linha ficou em estado impossivel
+  IF EXISTS (
+    SELECT 1 FROM nexus.tool_grants
+    WHERE (status = 'granted' AND (revoked_at IS NOT NULL OR revoked_by_owner_id IS NOT NULL))
+       OR (status = 'revoked' AND (revoked_at IS NULL OR revoked_by_owner_id IS NULL))
+  ) THEN
+    RAISE EXCEPTION 'Inconsistent grant state survived the checks';
+  END IF;
+END
+$$;
+COMMIT;
+
+DO $$ BEGIN RAISE NOTICE 'Phase 5 (G13) SQL verification passed'; END $$;
