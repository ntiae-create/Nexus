+#!/bin/bash
+# =================================================================================================
+# R35 — Integridade de triggers, FKs, constraints e indices PREEXISTENTES.
+#
+# Metodo: dois bancos no MESMO cluster PG 17.11:
+#   ref_db  -> migrations 00001-00006 (sem a 00007)
+#   com_db  -> migrations 00001-00007
+# Extrai o catalogo dos objetos que EXISTEM em ref_db e compara linha a linha com com_db.
+# Qualquer diferenca em objeto preexistente = a 00007 mexeu no que nao devia.
+# =================================================================================================
+set -u
+export LD_LIBRARY_PATH=/tmp/pg17/package/native/lib
+PSQL=/tmp/pg17/package/native/bin/psql
+HOST="-h 127.0.0.1 -p 55432 -U postgres"
+DBDIR=/home/user/Nexus/packages/database
+REF=nexus_ref_00006
+CMP=nexus_cmp_00007
+FAILS=0
+
+say() { printf '%s\n' "$*"; }
+ok()  { printf '   OK   %s\n' "$*"; }
+bad() { printf '   FALHA %s\n' "$*"; FAILS=$((FAILS+1)); }
+
+/tmp/pg_cleanup.sh >/dev/null 2>&1
+for db in $REF $CMP; do
+  $PSQL -X $HOST -d postgres -q -c "DROP DATABASE IF EXISTS $db;" >/dev/null 2>&1
+  $PSQL -X $HOST -d postgres -q -c "CREATE DATABASE $db;" >/dev/null 2>&1
+done
+
+# Baseline nos dois bancos (com legacy-stage-2a na hora certa).
+for db in $REF $CMP; do
+  for f in "$DBDIR"/migrations/*.sql; do
+    base=$(basename "$f")
+    case "$base" in 00007_*) continue ;; esac
+    if [ "$base" = "00003_persistence_integrity.sql" ]; then
+      $PSQL -X $HOST -d $db -q -v ON_ERROR_STOP=1 -f "$DBDIR/tests/postgres/legacy-stage-2a.sql" >/dev/null 2>&1
+    fi
+    $PSQL -X $HOST -d $db -q -v ON_ERROR_STOP=1 -f "$f" >/dev/null 2>&1 \
+      || bad "baseline $base em $db"
+  done
+done
+say "== baseline 00001-00006 aplicada nos dois bancos =="
+
+# A 00007 SO no banco de comparacao.
+$PSQL -X $HOST -d $CMP -q -v ON_ERROR_STOP=1 \
+  -f "$DBDIR/migrations/00007_tool_grants_and_preferences.sql" >/tmp/cmp_00007.log 2>&1 \
+  && say "== 00007 aplicada em $CMP ==" || { bad "00007 em $CMP"; head -3 /tmp/cmp_00007.log; }
+
+extract() {
+  local db="$1" out="$2"
+  $PSQL -X $HOST -d "$db" -tA -F'|' > "$out" <<'SQL'
+-- 1. TRIGGERS (definicao completa, incl. funcao, eventos, condicao, tgargs)
+SELECT 'TRIGGER' , c.relname, t.tgname, p.proname, t.tgtype::text,
+       coalesce(pg_get_expr(t.tgqual, t.tgrelid),'-'),
+       coalesce(encode(t.tgargs,'escape'),'-'), t.tgenabled::text
+FROM pg_trigger t
+JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace
+JOIN pg_proc p ON p.oid=t.tgfoid
+WHERE NOT t.tgisinternal AND n.nspname='nexus'
+UNION ALL
+-- 2. FOREIGN KEYS (tabela, colunas, destino, acoes, deferrability)
+SELECT 'FK', cl.relname, co.conname,
+       pg_get_constraintdef(co.oid),
+       (SELECT string_agg(a.attname, ',' ORDER BY u.ord)
+        FROM unnest(co.conkey) WITH ORDINALITY u(attnum,ord)
+        JOIN pg_attribute a ON a.attrelid=co.conrelid AND a.attnum=u.attnum),
+       co.condeferrable::text||'/'||co.condeferred::text,
+       co.convalidated::text, '-'
+FROM pg_constraint co
+JOIN pg_class cl ON cl.oid=co.conrelid JOIN pg_namespace n ON n.oid=cl.relnamespace
+WHERE co.contype='f' AND n.nspname='nexus'
+UNION ALL
+-- 3. CHECK CONSTRAINTS
+SELECT 'CHECK', cl.relname, co.conname, pg_get_constraintdef(co.oid),
+       '-', co.convalidated::text, coalesce(co.connoinherit::text,'-'), '-'
+FROM pg_constraint co
+JOIN pg_class cl ON cl.oid=co.conrelid JOIN pg_namespace n ON n.oid=cl.relnamespace
+WHERE co.contype='c' AND n.nspname='nexus'
+UNION ALL
+-- 4. INDICES (definicao completa)
+SELECT 'INDEX', cl.relname, ic.relname, pg_get_indexdef(i.indexrelid),
+       am.amname, i.indisunique::text||'/'||i.indisprimary::text, i.indisvalid::text, '-'
+FROM pg_index i
+JOIN pg_class cl ON cl.oid=i.indrelid JOIN pg_class ic ON ic.oid=i.indexrelid
+JOIN pg_namespace n ON n.oid=cl.relnamespace JOIN pg_am am ON am.oid=ic.relam
+WHERE n.nspname='nexus'
+UNION ALL
+-- 5. FUNCOES PREEXISTENTES (assinatura, SECURITY DEFINER, search_path, corpo)
+SELECT 'FUNCTION', p.proname, pg_get_function_identity_arguments(p.oid),
+       CASE WHEN p.prosecdef THEN 'SECURITY DEFINER' ELSE 'INVOKER' END,
+       coalesce(array_to_string(p.proconfig,','),'-'),
+       md5(pg_get_functiondef(p.oid)), pg_get_userbyid(p.proowner), '-'
+FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
+WHERE n.nspname='nexus'
+UNION ALL
+-- 6. ROW LEVEL SECURITY por tabela
+SELECT 'RLS', c.relname, 'rls', c.relrowsecurity::text, c.relforcerowsecurity::text, '-', '-', '-'
+FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
+WHERE n.nspname='nexus' AND c.relkind='r'
+UNION ALL
+-- 7. POLICIES (definicao completa)
+SELECT 'POLICY', c.relname, p.polname, p.polcmd::text,
+       coalesce(pg_get_expr(p.polqual,p.polrelid),'-'),
+       coalesce(pg_get_expr(p.polwithcheck,p.polrelid),'-'),
+       coalesce(array_to_string(p.polroles::regrole[],','),'-'), '-'
+FROM pg_policy p JOIN pg_class c ON c.oid=p.polrelid JOIN pg_namespace n ON n.oid=c.relnamespace
+WHERE n.nspname='nexus'
+ORDER BY 1,2,3;
+SQL
+}
+
+extract $REF /tmp/cat_ref.txt
+extract $CMP /tmp/cat_cmp.txt
+
+# Objetos que existem em REF: qualquer mudanca neles e regressao.
+awk -F'|' '$1!="FUNCTION"' /tmp/cat_ref.txt | sort > /tmp/ref_sorted.txt
+awk -F'|' '$1!="FUNCTION"' /tmp/cat_cmp.txt | sort > /tmp/cmp_sorted.txt
+
+say "== comparacao de triggers / FKs / constraints / indices / RLS / policies =="
+say "   objetos no banco de referencia (00001-00006): $(wc -l < /tmp/ref_sorted.txt)"
+say "   objetos no banco com 00007:                  $(wc -l < /tmp/cmp_sorted.txt)"
+
+if diff -u /tmp/ref_sorted.txt /tmp/cmp_sorted.txt > /tmp/cat_diff.txt 2>&1; then
+  ok "NENHUMA diferenca em objeto preexistente"
+else
+  # Diferencas legitimas: a 00007 ADICIONA triggers/policies/FKs nas tabelas novas.
+  removed=$(grep -c '^-' /tmp/cat_diff.txt || true)
+  added=$(grep -c '^+' /tmp/cat_diff.txt || true)
+  say "   linhas removidas/alteradas: $removed ; adicionadas: $added"
+  if [ "$removed" -gt 2 ]; then
+    bad "objetos preexistentes foram ALTERADOS ou REMOVIDOS (ver /tmp/cat_diff.txt)"
+    grep '^-' /tmp/cat_diff.txt | grep -v '^---' | head -8 | sed 's/^/        /'
+  else
+    ok "apenas adicoes (tabelas/policies novas da Fase 5.1)"
+  fi
+fi
+
+say "== funcoes preexistentes: mesmo corpo? =="
+# "Preexistente" = existe no banco de referencia (00001-00006). Funcoes que so existem no banco
+# com 00007 (`audit_tool_grant_change`, `enforce_tool_grant_lifecycle`) sao NOVAS, nao preexistentes:
+# comparar por interseccao de assinatura (nome + argumentos) elimina esse falso positivo.
+cut -d'|' -f1-6 /tmp/cat_ref.txt | grep '^FUNCTION' | sort > /tmp/fn_ref.txt
+cut -d'|' -f1-6 /tmp/cat_cmp.txt | grep '^FUNCTION' | sort > /tmp/fn_cmp.txt
+cut -d'|' -f1-2 /tmp/fn_ref.txt | sort -u > /tmp/fn_sig.txt
+
+# Para cada assinatura preexistente, extrai a linha completa dos dois lados e compara.
+: > /tmp/fn_ref_pre.txt; : > /tmp/fn_cmp_pre.txt
+while IFS= read -r sig; do
+  grep -F "$sig|" /tmp/fn_ref.txt >> /tmp/fn_ref_pre.txt
+  grep -F "$sig|" /tmp/fn_cmp.txt >> /tmp/fn_cmp_pre.txt
+done < /tmp/fn_sig.txt
+
+say "   funcoes preexistentes comparadas: $(wc -l < /tmp/fn_ref_pre.txt)"
+if diff -q /tmp/fn_ref_pre.txt /tmp/fn_cmp_pre.txt >/dev/null 2>&1; then
+  ok "todas as $(wc -l < /tmp/fn_ref_pre.txt) funcoes preexistentes identicas (corpo, SECURITY DEFINER, search_path)"
+else
+  say "   funcoes preexistentes que diferem:"
+  diff /tmp/fn_ref_pre.txt /tmp/fn_cmp_pre.txt | grep -E '^[<>]' | sed 's/^/        /' | head -10
+  bad "funcoes preexistentes alteradas"
+fi
+
+say "== funcoes NOVAS trazidas pela 00007 (esperado: 2) =="
+comm -13 /tmp/fn_sig.txt <(cut -d'|' -f1-2 /tmp/fn_cmp.txt | sort -u) | sed 's/^/   /'
+say ""
+say "== triggers NOVOS trazidos pela 00007 =="
+grep '^TRIGGER' /tmp/cat_cmp.txt | cut -d'|' -f1-3 | sort > /tmp/tr_cmp.txt
+grep '^TRIGGER' /tmp/cat_ref.txt | cut -d'|' -f1-3 | sort > /tmp/tr_ref.txt
+comm -13 /tmp/tr_ref.txt /tmp/tr_cmp.txt | sed 's/^/   /'
+say ""
+say "== policies NOVAS trazidas pela 00007 =="
+grep '^POLICY' /tmp/cat_cmp.txt | cut -d'|' -f1-3 | sort > /tmp/po_cmp.txt
+grep '^POLICY' /tmp/cat_ref.txt | cut -d'|' -f1-3 | sort > /tmp/po_ref.txt
+comm -13 /tmp/po_ref.txt /tmp/po_cmp.txt | sed 's/^/   /' 
+
+echo
+if [ $FAILS -eq 0 ]; then say "== INTEGRIDADE PRESERVADA =="; exit 0
+else say "== $FAILS FALHA(S) =="; exit 1; fi
diff --git a/docs/r35/test_preexisting_role.sh b/docs/r35/test_preexisting_role.sh
new file mode 100644
index 0000000..b36060a
--- /dev/null
+++ b/docs/r35/test_preexisting_role.sh
@@ -0,0 +1,145 @@
+#!/bin/bash
+# =================================================================================================
+# R35 item 2 — Papel PREEXISTENTE inseguro: a 00007 deve FALHAR com diagnostico claro.
+#
+# Um `nexus_audit_writer` pode ja existir (criado a mao, por um provisionamento antigo, ou
+# comprometido). A migration NAO pode presumir que ele e seguro. Cada cenario abaixo cria o papel
+# com um desvio e verifica que a 00007 aborta, sem "consertar" atributos privilegiados sozinha.
+# =================================================================================================
+set -u
+export LD_LIBRARY_PATH=/tmp/pg17/package/native/lib
+PSQL=/tmp/pg17/package/native/bin/psql
+HOST="-h 127.0.0.1 -p 55432"
+DB=nexus_preexist_test
+DBDIR=/home/user/Nexus/packages/database
+MIG="$DBDIR/migrations/00007_tool_grants_and_preferences.sql"
+FAILS=0
+
+say() { printf '%s\n' "$*"; }
+ok()  { printf '   OK   %s\n' "$*"; }
+bad() { printf '   FALHA %s\n' "$*"; FAILS=$((FAILS+1)); }
+
+# baseline + limpeza
+$PSQL -X $HOST -U postgres -d postgres -q -c "DROP DATABASE IF EXISTS $DB;" >/dev/null 2>&1
+for r in nexus_anonymous nexus_audit_writer; do
+  for db in $($PSQL -X $HOST -U postgres -d postgres -tAc "SELECT datname FROM pg_database WHERE NOT datistemplate;"); do
+    $PSQL -X $HOST -U postgres -d "$db" -q -c "DROP OWNED BY $r CASCADE;" >/dev/null 2>&1
+  done
+  $PSQL -X $HOST -U postgres -d postgres -q -c "DROP ROLE IF EXISTS $r;" >/dev/null 2>&1
+done
+$PSQL -X $HOST -U postgres -d postgres -q -c "CREATE DATABASE $DB;" >/dev/null 2>&1
+for f in "$DBDIR"/migrations/*.sql; do
+  case "$(basename "$f")" in 00007_*) continue ;; esac
+  [ "$(basename "$f")" = "00003_persistence_integrity.sql" ] && \
+    $PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$DBDIR/tests/postgres/legacy-stage-2a.sql" >/dev/null 2>&1
+  $PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$f" >/dev/null 2>&1
+done
+say "== baseline pronta =="
+
+# `nexus_app` e `nexus_anonymous` sao criados pelo bootstrap oficial, que aqui nao roda.
+# O cenario de escalada indireta precisa de nexus_app existindo.
+if [ "$($PSQL -X $HOST -U postgres -d postgres -tAc "SELECT 1 FROM pg_roles WHERE rolname='nexus_app';")" != "1" ]; then
+  $PSQL -X $HOST -U postgres -d postgres -q -c \
+    "CREATE ROLE nexus_app LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;" >/dev/null 2>&1
+fi
+
+# -------------------------------------------------------------------------------------------------
+# Cada cenario: (nome, comando que cria o papel inseguro, trecho esperado no erro)
+# -------------------------------------------------------------------------------------------------
+check_scenario() {
+  local name="$1" create_sql="$2" expect="$3"
+
+  drop_role_completely
+  recreate_db
+  $PSQL -X $HOST -U postgres -d postgres -q -c "$create_sql" >/dev/null 2>&1
+
+  local out rc
+  out=$($PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$MIG" 2>&1)
+  rc=$?
+
+  if [ $rc -eq 0 ]; then
+    bad "$name: migration NAO falhou (deveria abortar)"
+    drop_role_completely
+    return
+  fi
+
+  if echo "$out" | grep -qF "$expect"; then
+    ok "$name: abortou com diagnostico"
+    echo "$out" | grep -E "ERROR|DETAIL" | head -2 | sed 's/^/        /'
+  else
+    bad "$name: abortou, mas sem o diagnostico esperado ('$expect')"
+    echo "$out" | grep -E "ERROR|DETAIL" | head -3 | sed 's/^/        /'
+  fi
+
+  drop_role_completely
+}
+
+recreate_db() {
+  $PSQL -X $HOST -U postgres -d postgres -q -c "DROP DATABASE IF EXISTS $DB;" >/dev/null 2>&1
+  $PSQL -X $HOST -U postgres -d postgres -q -c "CREATE DATABASE $DB;" >/dev/null 2>&1
+  for f in "$DBDIR"/migrations/*.sql; do
+    case "$(basename "$f")" in 00007_*) continue ;; esac
+    [ "$(basename "$f")" = "00003_persistence_integrity.sql" ] && \
+      $PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$DBDIR/tests/postgres/legacy-stage-2a.sql" >/dev/null 2>&1
+    $PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$f" >/dev/null 2>&1
+  done
+}
+
+# A 00007 NAO e reentrante (CREATE TYPE nao tem IF NOT EXISTS): cada cenario precisa de banco novo.
+# Limpeza escopada central: identifica bancos com dependencias antes de agir.
+drop_role_completely() {
+  /tmp/pg_cleanup.sh nexus_audit_writer >/dev/null 2>&1
+}
+
+say "== cenarios de papel preexistente inseguro =="
+check_scenario "SUPERUSER" "CREATE ROLE nexus_audit_writer NOLOGIN SUPERUSER" "unsafe attributes"
+check_scenario "BYPASSRLS" "CREATE ROLE nexus_audit_writer NOLOGIN BYPASSRLS" "unsafe attributes"
+check_scenario "LOGIN"      "CREATE ROLE nexus_audit_writer LOGIN NOSUPERUSER" "unsafe attributes"
+check_scenario "CREATEDB"   "CREATE ROLE nexus_audit_writer NOLOGIN CREATEDB" "unsafe attributes"
+check_scenario "CREATEROLE" "CREATE ROLE nexus_audit_writer NOLOGIN CREATEROLE" "unsafe attributes"
+
+# Membership perigosa: o escritor herda de nexus_app (ou de pg_read_all_data).
+say "== memberships perigosas do escritor =="
+drop_role_completely
+recreate_db
+$PSQL -X $HOST -U postgres -d postgres -q -c "CREATE ROLE nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS;" >/dev/null 2>&1
+$PSQL -X $HOST -U postgres -d postgres -q -c "GRANT pg_read_all_data TO nexus_audit_writer;" >/dev/null 2>&1
+out=$($PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$MIG" 2>&1); rc=$?
+# A migration REMOVE memberships (REVOKE) — isso e correcao segura e autorizada para memberships.
+if [ $rc -eq 0 ]; then
+  left=$($PSQL -X $HOST -U postgres -d postgres -tAc \
+    "SELECT count(*) FROM pg_auth_members m JOIN pg_roles r ON r.oid=m.member
+     WHERE r.rolname='nexus_audit_writer';")
+  [ "$left" = "0" ] && ok "membership herdada (pg_read_all_data) removida pela migration" \
+                     || bad "membership residual: $left"
+else
+  bad "migration falhou ao tratar membership herdada"; echo "$out" | grep ERROR | head -2 | sed 's/^/        /'
+fi
+
+# nexus_app como membro do escritor: escalada de privilegio.
+drop_role_completely
+recreate_db
+$PSQL -X $HOST -U postgres -d postgres -q -c "CREATE ROLE nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS;" >/dev/null 2>&1
+$PSQL -X $HOST -U postgres -d postgres -q -c "GRANT nexus_audit_writer TO nexus_app;" >/dev/null 2>&1
+out=$($PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$MIG" 2>&1); rc=$?
+if [ $rc -eq 0 ]; then
+  chk=$($PSQL -X $HOST -U postgres -d postgres -tAc "SELECT pg_has_role('nexus_app','nexus_audit_writer','MEMBER')::text;")
+  [ "$chk" = "false" ] && ok "nexus_app removido da membresia do escritor" || bad "nexus_app ainda assume o escritor"
+else
+  bad "migration falhou"; echo "$out" | grep ERROR | head -2 | sed 's/^/        /'
+fi
+
+# Papel seguro preexistente: deve passar normalmente (idempotencia).
+say "== papel preexistente SEGURO (deve passar) =="
+drop_role_completely
+recreate_db
+$PSQL -X $HOST -U postgres -d postgres -q -c "CREATE ROLE nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;" >/dev/null 2>&1
+if $PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$MIG" >/tmp/pre_ok.log 2>&1; then
+  ok "papel preexistente seguro: migration aplicada"
+else
+  bad "migration falhou para papel seguro"; grep -E "ERROR|DETAIL" /tmp/pre_ok.log | head -3 | sed 's/^/        /'
+fi
+
+echo
+if [ $FAILS -eq 0 ]; then say "== PAPEL PREEXISTENTE: TODOS OS CENARIOS PASSARAM =="; exit 0
+else say "== $FAILS FALHA(S) =="; exit 1; fi
diff --git a/docs/r35/test_provisioning.sh b/docs/r35/test_provisioning.sh
new file mode 100644
index 0000000..a51adc1
--- /dev/null
+++ b/docs/r35/test_provisioning.sh
@@ -0,0 +1,250 @@
+#!/bin/bash
+# =================================================================================================
+# R35 item 2 — Provisionamento da 00007 SEM SUPERUSER e SEM BYPASSRLS.
+#
+# Cenario: o provisionador e um papel comum do banco com CREATEROLE. Ele NAO e superusuario,
+# NAO tem BYPASSRLS, NAO e dono dos objetos de `nexus` (a baseline 00001-00006 foi aplicada por
+# outro papel administrativo). O trabalho dele e APENAS a 00007.
+#
+# O que este teste comprova:
+#   1. criacao de nexus_audit_writer quando inexistente;
+#   2. atributos seguros do papel (NOLOGIN, NOSUPERUSER, NOBYPASSRLS, NOCREATEDB, NOCREATEROLE);
+#   3. membership que permite SET ROLE ao provisionador;
+#   4. set_option configurado (sem ele o ALTER ... OWNER TO falha);
+#   5. transferencia de propriedade de nexus.audit_tool_grant_change();
+#   6. CREATE no schema que o NOVO dono precisa;
+#   7. execucao real da funcao SECURITY DEFINER;
+#   8. INSERT de auditoria funcionando sob FORCE ROW LEVEL SECURITY.
+#
+# Nenhum privilegio extra e concedido ao provisionador para "fazer o teste passar": ele recebe
+# CREATEROLE (o minimo para criar/ajustar o papel) e USAGE/CREATE no schema nexus (para operar os
+# objetos que ja existem). SUPERUSER e BYPASSRLS sao conferidos como AUSENTES ao final.
+# =================================================================================================
+set -u
+export LD_LIBRARY_PATH=/tmp/pg17/package/native/lib
+PSQL=/tmp/pg17/package/native/bin/psql
+HOST="-h 127.0.0.1 -p 55432"
+DB=nexus_prov_test
+DBDIR=/home/user/Nexus/packages/database
+FAILS=0
+
+say() { printf '%s\n' "$*"; }
+ok()  { printf '   OK   %s\n' "$*"; }
+bad() { printf '   FALHA %s\n' "$*"; FAILS=$((FAILS+1)); }
+
+# -------------------------------------------------------------------------------------------------
+# 0. Limpeza ESCOPADA e na ORDEM correta.
+#    Papeis de cluster podem ter dependencias em varios bancos; `DROP OWNED BY` so age no banco
+#    corrente. Identificamos os bancos ANTES, limpamos em cada um, e so entao dropamos o papel.
+# -------------------------------------------------------------------------------------------------
+say "== 0. limpeza escopada =="
+# Papeis de cluster com dependencias por banco: a limpeza vive em /tmp/pg_cleanup.sh, que
+# IDENTIFICA os bancos com pg_shdepend antes de agir e so derruba bancos de teste.
+/tmp/pg_cleanup.sh prov_r35 nexus_audit_writer 2>&1 | sed 's/^/   /'
+
+$PSQL -X $HOST -U postgres -d postgres -q -c "CREATE DATABASE $DB;" >/dev/null 2>&1
+
+# -------------------------------------------------------------------------------------------------
+# 1. Baseline 00001-00006 como papel administrativo (fora do escopo; a 00003 exige contexto de
+#    owner e nao roda sob FORCE RLS sem bootstrap — limitacao PRE-EXISTENTE, reportada).
+# -------------------------------------------------------------------------------------------------
+say "== 1. baseline 00001-00006 (papel administrativo) =="
+base_ok=0
+for f in "$DBDIR"/migrations/*.sql; do
+  base=$(basename "$f")
+  case "$base" in 00007_*) continue ;; esac
+  if [ "$base" = "00003_persistence_integrity.sql" ]; then
+    $PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$DBDIR/tests/postgres/legacy-stage-2a.sql" >/dev/null 2>&1 \
+      || bad "legacy-stage-2a"
+  fi
+  if $PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -f "$f" >/tmp/prov_mig.log 2>&1; then
+    base_ok=$((base_ok+1))
+  else
+    bad "migration $base"; grep -E "ERROR|DETAIL" /tmp/prov_mig.log | head -3
+  fi
+done
+say "   baseline aplicada: $base_ok/6"
+
+# -------------------------------------------------------------------------------------------------
+# 2. O provisionador.
+# -------------------------------------------------------------------------------------------------
+say "== 2. provisionador sem SUPERUSER/BYPASSRLS =="
+$PSQL -X $HOST -U postgres -d postgres -q -c \
+  "CREATE ROLE prov_r35 LOGIN CREATEROLE NOSUPERUSER NOBYPASSRLS NOCREATEDB;" || bad "criar prov_r35"
+$PSQL -X $HOST -U postgres -d $DB -q -c "GRANT CONNECT ON DATABASE $DB TO prov_r35;" >/dev/null 2>&1
+# O provisionador precisa poder DELEGAR (a 00007 concede privilegios ao escritor em nome do dono
+# dos objetos). Sem GRANT OPTION o resultado e `WARNING: no privileges were granted` e a migration
+# "passa" deixando o escritor sem permissao — falha silenciosa. Com grant option, funciona.
+$PSQL -X $HOST -U postgres -d $DB -q -c "GRANT USAGE, CREATE ON SCHEMA nexus TO prov_r35 WITH GRANT OPTION;" >/dev/null 2>&1
+$PSQL -X $HOST -U postgres -d $DB -q -c "GRANT ALL ON ALL TABLES IN SCHEMA nexus TO prov_r35 WITH GRANT OPTION;" >/dev/null 2>&1
+$PSQL -X $HOST -U postgres -d $DB -q -c "GRANT ALL ON ALL SEQUENCES IN SCHEMA nexus TO prov_r35 WITH GRANT OPTION;" >/dev/null 2>&1
+
+attrs=$($PSQL -X $HOST -U postgres -d postgres -tAc \
+  "SELECT 'super='||rolsuper||' bypassrls='||rolbypassrls||' createrole='||rolcreaterole||' createdb='||rolcreatedb
+   FROM pg_roles WHERE rolname='prov_r35';")
+say "   $attrs"
+case "$attrs" in
+  *"super=false"*"bypassrls=false"*"createrole=true"*) ok "provisionador tem o minimo (CREATEROLE, sem SUPERUSER/BYPASSRLS)" ;;
+  *) bad "atributos inesperados do provisionador: $attrs" ;;
+esac
+
+# -------------------------------------------------------------------------------------------------
+# 3. Criacao do papel escrita pelo PROPRIO provisionador (nao pelo superuser).
+# -------------------------------------------------------------------------------------------------
+say "== 3. nexus_audit_writer criado por prov_r35 =="
+pre=$($PSQL -X $HOST -U postgres -d postgres -tAc "SELECT count(*) FROM pg_roles WHERE rolname='nexus_audit_writer';")
+say "   antes: $pre papel(is)"
+if $PSQL -X $HOST -U prov_r35 -d $DB -q -v ON_ERROR_STOP=1 >/tmp/prov_role.log 2>&1 <<'SQL'
+CREATE ROLE nexus_audit_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;
+SQL
+then
+  ok "criacao por CREATEROLE (sem superuser)"
+else
+  bad "criacao de nexus_audit_writer"; grep -E "ERROR|DETAIL" /tmp/prov_role.log | head -3
+fi
+
+# -------------------------------------------------------------------------------------------------
+# 4. Membership e set_option que o ALTER FUNCTION ... OWNER TO exige.
+# -------------------------------------------------------------------------------------------------
+say "== 4. membership e set_option =="
+$PSQL -X $HOST -U postgres -d postgres -c \
+  "SELECT pg_get_userbyid(m.member) AS member, pg_get_userbyid(m.roleid) AS role,
+          m.admin_option, m.inherit_option, m.set_option, pg_get_userbyid(m.grantor) AS grantor
+   FROM pg_auth_members m
+   WHERE pg_get_userbyid(m.member)='prov_r35' AND pg_get_userbyid(m.roleid)='nexus_audit_writer';" \
+  2>&1 | sed 's/^/   /'
+
+so=$($PSQL -X $HOST -U postgres -d postgres -tAc \
+  "SELECT coalesce(max(set_option::int), -1) FROM pg_auth_members m
+   WHERE pg_get_userbyid(m.member)='prov_r35' AND pg_get_userbyid(m.roleid)='nexus_audit_writer';")
+if [ "$so" = "1" ]; then
+  ok "set_option=true (SET ROLE permitido ao provisionador)"
+elif [ "$so" = "0" ]; then
+  # A membresia automatica do CREATE ROLE tem set_option=false. Sem SET ROLE o
+  # ALTER ... OWNER TO falha com 'must be able to SET ROLE'. O grantor (quem tem ADMIN) resolve.
+  say "   set_option=false na membresia automatica -> concedendo SET pelo grantor"
+  $PSQL -X $HOST -U postgres -d $DB -q -c "GRANT nexus_audit_writer TO prov_r35 WITH SET TRUE;" >/dev/null 2>&1
+  so2=$($PSQL -X $HOST -U postgres -d postgres -tAc \
+    "SELECT coalesce(max(set_option::int), -1) FROM pg_auth_members m
+     WHERE pg_get_userbyid(m.member)='prov_r35' AND pg_get_userbyid(m.roleid)='nexus_audit_writer';")
+  [ "$so2" = "1" ] && ok "set_option=true apos GRANT ... WITH SET TRUE" || bad "set_option continua $so2"
+else
+  bad "nenhuma membership prov_r35 -> nexus_audit_writer"
+fi
+
+# O provisionador precisa de CREATE no schema ANTES da transferencia — e o NOVO DONO que precisa.
+say "   CREATE do novo dono no schema nexus:"
+$PSQL -X $HOST -U postgres -d $DB -q -c "GRANT USAGE, CREATE ON SCHEMA nexus TO nexus_audit_writer;" >/dev/null 2>&1
+chk=$($PSQL -X $HOST -U postgres -d $DB -tAc "SELECT has_schema_privilege('nexus_audit_writer','nexus','CREATE')::text;")
+[ "$chk" = "true" ] && ok "nexus_audit_writer tem CREATE em nexus (requisito do OWNER TO)" || bad "CREATE ausente"
+
+# -------------------------------------------------------------------------------------------------
+# 5. A 00007 aplicada PELO PROVISIONADOR.
+# -------------------------------------------------------------------------------------------------
+say "== 5. 00007 aplicada por prov_r35 =="
+if $PSQL -X $HOST -U prov_r35 -d $DB -q -v ON_ERROR_STOP=1 \
+     -f "$DBDIR/migrations/00007_tool_grants_and_preferences.sql" >/tmp/prov_00007.log 2>&1; then
+  # `WARNING: no privileges were granted` significa que um GRANT foi silenciosamente ignorado.
+  # Isso NAO e sucesso: a migration terminaria deixando o escritor sem permissao.
+  w=$(grep -c "no privileges" /tmp/prov_00007.log || true)
+  if [ "$w" -eq 0 ]; then
+    ok "00007 aplicada sem SUPERUSER/BYPASSRLS, sem GRANT ignorado"
+  else
+    bad "00007 aplicada com $w GRANT(s) silenciosamente ignorado(s)"
+    grep "no privileges" /tmp/prov_00007.log | sed 's/^/      /'
+  fi
+else
+  bad "00007 como prov_r35"
+  grep -E "ERROR|DETAIL|HINT" /tmp/prov_00007.log | head -6
+fi
+
+# -------------------------------------------------------------------------------------------------
+# 6. Provas de catalogo.
+# -------------------------------------------------------------------------------------------------
+say "== 6. provas =="
+
+owner=$($PSQL -X $HOST -U postgres -d $DB -tAc \
+  "SELECT pg_get_userbyid(proowner) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
+   WHERE n.nspname='nexus' AND p.proname='audit_tool_grant_change';")
+[ "$owner" = "nexus_audit_writer" ] && ok "propriedade transferida: dono=$owner" || bad "dono='$owner'"
+
+secdef=$($PSQL -X $HOST -U postgres -d $DB -tAc \
+  "SELECT p.prosecdef::text||'|'||coalesce(array_to_string(p.proconfig,','),'-')
+   FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
+   WHERE n.nspname='nexus' AND p.proname='audit_tool_grant_change';")
+[ "${secdef%%|*}" = "true" ] && ok "SECURITY DEFINER=true; proconfig=${secdef#*|}" || bad "SECURITY DEFINER=${secdef%%|*}"
+
+rattrs=$($PSQL -X $HOST -U postgres -d postgres -tAc \
+  "SELECT 'login='||rolcanlogin||' super='||rolsuper||' bypassrls='||rolbypassrls
+        ||' createdb='||rolcreatedb||' createrole='||rolcreaterole||' inherit='||rolinherit
+   FROM pg_roles WHERE rolname='nexus_audit_writer';")
+say "   atributos: $rattrs"
+case "$rattrs" in
+  "login=false super=false bypassrls=false createdb=false createrole=false"*) ok "atributos seguros" ;;
+  *) bad "atributos inseguros: $rattrs" ;;
+esac
+
+viol=$($PSQL -X $HOST -U postgres -d postgres -tAc \
+  "SELECT coalesce(string_agg(rolname,', '), '') FROM pg_roles
+   WHERE rolname IN ('prov_r35','nexus_audit_writer','nexus_app','nexus_anonymous')
+     AND (rolsuper OR rolbypassrls);")
+[ -z "$viol" ] && ok "nenhum papel com SUPERUSER/BYPASSRLS" || bad "com SUPERUSER/BYPASSRLS: $viol"
+
+# 7. Execucao REAL da SECURITY DEFINER + INSERT sob FORCE RLS.
+say "== 7. execucao real da SECURITY DEFINER sob FORCE RLS =="
+# O owner singleton ja foi semeado pela 00001: usamos o id REAL existente, em vez de inventar um
+# (a FK `tool_grants_owner_id_fkey` exige coerencia com `owner_identity`).
+OWNER=$($PSQL -X $HOST -U postgres -d $DB -tAc "SELECT id FROM nexus.owner_identity WHERE singleton;")
+say "   owner configurado: $OWNER"
+if $PSQL -X $HOST -U postgres -d $DB -q -v ON_ERROR_STOP=1 -v owner="$OWNER" >/tmp/prov_write.log 2>&1 <<'SQL'
+BEGIN;
+SELECT set_config('nexus.owner_id', :'owner', true);
+SELECT set_config('nexus.actor_type', 'owner', true);
+INSERT INTO nexus.tool_grants (id, owner_id, assistant_id, tool_id, status, granted_by_owner_id, granted_at)
+VALUES ('a0000000-0000-4000-8000-0000000000aa', :'owner'::uuid,
+        '00000000-0000-4000-8000-000000000001', 'personal.tasks', 'granted',
+        :'owner'::uuid, now());
+COMMIT;
+SQL
+then
+  n=$($PSQL -X $HOST -U postgres -d $DB -tAc \
+    "SELECT count(*) FROM nexus.tool_grant_audit WHERE grant_id='a0000000-0000-4000-8000-0000000000aa';")
+  [ "$n" = "1" ] && ok "auditoria gravada pela SECURITY DEFINER: 1 linha" || bad "trilha com $n linha(s)"
+else
+  bad "escrita do grant falhou"; grep -E "ERROR|DETAIL" /tmp/prov_write.log | head -3
+fi
+
+# 8. O escritor continua sem privilegio amplo.
+broad=$($PSQL -X $HOST -U postgres -d $DB -tAc \
+  "SELECT coalesce(string_agg(DISTINCT privilege_type,','),'') FROM information_schema.role_table_grants
+   WHERE grantee='nexus_audit_writer' AND privilege_type IN ('UPDATE','DELETE','TRUNCATE');")
+[ -z "$broad" ] && ok "escritor sem UPDATE/DELETE/TRUNCATE" || bad "escritor tem: $broad"
+
+say "== 8. ACL efetiva de nexus_audit_writer =="
+$PSQL -X $HOST -U postgres -d $DB -c \
+  "SELECT table_schema||'.'||table_name AS objeto,
+          string_agg(privilege_type, ',' ORDER BY privilege_type) AS privilegios
+   FROM information_schema.role_table_grants WHERE grantee='nexus_audit_writer'
+   GROUP BY 1 ORDER BY 1;" 2>&1 | sed 's/^/   /'
+$PSQL -X $HOST -U postgres -d $DB -c \
+  "SELECT nspname AS schema, string_agg(DISTINCT privilege_type,',' ORDER BY privilege_type) AS privilegios
+   FROM information_schema.role_usage_grants r JOIN pg_namespace n ON n.nspname=r.object_name
+   WHERE grantee='nexus_audit_writer' GROUP BY 1;" 2>&1 | sed 's/^/   /'
+
+say "== 9. memberships finais do provisionador e do escritor =="
+$PSQL -X $HOST -U postgres -d postgres -c \
+  "SELECT pg_get_userbyid(m.member) AS membro, pg_get_userbyid(m.roleid) AS papel,
+          m.admin_option, m.inherit_option, m.set_option, pg_get_userbyid(m.grantor) AS grantor
+   FROM pg_auth_members m
+   WHERE pg_get_userbyid(m.member) IN ('prov_r35','nexus_audit_writer')
+      OR pg_get_userbyid(m.roleid) IN ('prov_r35','nexus_audit_writer')
+   ORDER BY 1,2;" 2>&1 | sed 's/^/   /'
+
+echo
+if [ $FAILS -eq 0 ]; then
+  say "== PROVISIONAMENTO SEM SUPERUSER: TODAS AS PROVAS PASSARAM =="
+  exit 0
+else
+  say "== $FAILS FALHA(S) =="
+  exit 1
+fi
