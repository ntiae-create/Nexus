++
++### 9.1 Extensão de `NexusRepositories` (`contracts.ts`, **PROPOSTA**)
++
++```ts
++export interface ResolveToolAuthorization {
++  readonly assistantId: AssistantReference["assistantId"];
++  readonly toolId: string;
++}
